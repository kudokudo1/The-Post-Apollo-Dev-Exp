#!/usr/bin/env python3
import argparse
import json
import os
import sqlite3
import sys
import uuid
from pathlib import Path

SCHEMA_VERSION = 2
MUTATIONS = {"local", "remote", "external"}
RECOVERY_CLASSES = {
    "NONE",
    "EVIDENCE_ONLY",
    "REF_RECOVERABLE",
    "CONTENT_RECOVERABLE",
}
FINISH_STATUSES = {"COMPLETE", "FAILED"}
VERIFICATION_STATUSES = {
    "NOT_RUN",
    "PASSED",
    "FAILED",
    "UNAVAILABLE",
}

SCHEMA = """
CREATE TABLE IF NOT EXISTS schema_meta (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS operations (
    operation_id TEXT PRIMARY KEY,
    action_id TEXT NOT NULL,
    title TEXT NOT NULL DEFAULT '',
    mutation TEXT NOT NULL,
    recovery TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'RUNNING',
    command_json TEXT NOT NULL,
    arguments_json TEXT NOT NULL DEFAULT '{}',
    before_json TEXT NOT NULL DEFAULT '{}',
    after_json TEXT NOT NULL DEFAULT '{}',
    exit_code INTEGER,
    verification_status TEXT NOT NULL DEFAULT 'NOT_RUN',
    verification_json TEXT NOT NULL DEFAULT '{}',
    result_summary TEXT NOT NULL DEFAULT '',
    started_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    completed_at TEXT,
    owner_pid INTEGER,
    owner_boot_id TEXT NOT NULL DEFAULT '',
    owner_start_ticks TEXT NOT NULL DEFAULT '',
    interrupted_at TEXT,
    CHECK(mutation IN ('local', 'remote', 'external')),
    CHECK(recovery IN ('NONE', 'EVIDENCE_ONLY', 'REF_RECOVERABLE', 'CONTENT_RECOVERABLE')),
    CHECK(status IN ('RUNNING', 'COMPLETE', 'FAILED')),
    CHECK(verification_status IN ('NOT_RUN', 'PASSED', 'FAILED', 'UNAVAILABLE'))
);

CREATE INDEX IF NOT EXISTS idx_operations_started
    ON operations(started_at DESC, operation_id DESC);

CREATE INDEX IF NOT EXISTS idx_operations_status
    ON operations(status, started_at DESC);
"""


def operation_db_path() -> Path:
    override = os.environ.get("PX_OPERATION_DB", "").strip()
    if override:
        return Path(override).expanduser()

    xdg = os.environ.get("XDG_DATA_HOME", "").strip()
    base = Path(xdg).expanduser() if xdg else Path.home() / ".local" / "share"
    return base / "post-apollo" / "operations" / "operations.db"


def connect() -> sqlite3.Connection:
    path = operation_db_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(path)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode = WAL")
    conn.execute("PRAGMA synchronous = NORMAL")
    conn.executescript(SCHEMA)

    columns = {
        str(row["name"])
        for row in conn.execute("PRAGMA table_info(operations)").fetchall()
    }
    migrations = (
        ("owner_pid", "ALTER TABLE operations ADD COLUMN owner_pid INTEGER"),
        (
            "owner_boot_id",
            "ALTER TABLE operations ADD COLUMN owner_boot_id TEXT NOT NULL DEFAULT ''",
        ),
        (
            "owner_start_ticks",
            "ALTER TABLE operations ADD COLUMN owner_start_ticks TEXT NOT NULL DEFAULT ''",
        ),
        (
            "interrupted_at",
            "ALTER TABLE operations ADD COLUMN interrupted_at TEXT",
        ),
    )
    for column, statement in migrations:
        if column not in columns:
            conn.execute(statement)

    conn.execute(
        "INSERT INTO schema_meta(key, value) VALUES('schema_version', ?) "
        "ON CONFLICT(key) DO UPDATE SET value = excluded.value",
        (str(SCHEMA_VERSION),),
    )
    conn.commit()
    return conn


def current_boot_id() -> str:
    path = Path("/proc/sys/kernel/random/boot_id")
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def process_start_ticks(pid: int) -> str:
    if pid <= 0:
        return ""

    path = Path(f"/proc/{pid}/stat")
    try:
        text = path.read_text(encoding="utf-8").strip()
    except OSError:
        return ""

    close_paren = text.rfind(")")
    if close_paren < 0:
        return ""

    fields = text[close_paren + 2 :].split()
    if len(fields) <= 19:
        return ""

    return fields[19]


def owner_identity(pid: int) -> tuple[str, str]:
    boot_id = current_boot_id()
    start_ticks = process_start_ticks(pid)
    if not boot_id or not start_ticks:
        raise RuntimeError(
            f"could not capture operation owner identity for pid {pid}"
        )
    return boot_id, start_ticks


def owner_state(row: sqlite3.Row) -> tuple[str, str]:
    owner_pid = int(row["owner_pid"] or 0)
    owner_boot_id = str(row["owner_boot_id"] or "")
    owner_start_ticks = str(row["owner_start_ticks"] or "")

    if owner_pid <= 0 or not owner_boot_id or not owner_start_ticks:
        return (
            "UNKNOWN",
            "operation predates owner tracking or was started without an owner pid",
        )

    boot_id = current_boot_id()
    if not boot_id:
        return ("UNKNOWN", "current Linux boot identity is unavailable")
    if boot_id != owner_boot_id:
        return ("STALE", "operation owner belongs to an earlier Linux boot")

    current_start_ticks = process_start_ticks(owner_pid)
    if not current_start_ticks:
        return ("STALE", "operation owner process no longer exists")
    if current_start_ticks != owner_start_ticks:
        return ("STALE", "operation owner pid was reused by a different process")

    return ("LIVE", "operation owner process identity is still live")


def parse_json_text(value: str, label: str, expected=None):
    text = str(value or "").strip()
    if not text:
        parsed = {} if expected is dict else [] if expected is list else {}
    else:
        try:
            parsed = json.loads(text)
        except json.JSONDecodeError as exc:
            raise RuntimeError(f"{label} is invalid JSON: {exc}") from exc

    if expected is not None and not isinstance(parsed, expected):
        raise RuntimeError(f"{label} must be a JSON {expected.__name__}")
    return parsed


def normalize_record(row: sqlite3.Row) -> dict:
    def decoded(column: str):
        try:
            return json.loads(str(row[column] or "{}"))
        except json.JSONDecodeError:
            return {}

    owner_status, owner_reason = owner_state(row)
    interrupted_at = str(row["interrupted_at"] or "")
    stored_status = str(row["status"])
    effective_status = "INTERRUPTED" if interrupted_at else stored_status

    return {
        "id": str(row["operation_id"]),
        "actionId": str(row["action_id"]),
        "title": str(row["title"] or ""),
        "mutation": str(row["mutation"]),
        "recovery": str(row["recovery"]),
        "status": effective_status,
        "journalStatus": stored_status,
        "command": decoded("command_json"),
        "arguments": decoded("arguments_json"),
        "before": decoded("before_json"),
        "after": decoded("after_json"),
        "exitCode": row["exit_code"],
        "verificationStatus": str(row["verification_status"] or "NOT_RUN"),
        "verification": decoded("verification_json"),
        "resultSummary": str(row["result_summary"] or ""),
        "startedAt": str(row["started_at"] or ""),
        "completedAt": str(row["completed_at"] or ""),
        "interruptedAt": interrupted_at,
        "interrupted": bool(interrupted_at),
        "executionOutcome": "UNKNOWN" if interrupted_at else "",
        "owner": {
            "pid": int(row["owner_pid"] or 0) or None,
            "bootId": str(row["owner_boot_id"] or ""),
            "startTicks": str(row["owner_start_ticks"] or ""),
            "state": owner_status,
            "reason": owner_reason,
        },
        "ownerState": owner_status,
    }


def get_record(conn: sqlite3.Connection, operation_id: str) -> dict:
    row = conn.execute(
        "SELECT * FROM operations WHERE operation_id = ?",
        (operation_id,),
    ).fetchone()
    if row is None:
        raise RuntimeError(f"unknown PX operation: {operation_id}")
    return normalize_record(row)


def start_operation(conn: sqlite3.Connection, args) -> dict:
    mutation = str(args.mutation or "").strip().lower()
    recovery = str(args.recovery or "").strip().upper()
    owner_pid = int(args.owner_pid or 0)
    owner_boot_id = ""
    owner_start_ticks = ""

    if owner_pid < 0:
        raise RuntimeError("operation owner pid must be positive")
    if owner_pid:
        owner_boot_id, owner_start_ticks = owner_identity(owner_pid)

    if mutation not in MUTATIONS:
        raise RuntimeError(f"invalid mutation class: {mutation}")
    if recovery not in RECOVERY_CLASSES:
        raise RuntimeError(f"invalid recovery class: {recovery}")

    command = parse_json_text(args.command_json, "command", list)
    arguments = parse_json_text(args.arguments_json, "arguments", dict)
    before = parse_json_text(args.before_json, "before evidence")

    if not command or not all(isinstance(value, str) for value in command):
        raise RuntimeError("command must be a non-empty JSON string array")

    operation_id = "op-" + uuid.uuid4().hex
    conn.execute(
        """
        INSERT INTO operations(
            operation_id, action_id, title, mutation, recovery,
            command_json, arguments_json, before_json,
            owner_pid, owner_boot_id, owner_start_ticks
        )
        VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """,
        (
            operation_id,
            str(args.action_id or "").strip(),
            str(args.title or "").strip(),
            mutation,
            recovery,
            json.dumps(command, separators=(",", ":")),
            json.dumps(arguments, separators=(",", ":"), sort_keys=True),
            json.dumps(before, separators=(",", ":"), sort_keys=True),
            owner_pid or None,
            owner_boot_id,
            owner_start_ticks,
        ),
    )
    conn.commit()
    return get_record(conn, operation_id)


def finish_operation(conn: sqlite3.Connection, args) -> dict:
    operation_id = str(args.operation_id or "").strip()
    status = str(args.status or "").strip().upper()
    verification_status = str(args.verification_status or "NOT_RUN").strip().upper()

    if status not in FINISH_STATUSES:
        raise RuntimeError(f"invalid operation finish status: {status}")
    if verification_status not in VERIFICATION_STATUSES:
        raise RuntimeError(f"invalid verification status: {verification_status}")

    current = get_record(conn, operation_id)
    if current["status"] != "RUNNING":
        raise RuntimeError(
            f"PX operation {operation_id} is already {current['status']}"
        )

    after = parse_json_text(args.after_json, "after evidence")
    verification = parse_json_text(args.verification_json, "verification evidence")

    conn.execute(
        """
        UPDATE operations
        SET status = ?,
            exit_code = ?,
            after_json = ?,
            verification_status = ?,
            verification_json = ?,
            result_summary = ?,
            completed_at = CURRENT_TIMESTAMP
        WHERE operation_id = ?
        """,
        (
            status,
            args.exit_code,
            json.dumps(after, separators=(",", ":"), sort_keys=True),
            verification_status,
            json.dumps(verification, separators=(",", ":"), sort_keys=True),
            str(args.result_summary or "")[:8192],
            operation_id,
        ),
    )
    conn.commit()
    return get_record(conn, operation_id)


def list_operations(conn: sqlite3.Connection, args) -> list:
    limit = int(args.limit)
    if limit < 1 or limit > 1000:
        raise RuntimeError("operation limit must be between 1 and 1000")

    status = str(args.status or "").strip().upper()
    if status and status not in {"RUNNING", "COMPLETE", "FAILED", "INTERRUPTED"}:
        raise RuntimeError(f"invalid operation status filter: {status}")

    if status == "INTERRUPTED":
        rows = conn.execute(
            """
            SELECT * FROM operations
            WHERE interrupted_at IS NOT NULL
            ORDER BY started_at DESC, operation_id DESC
            LIMIT ?
            """,
            (limit,),
        ).fetchall()
    elif status == "FAILED":
        rows = conn.execute(
            """
            SELECT * FROM operations
            WHERE status = 'FAILED'
              AND interrupted_at IS NULL
            ORDER BY started_at DESC, operation_id DESC
            LIMIT ?
            """,
            (limit,),
        ).fetchall()
    elif status:
        rows = conn.execute(
            """
            SELECT * FROM operations
            WHERE status = ?
            ORDER BY started_at DESC, operation_id DESC
            LIMIT ?
            """,
            (status, limit),
        ).fetchall()
    else:
        rows = conn.execute(
            """
            SELECT * FROM operations
            ORDER BY started_at DESC, operation_id DESC
            LIMIT ?
            """,
            (limit,),
        ).fetchall()

    return [normalize_record(row) for row in rows]


def stale_operations(conn: sqlite3.Connection, args) -> list:
    limit = int(args.limit)
    if limit < 1 or limit > 1000:
        raise RuntimeError("operation limit must be between 1 and 1000")

    rows = conn.execute(
        """
        SELECT * FROM operations
        WHERE status = 'RUNNING'
          AND interrupted_at IS NULL
        ORDER BY started_at DESC, operation_id DESC
        LIMIT ?
        """,
        (limit,),
    ).fetchall()

    return [
        normalize_record(row)
        for row in rows
        if owner_state(row)[0] == "STALE"
    ]


def reconcile_operation(conn: sqlite3.Connection, args) -> dict:
    operation_id = str(args.operation_id or "").strip()
    if not operation_id:
        raise RuntimeError("operation id required for interruption reconciliation")

    row = conn.execute(
        "SELECT * FROM operations WHERE operation_id = ?",
        (operation_id,),
    ).fetchone()
    if row is None:
        raise RuntimeError(f"unknown PX operation: {operation_id}")

    if str(row["status"]) != "RUNNING" or row["interrupted_at"]:
        current = normalize_record(row)
        raise RuntimeError(
            f"PX operation {operation_id} is already {current['status']}"
        )

    state, state_reason = owner_state(row)
    force_unknown = bool(args.force_unknown)
    if state == "LIVE":
        raise RuntimeError(
            "interruption reconciliation refused: operation owner is still live"
        )
    if state == "UNKNOWN" and not force_unknown:
        raise RuntimeError(
            "interruption reconciliation refused: owner state is UNKNOWN; "
            "use --force-unknown only after external inspection confirms "
            "the journal owner is gone"
        )

    reason = str(args.reason or "").strip()
    if not reason:
        if state == "STALE":
            reason = state_reason
        else:
            reason = "operator explicitly reconciled an unowned legacy RUNNING journal"

    interruption = {
        "interrupted": True,
        "outcome": "UNKNOWN",
        "ownerState": state,
        "ownerReason": state_reason,
        "reason": reason,
        "reconciledBy": "PX_OPERATION_RECONCILE",
        "next": (
            "inspect domain state before retrying, recovering, or assuming "
            "the mutation did or did not happen"
        ),
    }
    after = {"interruption": interruption}
    verification = {
        "status": "INTERRUPTED",
        "outcome": "UNKNOWN",
        "reason": reason,
        "ownerState": state,
    }

    conn.execute(
        """
        UPDATE operations
        SET status = 'FAILED',
            after_json = ?,
            verification_status = 'UNAVAILABLE',
            verification_json = ?,
            result_summary = ?,
            interrupted_at = CURRENT_TIMESTAMP,
            completed_at = CURRENT_TIMESTAMP
        WHERE operation_id = ?
          AND status = 'RUNNING'
          AND interrupted_at IS NULL
        """,
        (
            json.dumps(after, separators=(",", ":"), sort_keys=True),
            json.dumps(verification, separators=(",", ":"), sort_keys=True),
            "operation journal interrupted; execution outcome is UNKNOWN",
            operation_id,
        ),
    )
    if conn.total_changes < 1:
        raise RuntimeError(
            "interruption reconciliation lost a race with another journal update"
        )
    conn.commit()
    return get_record(conn, operation_id)


def workflow_create_recovery_plan(record: dict) -> dict | None:
    if str(record.get("actionId") or "") != "workflow.create":
        return None
    if str(record.get("status") or "") != "COMPLETE":
        return None
    if str(record.get("verificationStatus") or "") != "PASSED":
        return None

    after = record.get("after") or {}
    stdout = after.get("stdout") if isinstance(after, dict) else None
    verification = record.get("verification") or {}
    target = (
        verification.get("target")
        if isinstance(verification, dict)
        else None
    )

    if not isinstance(stdout, dict) or not isinstance(target, dict):
        return None

    install = stdout.get("install") or {}
    if not isinstance(install, dict) or install.get("installed") is not True:
        return None

    plan = {
        "repository": str(stdout.get("repository") or ""),
        "base": str(stdout.get("base") or ""),
        "path": str(stdout.get("path") or ""),
        "yaml": str(stdout.get("yaml") or ""),
        "installCommit": str(install.get("commit") or ""),
        "remoteBlobSha": str(target.get("remoteBlobSha") or ""),
        "verifiedBaseSha": str(target.get("currentBaseSha") or ""),
        "expectedYamlSha": str(target.get("expectedYamlSha") or ""),
    }

    required = (
        "repository",
        "base",
        "path",
        "yaml",
        "installCommit",
        "remoteBlobSha",
        "verifiedBaseSha",
        "expectedYamlSha",
    )
    if any(not plan[key] for key in required):
        return None

    return plan


def recovery_payload(record: dict) -> dict:
    recovery = str(record.get("recovery") or "NONE")
    base = {
        "operationId": record["id"],
        "actionId": record["actionId"],
        "status": record["status"],
        "recovery": recovery,
        "automaticRecoveryAvailable": False,
        "executorAvailable": False,
        "requiresLiveValidation": False,
        "planAvailable": False,
    }

    if recovery == "NONE":
        return {
            **base,
            "strategy": "NONE",
            "reason": "this action declares no recovery operation",
        }
    if recovery == "EVIDENCE_ONLY":
        return {
            **base,
            "strategy": "EVIDENCE_ONLY",
            "reason": "operation evidence is durable; automatic undo is not promised",
        }

    if recovery == "CONTENT_RECOVERABLE":
        plan = workflow_create_recovery_plan(record)
        if plan is not None:
            return {
                **base,
                "strategy": "DELETE_CREATED_WORKFLOW",
                "planAvailable": True,
                "executorAvailable": True,
                "requiresLiveValidation": True,
                "executionCommand": [
                    "operation",
                    "recover",
                    record["id"],
                    "--json",
                ],
                "plan": plan,
                "reason": (
                    "exact created-workflow content and verified remote identity "
                    "are durable; execution requires live history and content "
                    "validation before deletion"
                ),
            }

    return {
        **base,
        "strategy": recovery,
        "reason": (
            "the action declares a recoverable class, but durable evidence is "
            "insufficient for a registered PX recovery plan"
        ),
    }


def emit(payload, as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return

    if isinstance(payload, list):
        for row in payload:
            print(
                f"{row['id']}\t{row['status']}\t{row['mutation']}\t"
                f"{row['actionId']}\t{row['startedAt']}"
            )
        return

    if isinstance(payload, dict):
        for key, value in payload.items():
            print(f"{key}: {value}")
        return

    print(payload)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="px operation",
        description="Post-Apollo durable PX operation journal",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    start = sub.add_parser("start")
    start.add_argument("--action-id", required=True)
    start.add_argument("--title", default="")
    start.add_argument("--mutation", required=True, choices=sorted(MUTATIONS))
    start.add_argument("--recovery", required=True, choices=sorted(RECOVERY_CLASSES))
    start.add_argument("--command-json", required=True)
    start.add_argument("--arguments-json", default="{}")
    start.add_argument("--before-json", default="{}")
    start.add_argument("--owner-pid", type=int, default=0)
    start.add_argument("--json", action="store_true")

    finish = sub.add_parser("finish")
    finish.add_argument("operation_id")
    finish.add_argument("--status", required=True, choices=sorted(FINISH_STATUSES))
    finish.add_argument("--exit-code", type=int)
    finish.add_argument(
        "--verification-status",
        default="NOT_RUN",
        choices=sorted(VERIFICATION_STATUSES),
    )
    finish.add_argument("--after-json", default="{}")
    finish.add_argument("--verification-json", default="{}")
    finish.add_argument("--result-summary", default="")
    finish.add_argument("--json", action="store_true")

    get = sub.add_parser("get")
    get.add_argument("operation_id")
    get.add_argument("--json", action="store_true")

    listing = sub.add_parser("list")
    listing.add_argument("--limit", type=int, default=50)
    listing.add_argument("--status", default="")
    listing.add_argument("--json", action="store_true")

    stale = sub.add_parser("stale")
    stale.add_argument("--limit", type=int, default=100)
    stale.add_argument("--json", action="store_true")

    reconcile = sub.add_parser("reconcile")
    reconcile.add_argument("operation_id")
    reconcile.add_argument("--reason", default="")
    reconcile.add_argument("--force-unknown", action="store_true")
    reconcile.add_argument("--json", action="store_true")

    recovery = sub.add_parser("recovery")
    recovery.add_argument("operation_id")
    recovery.add_argument("--json", action="store_true")

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    try:
        with connect() as conn:
            if args.command == "start":
                payload = start_operation(conn, args)
            elif args.command == "finish":
                payload = finish_operation(conn, args)
            elif args.command == "get":
                payload = get_record(conn, args.operation_id)
            elif args.command == "list":
                payload = list_operations(conn, args)
            elif args.command == "stale":
                payload = stale_operations(conn, args)
            elif args.command == "reconcile":
                payload = reconcile_operation(conn, args)
            elif args.command == "recovery":
                payload = recovery_payload(get_record(conn, args.operation_id))
            else:
                raise RuntimeError(f"unknown operation command: {args.command}")

        emit(payload, getattr(args, "json", False))
        return 0
    except (RuntimeError, sqlite3.Error, OSError) as exc:
        print(f"px operation: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
