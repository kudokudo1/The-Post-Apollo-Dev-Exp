#!/usr/bin/env python3
import argparse
import json
import os
import sqlite3
import sys
from pathlib import Path

SCHEMA_VERSION = 4

SCHEMA_V1 = """
CREATE TABLE IF NOT EXISTS schema_meta (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS patients (
    patient_id TEXT PRIMARY KEY,
    repository TEXT NOT NULL,
    label TEXT NOT NULL DEFAULT '',
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS rooms (
    room_id TEXT PRIMARY KEY,
    patient_id TEXT,
    team TEXT NOT NULL DEFAULT '',
    branch TEXT NOT NULL DEFAULT '',
    bed_path TEXT NOT NULL DEFAULT '',
    doctor_id TEXT NOT NULL DEFAULT '',
    current_assignment_id TEXT NOT NULL DEFAULT '',
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (patient_id) REFERENCES patients(patient_id) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS sessions (
    session_id TEXT PRIMARY KEY,
    room_id TEXT NOT NULL,
    doctor_id TEXT NOT NULL DEFAULT '',
    provider_id TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL DEFAULT 'IDLE',
    started_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    ended_at TEXT,
    FOREIGN KEY (room_id) REFERENCES rooms(room_id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS messages (
    message_id INTEGER PRIMARY KEY AUTOINCREMENT,
    room_id TEXT NOT NULL,
    session_id TEXT,
    author_role TEXT NOT NULL,
    author_id TEXT NOT NULL DEFAULT '',
    direction TEXT NOT NULL,
    message_type TEXT NOT NULL DEFAULT 'chat',
    body_md TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (room_id) REFERENCES rooms(room_id) ON DELETE CASCADE,
    FOREIGN KEY (session_id) REFERENCES sessions(session_id) ON DELETE SET NULL
);

CREATE INDEX IF NOT EXISTS idx_sessions_room
    ON sessions(room_id, updated_at DESC);

CREATE INDEX IF NOT EXISTS idx_messages_room
    ON messages(room_id, message_id DESC);

CREATE INDEX IF NOT EXISTS idx_messages_session
    ON messages(session_id, message_id DESC);
"""

SCHEMA_V2 = """
ALTER TABLE sessions
    ADD COLUMN provider_session_id TEXT NOT NULL DEFAULT '';

ALTER TABLE sessions
    ADD COLUMN working_directory TEXT NOT NULL DEFAULT '';

ALTER TABLE sessions
    ADD COLUMN last_exit_code INTEGER;

ALTER TABLE sessions
    ADD COLUMN last_error TEXT NOT NULL DEFAULT '';

CREATE TABLE IF NOT EXISTS session_events (
    event_id INTEGER PRIMARY KEY AUTOINCREMENT,
    session_id TEXT NOT NULL,
    event_type TEXT NOT NULL,
    payload_json TEXT NOT NULL DEFAULT '{}',
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (session_id) REFERENCES sessions(session_id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_session_events_session
    ON session_events(session_id, event_id DESC);
"""

SCHEMA_V3 = """
CREATE TABLE IF NOT EXISTS doctors (
    doctor_id TEXT PRIMARY KEY,
    name TEXT NOT NULL DEFAULT '',
    role TEXT NOT NULL DEFAULT 'DOCTOR',
    status TEXT NOT NULL DEFAULT 'ACTIVE',
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_doctors_status
    ON doctors(status, updated_at DESC);
"""

SCHEMA_V4 = """
ALTER TABLE rooms
    ADD COLUMN provider_id TEXT NOT NULL DEFAULT '';
"""

def hospital_data_dir() -> Path:
    override = os.environ.get("PX_HOSPITAL_DATA_DIR", "").strip()
    if override:
        return Path(override).expanduser()

    xdg = os.environ.get("XDG_DATA_HOME", "").strip()
    if xdg:
        return Path(xdg).expanduser() / "post-apollo" / "hospital"

    return Path.home() / ".local" / "share" / "post-apollo" / "hospital"

def hospital_db_path() -> Path:
    override = os.environ.get("PX_HOSPITAL_DB", "").strip()
    if override:
        return Path(override).expanduser()
    return hospital_data_dir() / "hospital.db"

def artifact_dir() -> Path:
    return hospital_data_dir() / "artifacts"

def connect() -> sqlite3.Connection:
    db_path = hospital_db_path()
    db_path.parent.mkdir(parents=True, exist_ok=True)
    artifact_dir().mkdir(parents=True, exist_ok=True)

    conn = sqlite3.connect(db_path)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    conn.execute("PRAGMA journal_mode = WAL")
    conn.execute("PRAGMA synchronous = NORMAL")
    return conn

def current_schema_version(conn: sqlite3.Connection) -> int:
    conn.execute(
        "CREATE TABLE IF NOT EXISTS schema_meta "
        "(key TEXT PRIMARY KEY, value TEXT NOT NULL)"
    )
    row = conn.execute(
        "SELECT value FROM schema_meta WHERE key = 'schema_version'"
    ).fetchone()
    if row is None:
        return 0
    try:
        return int(row["value"])
    except (TypeError, ValueError):
        raise RuntimeError("invalid Hospital schema version")

def migrate(conn: sqlite3.Connection) -> int:
    version = current_schema_version(conn)
    if version > SCHEMA_VERSION:
        raise RuntimeError(
            f"Hospital database schema {version} is newer than PX supports "
            f"({SCHEMA_VERSION})"
        )

    if version < 1:
        conn.executescript(SCHEMA_V1)
        conn.execute(
            "INSERT INTO schema_meta(key, value) VALUES('schema_version', ?) "
            "ON CONFLICT(key) DO UPDATE SET value = excluded.value",
            ("1",),
        )
        conn.commit()
        version = 1

    if version < 2:
        conn.executescript(SCHEMA_V2)
        conn.execute(
            "UPDATE schema_meta SET value = ? WHERE key = 'schema_version'",
            ("2",),
        )
        conn.commit()
        version = 2

    if version < 3:
        conn.executescript(SCHEMA_V3)
        conn.execute(
            "UPDATE schema_meta SET value = ? WHERE key = 'schema_version'",
            ("3",),
        )
        conn.commit()
        version = 3

    if version < 4:
        conn.executescript(SCHEMA_V4)
        conn.execute(
            "UPDATE schema_meta SET value = ? WHERE key = 'schema_version'",
            ("4",),
        )
        conn.commit()
        version = 4

    return version

def database_status(conn: sqlite3.Connection) -> dict:
    version = migrate(conn)
    counts = {}
    for table in ("patients", "rooms", "doctors", "sessions", "messages", "session_events"):
        row = conn.execute(f"SELECT COUNT(*) AS count FROM {table}").fetchone()
        counts[table] = int(row["count"])

    return {
        "status": "READY",
        "schema_version": version,
        "database": str(hospital_db_path()),
        "artifacts": str(artifact_dir()),
        "counts": counts,
    }

def emit(payload: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, sort_keys=True))
        return

    print(f"status: {payload['status']}")
    print(f"schema: {payload['schema_version']}")
    print(f"database: {payload['database']}")
    print(f"artifacts: {payload['artifacts']}")
    counts = payload["counts"]
    print(
        "records: "
        f"patients={counts['patients']} "
        f"rooms={counts['rooms']} "
        f"doctors={counts['doctors']} "
        f"sessions={counts['sessions']} "
        f"messages={counts['messages']} "
        f"events={counts['session_events']}"
    )


def emit_data(payload, as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, sort_keys=True))
    else:
        print(json.dumps(payload, indent=2, sort_keys=True))


def normalize_doctor(row: sqlite3.Row) -> dict:
    return {
        "id": str(row["doctor_id"]),
        "name": str(row["name"] or row["doctor_id"]),
        "role": str(row["role"] or "DOCTOR"),
        "status": str(row["status"] or "ACTIVE"),
        "createdAt": str(row["created_at"] or ""),
        "updatedAt": str(row["updated_at"] or ""),
    }


def ensure_doctor(conn: sqlite3.Connection, doctor_id: str) -> None:
    doctor_id = str(doctor_id or "").strip()
    if not doctor_id:
        return

    conn.execute(
        """
        INSERT INTO doctors(doctor_id, name)
        VALUES(?, ?)
        ON CONFLICT(doctor_id) DO NOTHING
        """,
        (doctor_id, doctor_id),
    )


def doctor_put(conn: sqlite3.Connection, args) -> dict:
    conn.execute(
        """
        INSERT INTO doctors(doctor_id, name, role, status)
        VALUES(?, ?, ?, ?)
        ON CONFLICT(doctor_id) DO UPDATE SET
            name = excluded.name,
            role = excluded.role,
            status = excluded.status,
            updated_at = CURRENT_TIMESTAMP
        """,
        (
            args.doctor_id,
            args.name or args.doctor_id,
            args.role or "DOCTOR",
            args.status,
        ),
    )
    conn.commit()
    return doctor_record(conn, args.doctor_id)


def doctor_record(conn: sqlite3.Connection, doctor_id: str) -> dict:
    row = conn.execute(
        "SELECT * FROM doctors WHERE doctor_id = ?",
        (doctor_id,),
    ).fetchone()
    if row is None:
        raise RuntimeError(f"unknown Hospital doctor: {doctor_id}")
    return normalize_doctor(row)


def doctors_list(conn: sqlite3.Connection, status: str | None) -> list:
    if status:
        rows = conn.execute(
            """
            SELECT * FROM doctors
            WHERE status = ?
            ORDER BY updated_at DESC, doctor_id ASC
            """,
            (status,),
        ).fetchall()
    else:
        rows = conn.execute(
            """
            SELECT * FROM doctors
            ORDER BY updated_at DESC, doctor_id ASC
            """
        ).fetchall()
    return [normalize_doctor(row) for row in rows]


def patient_put(conn: sqlite3.Connection, args) -> dict:
    conn.execute(
        """
        INSERT INTO patients(patient_id, repository, label)
        VALUES(?, ?, ?)
        ON CONFLICT(patient_id) DO UPDATE SET
            repository = excluded.repository,
            label = excluded.label,
            updated_at = CURRENT_TIMESTAMP
        """,
        (args.patient_id, args.repository, args.label or ""),
    )
    conn.commit()
    row = conn.execute(
        "SELECT * FROM patients WHERE patient_id = ?",
        (args.patient_id,),
    ).fetchone()
    return dict(row)


def room_bind(conn: sqlite3.Connection, args) -> dict:
    patient_id = (args.patient_id or args.repository).strip()
    if not patient_id:
        raise RuntimeError("Hospital room bind requires a patient identity")

    conn.execute(
        """
        INSERT INTO patients(patient_id, repository, label)
        VALUES(?, ?, ?)
        ON CONFLICT(patient_id) DO UPDATE SET
            repository = excluded.repository,
            label = excluded.label,
            updated_at = CURRENT_TIMESTAMP
        """,
        (
            patient_id,
            args.repository,
            args.patient_label or "",
        ),
    )

    ensure_doctor(conn, args.doctor_id)

    conn.execute(
        """
        INSERT INTO rooms(
            room_id, patient_id, team, branch, bed_path, doctor_id,
            provider_id, current_assignment_id
        )
        VALUES(?, ?, ?, ?, ?, ?, ?, ?)
        ON CONFLICT(room_id) DO UPDATE SET
            patient_id = excluded.patient_id,
            team = excluded.team,
            branch = excluded.branch,
            bed_path = excluded.bed_path,
            doctor_id = excluded.doctor_id,
            provider_id = excluded.provider_id,
            current_assignment_id = excluded.current_assignment_id,
            updated_at = CURRENT_TIMESTAMP
        """,
        (
            args.room_id,
            patient_id,
            args.team or "",
            args.branch or "",
            args.bed_path or "",
            args.doctor_id or "",
            args.provider_id or "",
            args.assignment_id or "",
        ),
    )

    conn.commit()
    return room_record(conn, args.room_id)


def room_put(conn: sqlite3.Connection, args) -> dict:
    ensure_doctor(conn, args.doctor_id)

    conn.execute(
        """
        INSERT INTO rooms(
            room_id, patient_id, team, branch, bed_path, doctor_id,
            provider_id, current_assignment_id
        )
        VALUES(?, ?, ?, ?, ?, ?, ?, ?)
        ON CONFLICT(room_id) DO UPDATE SET
            patient_id = excluded.patient_id,
            team = excluded.team,
            branch = excluded.branch,
            bed_path = excluded.bed_path,
            doctor_id = excluded.doctor_id,
            provider_id = excluded.provider_id,
            current_assignment_id = excluded.current_assignment_id,
            updated_at = CURRENT_TIMESTAMP
        """,
        (
            args.room_id,
            args.patient_id or None,
            args.team or "",
            args.branch or "",
            args.bed_path or "",
            args.doctor_id or "",
            args.provider_id or "",
            args.assignment_id or "",
        ),
    )
    conn.commit()
    return room_record(conn, args.room_id)


def room_record(conn: sqlite3.Connection, room_id: str) -> dict:
    row = conn.execute(
        """
        SELECT
            r.*,
            p.repository AS repository,
            p.label AS patient_label,
            (
                SELECT m.body_md
                FROM messages m
                WHERE m.room_id = r.room_id
                ORDER BY m.message_id DESC
                LIMIT 1
            ) AS last_message
        FROM rooms r
        LEFT JOIN patients p ON p.patient_id = r.patient_id
        WHERE r.room_id = ?
        """,
        (room_id,),
    ).fetchone()
    if row is None:
        raise RuntimeError(f"unknown Hospital room: {room_id}")
    return normalize_room(row)


def normalize_room(row: sqlite3.Row) -> dict:
    team = str(row["team"] or "")
    branch = str(row["branch"] or "")
    room_id = str(row["room_id"])
    return {
        "id": room_id,
        "displayNameInProfile": team or room_id,
        "nickname": branch,
        "lastMessage": str(row["last_message"] or ""),
        "patientId": str(row["patient_id"] or ""),
        "repository": str(row["repository"] or ""),
        "patientLabel": str(row["patient_label"] or ""),
        "team": team,
        "branch": branch,
        "bedPath": str(row["bed_path"] or ""),
        "doctorId": str(row["doctor_id"] or ""),
        "providerId": str(row["provider_id"] or ""),
        "assignmentId": str(row["current_assignment_id"] or ""),
        "createdAt": str(row["created_at"] or ""),
        "updatedAt": str(row["updated_at"] or ""),
    }


def rooms_list(conn: sqlite3.Connection) -> list:
    rows = conn.execute(
        """
        SELECT
            r.*,
            p.repository AS repository,
            p.label AS patient_label,
            (
                SELECT m.body_md
                FROM messages m
                WHERE m.room_id = r.room_id
                ORDER BY m.message_id DESC
                LIMIT 1
            ) AS last_message
        FROM rooms r
        LEFT JOIN patients p ON p.patient_id = r.patient_id
        ORDER BY r.updated_at DESC, r.room_id ASC
        """
    ).fetchall()
    return [normalize_room(row) for row in rows]


def session_put(conn: sqlite3.Connection, args) -> dict:
    ensure_doctor(conn, args.doctor_id)

    room_exists = conn.execute(
        "SELECT 1 FROM rooms WHERE room_id = ?",
        (args.room_id,),
    ).fetchone()
    if room_exists is None:
        raise RuntimeError(f"unknown Hospital room: {args.room_id}")

    conn.execute(
        """
        INSERT INTO sessions(
            session_id, room_id, doctor_id, provider_id, status
        )
        VALUES(?, ?, ?, ?, ?)
        ON CONFLICT(session_id) DO UPDATE SET
            room_id = excluded.room_id,
            doctor_id = excluded.doctor_id,
            provider_id = excluded.provider_id,
            status = excluded.status,
            updated_at = CURRENT_TIMESTAMP
        """,
        (
            args.session_id,
            args.room_id,
            args.doctor_id or "",
            args.provider_id or "",
            args.status,
        ),
    )
    if args.provider_id:
        conn.execute(
            """
            UPDATE rooms
            SET provider_id = ?, updated_at = CURRENT_TIMESTAMP
            WHERE room_id = ?
            """,
            (args.provider_id, args.room_id),
        )

    conn.commit()
    row = conn.execute(
        "SELECT * FROM sessions WHERE session_id = ?",
        (args.session_id,),
    ).fetchone()
    return normalize_session(row)


def normalize_session(row: sqlite3.Row) -> dict:
    keys = set(row.keys())
    return {
        "id": str(row["session_id"]),
        "roomId": str(row["room_id"]),
        "doctorId": str(row["doctor_id"] or ""),
        "providerId": str(row["provider_id"] or ""),
        "providerSessionId": (
            str(row["provider_session_id"] or "")
            if "provider_session_id" in keys
            else ""
        ),
        "workingDirectory": (
            str(row["working_directory"] or "")
            if "working_directory" in keys
            else ""
        ),
        "status": str(row["status"] or ""),
        "lastExitCode": (
            row["last_exit_code"]
            if "last_exit_code" in keys
            else None
        ),
        "lastError": (
            str(row["last_error"] or "")
            if "last_error" in keys
            else ""
        ),
        "startedAt": str(row["started_at"] or ""),
        "updatedAt": str(row["updated_at"] or ""),
        "endedAt": str(row["ended_at"] or ""),
    }


def session_record(conn: sqlite3.Connection, session_id: str) -> dict:
    row = conn.execute(
        "SELECT * FROM sessions WHERE session_id = ?",
        (session_id,),
    ).fetchone()
    if row is None:
        raise RuntimeError(f"unknown Hospital session: {session_id}")
    return normalize_session(row)


def session_runtime_update(conn: sqlite3.Connection, args) -> dict:
    session_record(conn, args.session_id)

    fields = ["updated_at = CURRENT_TIMESTAMP"]
    values = []

    if args.provider_session_id is not None:
        fields.append("provider_session_id = ?")
        values.append(args.provider_session_id)

    if args.working_directory is not None:
        fields.append("working_directory = ?")
        values.append(args.working_directory)

    if args.status is not None:
        fields.append("status = ?")
        values.append(args.status)

    if args.last_exit_code is not None:
        fields.append("last_exit_code = ?")
        values.append(args.last_exit_code)

    if args.last_error is not None:
        fields.append("last_error = ?")
        values.append(args.last_error)

    if args.clear_error:
        fields.append("last_error = ''")

    if args.ended:
        fields.append("ended_at = CURRENT_TIMESTAMP")

    values.append(args.session_id)
    conn.execute(
        f"UPDATE sessions SET {', '.join(fields)} WHERE session_id = ?",
        values,
    )
    conn.commit()
    return session_record(conn, args.session_id)


def normalize_event(row: sqlite3.Row) -> dict:
    try:
        payload = json.loads(str(row["payload_json"] or "{}"))
    except json.JSONDecodeError:
        payload = {"raw": str(row["payload_json"] or "")}

    return {
        "id": str(row["event_id"]),
        "sessionId": str(row["session_id"]),
        "type": str(row["event_type"]),
        "payload": payload,
        "createdAt": str(row["created_at"]),
    }


def event_append(conn: sqlite3.Connection, args) -> dict:
    session_record(conn, args.session_id)

    payload_text = args.payload or "{}"
    try:
        payload = json.loads(payload_text)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"Hospital event payload is not valid JSON: {exc}")

    cur = conn.execute(
        """
        INSERT INTO session_events(session_id, event_type, payload_json)
        VALUES(?, ?, ?)
        """,
        (
            args.session_id,
            args.event_type,
            json.dumps(payload, sort_keys=True),
        ),
    )
    conn.commit()
    row = conn.execute(
        "SELECT * FROM session_events WHERE event_id = ?",
        (cur.lastrowid,),
    ).fetchone()
    return normalize_event(row)


def events_list(
    conn: sqlite3.Connection,
    session_id: str,
    limit: int,
    before_id: int | None,
) -> list:
    session_record(conn, session_id)

    if limit < 1 or limit > 1000:
        raise RuntimeError("Hospital event limit must be between 1 and 1000")

    if before_id is None:
        rows = conn.execute(
            """
            SELECT * FROM session_events
            WHERE session_id = ?
            ORDER BY event_id DESC
            LIMIT ?
            """,
            (session_id, limit),
        ).fetchall()
    else:
        rows = conn.execute(
            """
            SELECT * FROM session_events
            WHERE session_id = ? AND event_id < ?
            ORDER BY event_id DESC
            LIMIT ?
            """,
            (session_id, before_id, limit),
        ).fetchall()

    rows = list(reversed(rows))
    return [normalize_event(row) for row in rows]


def sessions_list(conn: sqlite3.Connection, room_id: str | None) -> list:
    if room_id:
        rows = conn.execute(
            """
            SELECT * FROM sessions
            WHERE room_id = ?
            ORDER BY updated_at DESC, started_at DESC
            """,
            (room_id,),
        ).fetchall()
    else:
        rows = conn.execute(
            """
            SELECT * FROM sessions
            ORDER BY updated_at DESC, started_at DESC
            """
        ).fetchall()
    return [normalize_session(row) for row in rows]


def message_append(conn: sqlite3.Connection, args) -> dict:
    room_exists = conn.execute(
        "SELECT 1 FROM rooms WHERE room_id = ?",
        (args.room_id,),
    ).fetchone()
    if room_exists is None:
        raise RuntimeError(f"unknown Hospital room: {args.room_id}")

    if args.session_id:
        session = conn.execute(
            "SELECT room_id FROM sessions WHERE session_id = ?",
            (args.session_id,),
        ).fetchone()
        if session is None:
            raise RuntimeError(f"unknown Hospital session: {args.session_id}")
        if str(session["room_id"]) != args.room_id:
            raise RuntimeError(
                f"Hospital session {args.session_id} belongs to "
                f"{session['room_id']}, not {args.room_id}"
            )

    if args.body_stdin:
        body = sys.stdin.read()
    else:
        body = args.body or ""

    if not body.strip():
        raise RuntimeError("Hospital message body is empty")

    cur = conn.execute(
        """
        INSERT INTO messages(
            room_id, session_id, author_role, author_id, direction,
            message_type, body_md
        )
        VALUES(?, ?, ?, ?, ?, ?, ?)
        """,
        (
            args.room_id,
            args.session_id or None,
            args.author_role,
            args.author_id or "",
            args.direction,
            args.message_type,
            body,
        ),
    )
    conn.execute(
        "UPDATE rooms SET updated_at = CURRENT_TIMESTAMP WHERE room_id = ?",
        (args.room_id,),
    )
    if args.session_id:
        conn.execute(
            """
            UPDATE sessions
            SET updated_at = CURRENT_TIMESTAMP
            WHERE session_id = ?
            """,
            (args.session_id,),
        )
    conn.commit()
    row = conn.execute(
        "SELECT * FROM messages WHERE message_id = ?",
        (cur.lastrowid,),
    ).fetchone()
    return normalize_message(row)


def normalize_message(row: sqlite3.Row) -> dict:
    return {
        "id": str(row["message_id"]),
        "roomId": str(row["room_id"]),
        "sessionId": str(row["session_id"] or ""),
        "authorRole": str(row["author_role"]),
        "authorId": str(row["author_id"] or ""),
        "direction": str(row["direction"]),
        "messageType": str(row["message_type"]),
        "body": str(row["body_md"]),
        "createdAt": str(row["created_at"]),
    }


def messages_list(
    conn: sqlite3.Connection,
    room_id: str,
    limit: int,
    before_id: int | None,
) -> list:
    if limit < 1 or limit > 500:
        raise RuntimeError("Hospital message limit must be between 1 and 500")

    if before_id is None:
        rows = conn.execute(
            """
            SELECT * FROM messages
            WHERE room_id = ?
            ORDER BY message_id DESC
            LIMIT ?
            """,
            (room_id, limit),
        ).fetchall()
    else:
        rows = conn.execute(
            """
            SELECT * FROM messages
            WHERE room_id = ? AND message_id < ?
            ORDER BY message_id DESC
            LIMIT ?
            """,
            (room_id, before_id, limit),
        ).fetchall()

    rows = list(reversed(rows))
    return [normalize_message(row) for row in rows]


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="px hospital",
        description="Post-Apollo Hospital durable state store",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    for name in ("init", "status"):
        command = sub.add_parser(name)
        command.add_argument("--json", action="store_true")

    doctor = sub.add_parser("doctor-put")
    doctor.add_argument("doctor_id")
    doctor.add_argument("--name", default="")
    doctor.add_argument("--role", default="DOCTOR")
    doctor.add_argument(
        "--status",
        default="ACTIVE",
        choices=("ACTIVE", "INACTIVE", "RELEASED"),
    )
    doctor.add_argument("--json", action="store_true")

    doctor_get = sub.add_parser("doctor")
    doctor_get.add_argument("doctor_id")
    doctor_get.add_argument("--json", action="store_true")

    doctors = sub.add_parser("doctors")
    doctors.add_argument("--status", default="")
    doctors.add_argument("--json", action="store_true")

    patient = sub.add_parser("patient-put")
    patient.add_argument("patient_id")
    patient.add_argument("repository")
    patient.add_argument("--label", default="")
    patient.add_argument("--json", action="store_true")

    bind = sub.add_parser("room-bind")
    bind.add_argument("room_id")
    bind.add_argument("--repository", required=True)
    bind.add_argument("--patient-id", default="")
    bind.add_argument("--patient-label", default="")
    bind.add_argument("--team", default="")
    bind.add_argument("--branch", default="")
    bind.add_argument("--bed-path", default="")
    bind.add_argument("--doctor-id", default="")
    bind.add_argument("--provider-id", default="")
    bind.add_argument("--assignment-id", default="")
    bind.add_argument("--json", action="store_true")

    room = sub.add_parser("room-put")
    room.add_argument("room_id")
    room.add_argument("--patient-id", default="")
    room.add_argument("--team", default="")
    room.add_argument("--branch", default="")
    room.add_argument("--bed-path", default="")
    room.add_argument("--doctor-id", default="")
    room.add_argument("--provider-id", default="")
    room.add_argument("--assignment-id", default="")
    room.add_argument("--json", action="store_true")

    rooms = sub.add_parser("rooms")
    rooms.add_argument("--json", action="store_true")

    session = sub.add_parser("session-put")
    session.add_argument("session_id")
    session.add_argument("--room-id", required=True)
    session.add_argument("--doctor-id", default="")
    session.add_argument("--provider-id", default="")
    session.add_argument(
        "--status",
        default="IDLE",
        choices=(
            "IDLE", "THINKING", "OPERATING", "WAITING",
            "PAUSED", "REVIEW", "COMPLETE", "FAILED",
        ),
    )
    session.add_argument("--json", action="store_true")

    sessions = sub.add_parser("sessions")
    sessions.add_argument("--room-id", default="")
    sessions.add_argument("--json", action="store_true")

    session_get = sub.add_parser("session")
    session_get.add_argument("session_id")
    session_get.add_argument("--json", action="store_true")

    session_runtime = sub.add_parser("session-runtime")
    session_runtime.add_argument("session_id")
    session_runtime.add_argument("--provider-session-id")
    session_runtime.add_argument("--working-directory")
    session_runtime.add_argument(
        "--status",
        choices=(
            "IDLE", "THINKING", "OPERATING", "WAITING",
            "PAUSED", "REVIEW", "COMPLETE", "FAILED",
        ),
    )
    session_runtime.add_argument("--last-exit-code", type=int)
    session_runtime.add_argument("--last-error")
    session_runtime.add_argument("--clear-error", action="store_true")
    session_runtime.add_argument("--ended", action="store_true")
    session_runtime.add_argument("--json", action="store_true")

    event = sub.add_parser("event-append")
    event.add_argument("--session-id", required=True)
    event.add_argument("--event-type", required=True)
    event.add_argument("--payload", default="{}")
    event.add_argument("--json", action="store_true")

    events = sub.add_parser("events")
    events.add_argument("session_id")
    events.add_argument("--limit", type=int, default=200)
    events.add_argument("--before-id", type=int)
    events.add_argument("--json", action="store_true")

    message = sub.add_parser("message-append")
    message.add_argument("--room-id", required=True)
    message.add_argument("--session-id", default="")
    message.add_argument("--author-role", required=True)
    message.add_argument("--author-id", default="")
    message.add_argument(
        "--direction",
        required=True,
        choices=("incoming", "outgoing"),
    )
    message.add_argument("--message-type", default="chat")
    body = message.add_mutually_exclusive_group(required=True)
    body.add_argument("--body")
    body.add_argument("--body-stdin", action="store_true")
    message.add_argument("--json", action="store_true")

    messages = sub.add_parser("messages")
    messages.add_argument("room_id")
    messages.add_argument("--limit", type=int, default=100)
    messages.add_argument("--before-id", type=int)
    messages.add_argument("--json", action="store_true")

    return parser

def main() -> int:
    args = build_parser().parse_args()

    try:
        with connect() as conn:
            migrate(conn)

            if args.command in ("init", "status"):
                emit(database_status(conn), args.json)
            elif args.command == "doctor-put":
                emit_data(doctor_put(conn, args), args.json)
            elif args.command == "doctor":
                emit_data(doctor_record(conn, args.doctor_id), args.json)
            elif args.command == "doctors":
                emit_data(
                    doctors_list(conn, args.status or None),
                    args.json,
                )
            elif args.command == "patient-put":
                emit_data(patient_put(conn, args), args.json)
            elif args.command == "room-bind":
                emit_data(room_bind(conn, args), args.json)
            elif args.command == "room-put":
                emit_data(room_put(conn, args), args.json)
            elif args.command == "rooms":
                emit_data(rooms_list(conn), args.json)
            elif args.command == "session-put":
                emit_data(session_put(conn, args), args.json)
            elif args.command == "sessions":
                emit_data(
                    sessions_list(conn, args.room_id or None),
                    args.json,
                )
            elif args.command == "session":
                emit_data(session_record(conn, args.session_id), args.json)
            elif args.command == "session-runtime":
                emit_data(session_runtime_update(conn, args), args.json)
            elif args.command == "event-append":
                emit_data(event_append(conn, args), args.json)
            elif args.command == "events":
                emit_data(
                    events_list(
                        conn,
                        args.session_id,
                        args.limit,
                        args.before_id,
                    ),
                    args.json,
                )
            elif args.command == "message-append":
                emit_data(message_append(conn, args), args.json)
            elif args.command == "messages":
                emit_data(
                    messages_list(
                        conn,
                        args.room_id,
                        args.limit,
                        args.before_id,
                    ),
                    args.json,
                )
            else:
                raise RuntimeError(
                    f"unsupported Hospital command: {args.command}"
                )
    except (OSError, sqlite3.Error, RuntimeError) as exc:
        print(f"px hospital: {exc}", file=sys.stderr)
        return 1

    return 0

if __name__ == "__main__":
    raise SystemExit(main())
