#!/usr/bin/env bash
set -euo pipefail

PX_SOURCE="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$PX_SOURCE")/.." && pwd)"
REGISTRY="${PX_REPO_REGISTRY:-$ROOT/config/repos.tsv}"
ROOMS_REGISTRY="${PX_ROOMS_REGISTRY:-$ROOT/config/audit-rooms.tsv}"
LIMIT="${PX_RUN_LIMIT:-10}"
TOOLBOX_NAME="${PX_TOOLBOX:-fedora-toolbox-44}"

VALIDATION_STATUS="unknown"
VALIDATION_VALIDATOR=""
VALIDATION_MESSAGE=""
INSTALL_BRANCH=""
INSTALL_PR_URL=""
INSTALL_COMMIT_SHA=""

die() {
    printf 'px: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'px: warning: %s\n' "$*" >&2
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

repo_for() {
    local key="${1:-}"
    [[ -n "$key" ]] || die "repo identity required"

    if [[ "$key" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]]; then
        printf '%s\n' "$key"
        return 0
    fi

    awk -F '\t' -v key="$key" '$1 == key { print $2; found=1; exit } END { if (!found) exit 1 }' "$REGISTRY" \
        || die "unknown repo alias: $key"
}

default_branch_for() {
    local repo="$1"
    gh repo view "$repo" --json defaultBranchRef --jq '.defaultBranchRef.name'
}

workflows_for() {
    local repo="$1"
    local output="" error="" status=0 tmp

    tmp="$(mktemp)"
    if output="$(gh workflow list -R "$repo" --json id,name,path,state 2>"$tmp")"; then
        rm -f "$tmp"
        if [[ -z "${output//[[:space:]]/}" ]]; then
            printf '[]\n'
        else
            printf '%s\n' "$output"
        fi
        return 0
    else
        status=$?
    fi

    error="$(cat "$tmp")"
    rm -f "$tmp"

    case "${error,,}" in
        *"no workflows found"*)
            printf '[]\n'
            return 0
            ;;
    esac

    [[ -n "$output" ]] && printf '%s\n' "$output"
    [[ -n "$error" ]] && printf '%s\n' "$error" >&2
    return "$status"
}

validate_slug() {
    local slug="$1"
    [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
        || die "workflow slug must match: [a-z0-9][a-z0-9-]*"
}

render_trigger() {
    local trigger="$1"
    local base="$2"

    case "$trigger" in
        manual)
            cat <<'EOF'
on:
  workflow_dispatch:
EOF
            ;;
        push)
            cat <<EOF
on:
  push:
    branches:
      - $base
EOF
            ;;
        manual+push)
            cat <<EOF
on:
  workflow_dispatch:
  push:
    branches:
      - $base
EOF
            ;;
        *)
            die "unknown trigger: $trigger (use manual, push, or manual+push)"
            ;;
    esac
}

render_workflow() {
    local template="$1"
    local slug="$2"
    local trigger="$3"
    local base="$4"
    local title="${slug//-/ }"

    printf 'name: "PX / %s"\n\n' "$title"
    render_trigger "$trigger" "$base"

    case "$template" in
        smoke)
            cat <<'EOF'

permissions:
  contents: read

jobs:
  smoke:
    name: Repository smoke test
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Report execution identity
        run: |
          echo "repo=$GITHUB_REPOSITORY"
          echo "ref=$GITHUB_REF"
          echo "sha=$GITHUB_SHA"
          echo "PX workflow is alive."
EOF
            ;;
        shell-check)
            cat <<'EOF'

permissions:
  contents: read

jobs:
  shell-check:
    name: Shell syntax check
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Validate shell scripts
        shell: bash
        run: |
          mapfile -d '' scripts < <(find . -type f -name '*.sh' -print0)
          if ((${#scripts[@]} == 0)); then
            echo "No .sh files found; nothing to validate."
            exit 0
          fi

          printf 'Checking %d shell script(s)\n' "${#scripts[@]}"
          for script in "${scripts[@]}"; do
            echo "bash -n $script"
            bash -n "$script"
          done
EOF
            ;;
        *)
            die "unknown template: $template"
            ;;
    esac
}

validate_workflow() {
    local file="$1"
    local output=""

    VALIDATION_STATUS="skipped"
    VALIDATION_VALIDATOR="none"
    VALIDATION_MESSAGE="actionlint unavailable"

    if command -v actionlint >/dev/null 2>&1; then
        VALIDATION_VALIDATOR="actionlint"
        if output="$(actionlint "$file" 2>&1)"; then
            VALIDATION_STATUS="pass"
            VALIDATION_MESSAGE=""
            return 0
        fi
        VALIDATION_STATUS="fail"
        VALIDATION_MESSAGE="$output"
        return 1
    fi

    if command -v toolbox >/dev/null 2>&1 \
        && toolbox run -c "$TOOLBOX_NAME" sh -lc 'command -v actionlint >/dev/null 2>&1' >/dev/null 2>&1; then
        VALIDATION_VALIDATOR="actionlint via $TOOLBOX_NAME"
        if output="$(toolbox run -c "$TOOLBOX_NAME" actionlint - < "$file" 2>&1)"; then
            VALIDATION_STATUS="pass"
            VALIDATION_MESSAGE=""
            return 0
        fi
        VALIDATION_STATUS="fail"
        VALIDATION_MESSAGE="$output"
        return 1
    fi

    return 0
}

print_validation() {
    case "$VALIDATION_STATUS" in
        pass)
            printf 'validation: PASS (%s)\n' "$VALIDATION_VALIDATOR" >&2
            ;;
        fail)
            printf 'validation: FAIL (%s)\n' "$VALIDATION_VALIDATOR" >&2
            [[ -n "$VALIDATION_MESSAGE" ]] && printf '%s\n' "$VALIDATION_MESSAGE" >&2
            ;;
        skipped)
            warn "$VALIDATION_MESSAGE; generated YAML was not semantically validated"
            ;;
    esac
}

install_workflow() {
    local repo="$1"
    local base="$2"
    local slug="$3"
    local yaml_file="$4"
    local workflow_path=".github/workflows/${slug}.yml"
    local encoded commit_sha

    need base64

    if gh api "repos/$repo/contents/$workflow_path?ref=$base" >/dev/null 2>&1; then
        die "$workflow_path already exists on $base; edit support is a later PX seam"
    fi

    encoded="$(base64 < "$yaml_file" | tr -d '\n')"

    commit_sha="$(gh api --method PUT "repos/$repo/contents/$workflow_path" \
        -f message="Add PX workflow: $slug" \
        -f content="$encoded" \
        -f branch="$base" \
        --jq '.commit.sha')"

    [[ -n "$commit_sha" ]] || die "workflow install returned no commit SHA"

    INSTALL_BRANCH="$base"
    INSTALL_PR_URL=""
    INSTALL_COMMIT_SHA="$commit_sha"
}

create_workflow() {
    local alias="${1:-}"
    local template="${2:-}"
    local slug="${3:-}"
    local trigger="manual"
    local mode="--preview"
    local format="human"
    local repo base tmp workflow_path arg
    local validation_ok=true

    [[ -n "$alias" ]] || die "usage: px create <repo> <template> <slug> [trigger] [--preview|--install] [--json]"
    [[ -n "$template" ]] || die "template required"
    [[ -n "$slug" ]] || die "workflow slug required"
    validate_slug "$slug"

    for arg in "${@:4}"; do
        case "$arg" in
            manual|push|manual+push)
                trigger="$arg"
                ;;
            --preview|--install)
                mode="$arg"
                ;;
            --json)
                format="json"
                ;;
            *)
                die "unknown create option: $arg"
                ;;
        esac
    done

    need gh
    if [[ "$format" == "json" ]]; then
        need jq
    fi

    repo="$(repo_for "$alias")"
    base="$(default_branch_for "$repo")"
    [[ -n "$base" ]] || die "could not resolve default branch for $repo"
    workflow_path=".github/workflows/${slug}.yml"

    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' RETURN
    render_workflow "$template" "$slug" "$trigger" "$base" > "$tmp"

    if ! validate_workflow "$tmp"; then
        validation_ok=false
    fi

    INSTALL_BRANCH=""
    INSTALL_PR_URL=""
    INSTALL_COMMIT_SHA=""

    if [[ "$mode" == "--install" ]]; then
        if [[ "$VALIDATION_STATUS" != "pass" ]]; then
            if [[ "$format" == "human" ]]; then
                print_validation
            fi
        else
            install_workflow "$repo" "$base" "$slug" "$tmp"
        fi
    fi

    if [[ "$format" == "json" ]]; then
        local installed=false
        [[ -n "$INSTALL_COMMIT_SHA" ]] && installed=true

        jq -n \
            --arg repo "$alias" \
            --arg repository "$repo" \
            --arg base "$base" \
            --arg template "$template" \
            --arg slug "$slug" \
            --arg trigger "$trigger" \
            --arg path "$workflow_path" \
            --arg mode "${mode#--}" \
            --arg validation_status "$VALIDATION_STATUS" \
            --arg validation_validator "$VALIDATION_VALIDATOR" \
            --arg validation_message "$VALIDATION_MESSAGE" \
            --arg branch "$INSTALL_BRANCH" \
            --arg pull_request "$INSTALL_PR_URL" \
            --arg commit "$INSTALL_COMMIT_SHA" \
            --argjson installed "$installed" \
            --rawfile yaml "$tmp" \
            '{
                repo: $repo,
                repository: $repository,
                base: $base,
                template: $template,
                slug: $slug,
                trigger: $trigger,
                path: $path,
                mode: $mode,
                validation: {
                    status: $validation_status,
                    validator: (if $validation_validator == "" then null else $validation_validator end),
                    message: (if $validation_message == "" then null else $validation_message end)
                },
                yaml: $yaml,
                install: {
                    requested: ($mode == "install"),
                    installed: $installed,
                    branch: (if $branch == "" then null else $branch end),
                    pull_request: (if $pull_request == "" then null else $pull_request end),
                    commit: (if $commit == "" then null else $commit end)
                }
            }'

        if [[ "$validation_ok" != true || ( "$mode" == "--install" && "$VALIDATION_STATUS" != "pass" ) ]]; then
            return 1
        fi
        return 0
    fi

    printf 'PX WORKFLOW CANDIDATE\n'
    printf 'repo: %s (%s)\n' "$alias" "$repo"
    printf 'base: %s\n' "$base"
    printf 'template: %s\n' "$template"
    printf 'slug: %s\n' "$slug"
    printf 'trigger: %s\n' "$trigger"
    printf 'path: %s\n' "$workflow_path"
    printf '\n--- YAML ---\n'
    cat "$tmp"
    printf '%s\n' '--- END YAML ---'

    printf '\n--- VALIDATION ---\n' >&2
    print_validation

    if [[ "$validation_ok" != true ]]; then
        return 1
    fi

    if [[ "$mode" == "--install" ]]; then
        [[ "$VALIDATION_STATUS" == "pass" ]] || die "refusing install without successful semantic validation"
        printf '\n--- INSTALL ---\n'
        printf 'installed: %s\n' "$workflow_path"
        printf 'branch: %s\n' "$INSTALL_BRANCH"
        printf 'commit: %s\n' "$INSTALL_COMMIT_SHA"
    else
        printf '\npreview only: no repository changes made\n'
        printf 'install with: px create %s %s %s %s --install\n' \
            "$alias" "$template" "$slug" "$trigger"
    fi
}

audit_rooms_for() {
    local repo="$1"
    local base="$2"
    local rooms='[]'
    local repo_key team responsibility branch
    local base_encoded branch_encoded compare_json item
    local relation ahead behind state head updated_at

    [[ -f "$ROOMS_REGISTRY" ]] || {
        printf '[]\n'
        return 0
    }

    base_encoded="$(jq -rn --arg value "$base" '$value | @uri')"

    while IFS=$'\t' read -r repo_key team responsibility branch; do
        [[ -z "$repo_key" || "$repo_key" == \#* ]] && continue
        [[ "$repo_key" == "$repo" ]] || continue

        branch_encoded="$(jq -rn --arg value "$branch" '$value | @uri')"

        if compare_json="$(gh api "repos/$repo/compare/${base_encoded}...${branch_encoded}" </dev/null 2>/dev/null)"; then
            relation="$(jq -r '.status // "unknown"' <<<"$compare_json")"
            ahead="$(jq -r '.ahead_by // 0' <<<"$compare_json")"
            behind="$(jq -r '.behind_by // 0' <<<"$compare_json")"

            if (( ahead == 0 && behind == 0 )); then
                state="AT_MAIN"
            elif (( ahead == 0 && behind > 0 )); then
                state="IN_MAIN"
            elif (( ahead > 0 && behind == 0 )); then
                state="AHEAD"
            else
                state="DIVERGED"
            fi

            if (( ahead > 0 )); then
                head="$(jq -r '.commits[-1].sha // ""' <<<"$compare_json")"
                updated_at="$(jq -r '.commits[-1].commit.committer.date // ""' <<<"$compare_json")"
            else
                head="$(jq -r '.merge_base_commit.sha // ""' <<<"$compare_json")"
                updated_at="$(jq -r '.merge_base_commit.commit.committer.date // ""' <<<"$compare_json")"
            fi

            item="$(jq -n \
                --arg team "$team" \
                --arg responsibility "$responsibility" \
                --arg branch "$branch" \
                --arg state "$state" \
                --arg relation "$relation" \
                --arg head "$head" \
                --arg updated_at "$updated_at" \
                --argjson ahead "$ahead" \
                --argjson behind "$behind" \
                '{
                    team: $team,
                    responsibility: $responsibility,
                    branch: $branch,
                    exists: true,
                    state: $state,
                    relation: $relation,
                    ahead: $ahead,
                    behind: $behind,
                    head: (if $head == "" then null else $head end),
                    updated_at: (if $updated_at == "" then null else $updated_at end)
                }')"
        else
            item="$(jq -n \
                --arg team "$team" \
                --arg responsibility "$responsibility" \
                --arg branch "$branch" \
                '{
                    team: $team,
                    responsibility: $responsibility,
                    branch: $branch,
                    exists: false,
                    state: "MISSING",
                    relation: null,
                    ahead: null,
                    behind: null,
                    head: null,
                    updated_at: null
                }')"
        fi

        rooms="$(jq --argjson item "$item" '. + [$item]' <<<"$rooms")"
    done < "$ROOMS_REGISTRY"

    printf '%s\n' "$rooms"
}

audit_repo() {
    local key="${1:-}"
    local repo repo_json workflows_json runs_json rooms_json base

    [[ -n "$key" ]] || die "usage: px audit <repo>"

    need gh
    need jq

    repo="$(repo_for "$key")"
    repo_json="$(gh repo view "$repo" --json nameWithOwner,defaultBranchRef,isPrivate,isArchived,url)"
    base="$(jq -r '.defaultBranchRef.name // ""' <<<"$repo_json")"
    workflows_json="$(workflows_for "$repo")"
    runs_json="$(gh run list -R "$repo" --limit "$LIMIT" \
        --json databaseId,workflowName,status,conclusion,headBranch,createdAt)"
    rooms_json="$(audit_rooms_for "$repo" "$base")"

    jq -n \
        --arg requested "$key" \
        --argjson repo "$repo_json" \
        --argjson workflows "$workflows_json" \
        --argjson runs "$runs_json" \
        --argjson rooms "$rooms_json" \
        '{
            requested: $requested,
            repository: $repo.nameWithOwner,
            default_branch: ($repo.defaultBranchRef.name // null),
            private: $repo.isPrivate,
            archived: $repo.isArchived,
            url: $repo.url,
            status: (
                if $repo.isArchived then "ARCHIVED"
                elif ($workflows | length) == 0 then "NO_WORKFLOWS"
                elif ($runs | length) == 0 then "NO_RUNS"
                elif (($runs[0].status // "") | ascii_downcase) != "completed" then "RUNNING"
                elif (($runs[0].conclusion // "") | ascii_downcase) == "success" then "PASS"
                else "ATTENTION"
                end
            ),
            workflows: {
                count: ($workflows | length),
                active: ([$workflows[] | select((.state // "") == "active")] | length),
                items: $workflows
            },
            runs: {
                count: ($runs | length),
                latest: (
                    if ($runs | length) == 0 then null
                    else {
                        id: $runs[0].databaseId,
                        workflow: $runs[0].workflowName,
                        status: $runs[0].status,
                        conclusion: $runs[0].conclusion,
                        branch: $runs[0].headBranch,
                        created_at: $runs[0].createdAt
                    }
                    end
                )
            },
            rooms: {
                base: ($repo.defaultBranchRef.name // null),
                count: ($rooms | length),
                items: $rooms
            }
        }'
}

templates() {
    cat <<'EOF'
[
  {
    "id": "smoke",
    "summary": "Checkout the repo and prove a GitHub runner can execute the workflow.",
    "mutates_repository": false
  },
  {
    "id": "shell-check",
    "summary": "Run bash -n against every .sh file in the repository.",
    "mutates_repository": false
  }
]
EOF
}

usage() {
    cat <<'EOF'
Post-Apollo PX control bus

Usage:
  px repos
  px doctor
  px workflows <repo>
  px runs <repo> [limit]
  px inspect <repo> <run-id>
  px logs <repo> <run-id>
  px run <repo> <workflow> [ref]
  px watch <repo> <run-id>
  px rerun <repo> <run-id>
  px cancel <repo> <run-id>
  px audit <repo>
  px templates
  px create <repo> <template> <slug> [trigger] [--preview|--install] [--json]

Workflow factory:
  trigger: manual | push | manual+push
  mode:    --preview (default) | --install
  output:  human (default) | --json

Examples:
  px workflows dev
  px inspect dev 123456789
  px logs dev 123456789
  px run dev px-smoke.yml
  px audit taskbars
  px templates
  px create dev smoke my-first-action
  px create dev shell-check shell-syntax manual --preview
  px create dev shell-check shell-syntax manual --preview --json
  px create dev shell-check shell-syntax manual --install

Repo identities may be aliases from config/repos.tsv or explicit owner/name slugs.
PX create previews by default. --install writes the validated workflow directly
to the repository default branch. The Git commit remains the rollback point; no
browser or pull-request step is required for normal desktop use.
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    repos)
        printf '%-12s %s\n' ALIAS REPOSITORY
        while IFS=$'\t' read -r alias repo; do
            [[ -z "$alias" || "$alias" == \#* ]] && continue
            printf '%-12s %s\n' "$alias" "$repo"
        done < "$REGISTRY"
        ;;

    doctor)
        need gh
        need awk
        printf 'registry: %s\n' "$REGISTRY"
        gh auth status
        ;;

    workflows)
        need gh
        repo="$(repo_for "${1:-}")"
        workflows_for "$repo"
        ;;

    runs)
        need gh
        repo="$(repo_for "${1:-}")"
        limit="${2:-$LIMIT}"
        gh run list -R "$repo" --limit "$limit" \
            --json databaseId,workflowName,status,conclusion,headBranch,createdAt
        ;;

    inspect)
        need gh
        repo="$(repo_for "${1:-}")"
        run_id="${2:-}"
        [[ -n "$run_id" ]] || die "run id required"
        gh run view "$run_id" -R "$repo" \
            --json databaseId,workflowName,status,conclusion,headBranch,headSha,event,createdAt,startedAt,updatedAt,url,jobs
        ;;

    logs)
        need gh
        repo="$(repo_for "${1:-}")"
        run_id="${2:-}"
        [[ -n "$run_id" ]] || die "run id required"
        gh run view "$run_id" -R "$repo" --log
        ;;

    run)
        need gh
        repo="$(repo_for "${1:-}")"
        workflow="${2:-}"
        ref="${3:-}"
        [[ -n "$workflow" ]] || die "workflow required"

        if [[ -n "$ref" ]]; then
            gh workflow run "$workflow" -R "$repo" --ref "$ref"
        else
            gh workflow run "$workflow" -R "$repo"
        fi
        ;;

    watch)
        need gh
        repo="$(repo_for "${1:-}")"
        run_id="${2:-}"
        [[ -n "$run_id" ]] || die "run id required"
        gh run watch "$run_id" -R "$repo" --exit-status
        ;;

    rerun)
        need gh
        repo="$(repo_for "${1:-}")"
        run_id="${2:-}"
        [[ -n "$run_id" ]] || die "run id required"
        gh run rerun "$run_id" -R "$repo"
        ;;

    cancel)
        need gh
        repo="$(repo_for "${1:-}")"
        run_id="${2:-}"
        [[ -n "$run_id" ]] || die "run id required"
        gh run cancel "$run_id" -R "$repo"
        ;;

    audit)
        audit_repo "$@"
        ;;

    templates)
        templates
        ;;

    create)
        create_workflow "$@"
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        usage >&2
        die "unknown command: $cmd"
        ;;
esac
