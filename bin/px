#!/usr/bin/env bash
set -euo pipefail

PX_SOURCE="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$PX_SOURCE")/.." && pwd)"
REGISTRY="${PX_REPO_REGISTRY:-$ROOT/config/repos.tsv}"
ACTIONS_REGISTRY="${PX_ACTION_REGISTRY:-$ROOT/config/actions.json}"
ROOMS_REGISTRY="${PX_ROOMS_REGISTRY:-$ROOT/config/audit-rooms.tsv}"
LIMIT="${PX_RUN_LIMIT:-10}"
TOOLBOX_NAME="${PX_TOOLBOX:-fedora-toolbox-44}"

VALIDATION_STATUS="unknown"
VALIDATION_VALIDATOR=""
VALIDATION_MESSAGE=""
INSTALL_BRANCH=""
INSTALL_PR_URL=""
INSTALL_COMMIT_SHA=""

die() {
    printf 'px: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'px: warning: %s\n' "$*" >&2
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

repo_for() {
    local key="${1:-}"
    [[ -n "$key" ]] || die "repo identity required"

    if [[ "$key" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]]; then
        printf '%s\n' "$key"
        return 0
    fi

    awk -F '\t' -v key="$key" '$1 == key { print $2; found=1; exit } END { if (!found) exit 1 }' "$REGISTRY" \
        || die "unknown repo alias: $key"
}

default_branch_for() {
    local repo="$1"
    gh repo view "$repo" --json defaultBranchRef --jq '.defaultBranchRef.name'
}

workflows_for() {
    local repo="$1"
    local output="" error="" status=0 tmp

    tmp="$(mktemp)"
    if output="$(gh workflow list -R "$repo" --json id,name,path,state 2>"$tmp")"; then
        rm -f "$tmp"
        if [[ -z "${output//[[:space:]]/}" ]]; then
            printf '[]\n'
        else
            printf '%s\n' "$output"
        fi
        return 0
    else
        status=$?
    fi

    error="$(cat "$tmp")"
    rm -f "$tmp"

    case "${error,,}" in
        *"no workflows found"*)
            printf '[]\n'
            return 0
            ;;
    esac

    [[ -n "$output" ]] && printf '%s\n' "$output"
    [[ -n "$error" ]] && printf '%s\n' "$error" >&2
    return "$status"
}

branches_for() {
    local repo="$1"
    local default_branch rows

    need jq
    default_branch="$(default_branch_for "$repo")"
    rows="$(
        gh api --paginate "repos/$repo/branches?per_page=100" \
            --jq '.[] | [.name, .commit.sha, ((.protected // false) | tostring)] | @tsv'
    )"

    jq -Rn \
        --arg repository "$repo" \
        --arg default_branch "$default_branch" \
        --arg rows "$rows" '
        {
            version: 1,
            repository: $repository,
            defaultBranch: $default_branch,
            branches: (
                $rows
                | split("\n")
                | map(select(length > 0))
                | map(
                    split("\t")
                    | {
                        name: .[0],
                        head: .[1],
                        protected: (.[2] == "true"),
                        default: (.[0] == $default_branch),
                        source: "github"
                    }
                )
            )
        }
    '
}

commits_for() {
    local repo="$1"
    local ref="${2:-}"
    local limit="${3:-20}"
    local endpoint="repos/$repo/commits?per_page=$limit"

    need jq

    if [[ -n "$ref" ]]; then
        endpoint+="&sha=$(jq -rn --arg value "$ref" '$value | @uri')"
    fi

    gh api "$endpoint" --jq '
        [
            .[]
            | {
                sha: .sha,
                message: ((.commit.message // "") | split("\n")[0]),
                author: (.commit.author.name // ""),
                date: (.commit.author.date // "")
            }
        ]
    '
}


github_run_guard_record() {
    local repo="$1"
    local run_id="$2"

    gh run view "$run_id" -R "$repo" \
        --json attempt,databaseId,workflowName,status,conclusion,headBranch,headSha,event,createdAt,startedAt,updatedAt,url
}


github_workflow_guard_record() {
    local repo="$1"
    local workflow_query="$2"
    local rows matches count

    rows="$(workflows_for "$repo")"
    matches="$(jq -c --arg query "$workflow_query" '
        [
            .[]
            | select(
                (.path // "") == $query
                or ((.id // "") | tostring) == $query
                or (.name // "") == $query
            )
        ]
    ' <<<"$rows")"
    count="$(jq 'length' <<<"$matches")"

    [[ "$count" -gt 0 ]] || die "workflow not found: $workflow_query"
    [[ "$count" -eq 1 ]] || die "workflow selector is ambiguous: $workflow_query"

    jq -c '.[0]' <<<"$matches"
}

github_ref_sha() {
    local repo="$1"
    local ref="$2"
    local encoded

    encoded="$(jq -rn --arg value "$ref" '$value | @uri')"
    gh api "repos/$repo/commits/$encoded" --jq '.sha'
}

github_workflow_blob_sha() {
    local repo="$1"
    local workflow_path="$2"
    local ref="$3"
    local encoded_ref

    encoded_ref="$(jq -rn --arg value "$ref" '$value | @uri')"
    gh api "repos/$repo/contents/$workflow_path?ref=$encoded_ref" --jq '.sha'
}

github_remote_file_sha256() {
    local repo="$1"
    local path="$2"
    local ref="$3"
    local encoded_ref metadata encoding content

    need base64
    need sha256sum
    need awk

    encoded_ref="$(jq -rn --arg value "$ref" '$value | @uri')"
    metadata="$(gh api "repos/$repo/contents/$path?ref=$encoded_ref")"
    encoding="$(jq -r '.encoding // ""' <<<"$metadata")"
    content="$(jq -r '.content // ""' <<<"$metadata" | tr -d '\n')"

    [[ "$encoding" == "base64" ]]         || die "remote workflow content encoding is not base64"
    [[ -n "$content" ]]         || die "remote workflow content is empty"

    printf '%s' "$content"         | base64 --decode         | sha256sum         | awk '{print $1}'
}

github_dispatch_runs_for() {
    local repo="$1"
    local workflow_path="$2"
    local ref_sha="$3"

    gh run list -R "$repo" \
        --workflow "$workflow_path" \
        --event workflow_dispatch \
        --commit "$ref_sha" \
        --limit 50 \
        --json attempt,databaseId,workflowName,status,conclusion,headBranch,headSha,event,createdAt,url
}

hospital_session_guard_record() {
    local session_id="$1"

    need python3
    python3 "$ROOT/bin/px-hospital-store" session "$session_id" --json
}

hospital_session_guard_events() {
    local session_id="$1"

    need python3
    python3 "$ROOT/bin/px-hospital-store" events "$session_id" --limit 1000 --json
}

recovery_refuse() {
    local as_json="$1"
    local operation_id="$2"
    local reason="$3"

    if [[ "$as_json" == "true" ]]; then
        jq -n \
            --arg operationId "$operation_id" \
            --arg reason "$reason" \
            '{
                recovered:false,
                operationId:$operationId,
                reason:$reason
            }'
    else
        printf 'RECOVERY REFUSED // %s\n' "$reason" >&2
    fi

    return 1
}

execute_operation_recovery() {
    local operation_id="${1:-}"
    shift || true

    local as_json="false"
    local arg
    for arg in "$@"; do
        case "$arg" in
            --json) as_json="true" ;;
            *) die "unknown operation recover option: $arg" ;;
        esac
    done

    [[ -n "$operation_id" ]] || die "operation id required for recovery"

    need python3
    need jq
    need gh
    need base64
    need sha256sum
    need awk

    local facts strategy plan_available executor_available
    local repo base workflow_path install_commit recorded_blob
    local verified_base_sha expected_yaml_sha recorded_yaml_sha
    local encoded_base metadata current_blob current_yaml_sha current_head
    local verified_history install_history
    local recovery_command arguments_json before_json recovery_record recovery_id
    local final_metadata final_blob delete_output delete_status=0
    local after_json verification_json after_head head_history delete_commit
    local lookup_tmp lookup_error="" finish_summary

    facts="$(python3 "$ROOT/bin/px-operation-store" recovery "$operation_id" --json)"
    strategy="$(jq -r '.strategy // ""' <<<"$facts")"
    plan_available="$(jq -r '.planAvailable // false' <<<"$facts")"
    executor_available="$(jq -r '.executorAvailable // false' <<<"$facts")"

    if [[ "$strategy" != "DELETE_CREATED_WORKFLOW"
            || "$plan_available" != "true"
            || "$executor_available" != "true" ]]; then
        recovery_refuse "$as_json" "$operation_id" \
            "no executable workflow-creation recovery plan is available"
    fi

    repo="$(jq -r '.plan.repository // ""' <<<"$facts")"
    base="$(jq -r '.plan.base // ""' <<<"$facts")"
    workflow_path="$(jq -r '.plan.path // ""' <<<"$facts")"
    install_commit="$(jq -r '.plan.installCommit // ""' <<<"$facts")"
    recorded_blob="$(jq -r '.plan.remoteBlobSha // ""' <<<"$facts")"
    verified_base_sha="$(jq -r '.plan.verifiedBaseSha // ""' <<<"$facts")"
    expected_yaml_sha="$(jq -r '.plan.expectedYamlSha // ""' <<<"$facts")"

    [[ "$repo" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]] \
        || recovery_refuse "$as_json" "$operation_id" "recorded repository identity is invalid"
    case "$workflow_path" in
        .github/workflows/*.yml|.github/workflows/*.yaml) ;;
        *) recovery_refuse "$as_json" "$operation_id" "recorded workflow path is invalid" ;;
    esac
    [[ "$workflow_path" != *".."* ]] \
        || recovery_refuse "$as_json" "$operation_id" "recorded workflow path contains parent traversal"
    [[ -n "$base" && -n "$install_commit" && -n "$recorded_blob"
        && -n "$verified_base_sha" && -n "$expected_yaml_sha" ]] \
        || recovery_refuse "$as_json" "$operation_id" "recorded recovery identity is incomplete"

    recorded_yaml_sha="$(jq -j '.plan.yaml // ""' <<<"$facts" | sha256sum | awk '{print $1}')"
    [[ "$recorded_yaml_sha" == "$expected_yaml_sha" ]] \
        || recovery_refuse "$as_json" "$operation_id" "recorded YAML no longer matches its verified hash"

    encoded_base="$(jq -rn --arg value "$base" '$value | @uri')"
    lookup_tmp="$(mktemp)"
    if metadata="$(gh api "repos/$repo/contents/$workflow_path?ref=$encoded_base" 2>"$lookup_tmp")"; then
        :
    else
        lookup_error="$(cat "$lookup_tmp")"
        rm -f "$lookup_tmp"
        recovery_refuse "$as_json" "$operation_id" \
            "recorded workflow target is unavailable; it may already be absent or repository state changed // ${lookup_error:-unknown GitHub error}"
    fi
    rm -f "$lookup_tmp"

    [[ "$(jq -r '.type // ""' <<<"$metadata")" == "file" ]] \
        || recovery_refuse "$as_json" "$operation_id" "recorded workflow target is no longer a file"

    current_blob="$(jq -r '.sha // ""' <<<"$metadata")"
    [[ "$current_blob" == "$recorded_blob" ]] \
        || recovery_refuse "$as_json" "$operation_id" \
            "workflow content changed after the recorded creation // expected blob $recorded_blob // current $current_blob"

    current_yaml_sha="$(github_remote_file_sha256 "$repo" "$workflow_path" "$base")"
    [[ "$current_yaml_sha" == "$expected_yaml_sha" ]] \
        || recovery_refuse "$as_json" "$operation_id" \
            "workflow bytes changed after the recorded creation // expected $expected_yaml_sha // current $current_yaml_sha"

    current_head="$(github_ref_sha "$repo" "$base")"
    [[ -n "$current_head" ]] \
        || recovery_refuse "$as_json" "$operation_id" "recorded base branch has no current head"

    verified_history="$(gh api "repos/$repo/compare/$verified_base_sha...$current_head" --jq '.status')" \
        || recovery_refuse "$as_json" "$operation_id" "could not validate verified base ancestry"
    case "$verified_history" in
        identical|ahead) ;;
        *) recovery_refuse "$as_json" "$operation_id" \
            "base history diverged after verification // status $verified_history" ;;
    esac

    install_history="$(gh api "repos/$repo/compare/$install_commit...$current_head" --jq '.status')" \
        || recovery_refuse "$as_json" "$operation_id" "could not validate install commit ancestry"
    case "$install_history" in
        identical|ahead) ;;
        *) recovery_refuse "$as_json" "$operation_id" \
            "install commit is no longer in the base history // status $install_history" ;;
    esac

    recovery_command="$(jq -nc \
        --arg repo "$repo" \
        --arg path "$workflow_path" \
        --arg base "$base" \
        --arg blob "$recorded_blob" \
        '["delete-workflow",$repo,$path,$base,"--expect-sha",$blob,"--json"]')"

    arguments_json="$(jq -nc \
        --arg sourceOperationId "$operation_id" \
        --arg repository "$repo" \
        --arg base "$base" \
        --arg path "$workflow_path" \
        --arg blobSha "$recorded_blob" \
        '{
            sourceOperationId:$sourceOperationId,
            repository:$repository,
            base:$base,
            path:$path,
            blobSha:$blobSha
        }')"

    before_json="$(jq -nc \
        --arg sourceOperationId "$operation_id" \
        --arg strategy "$strategy" \
        --arg currentHead "$current_head" \
        --arg currentBlobSha "$current_blob" \
        --arg currentYamlSha "$current_yaml_sha" \
        --arg verifiedHistory "$verified_history" \
        --arg installHistory "$install_history" \
        --argjson plan "$(jq -c '.plan' <<<"$facts")" \
        '{
            sourceOperationId:$sourceOperationId,
            strategy:$strategy,
            plan:$plan,
            live:{
                head:$currentHead,
                blobSha:$currentBlobSha,
                yamlSha:$currentYamlSha,
                verifiedHistory:$verifiedHistory,
                installHistory:$installHistory
            }
        }')"

    recovery_record="$(python3 "$ROOT/bin/px-operation-store" start \
        --action-id "px.operation.recover.workflow.create" \
        --owner-pid "$BASHPID" \
        --title "Recover Workflow Creation" \
        --mutation remote \
        --recovery EVIDENCE_ONLY \
        --command-json "$recovery_command" \
        --arguments-json "$arguments_json" \
        --before-json "$before_json" \
        --json)"
    recovery_id="$(jq -r '.id // ""' <<<"$recovery_record")"
    [[ -n "$recovery_id" ]] || die "recovery journal returned no operation id"

    if final_metadata="$(gh api "repos/$repo/contents/$workflow_path?ref=$encoded_base" 2>/dev/null)"; then
        final_blob="$(jq -r '.sha // ""' <<<"$final_metadata")"
    else
        final_blob=""
    fi

    if [[ "$final_blob" != "$recorded_blob" ]]; then
        after_json="$(jq -nc \
            --arg refusal "STALE_TARGET" \
            --arg expectedBlob "$recorded_blob" \
            --arg currentBlob "$final_blob" \
            '{refusal:$refusal,expectedBlob:$expectedBlob,currentBlob:$currentBlob}')"
        python3 "$ROOT/bin/px-operation-store" finish "$recovery_id" \
            --status FAILED \
            --exit-code 1 \
            --verification-status NOT_RUN \
            --after-json "$after_json" \
            --verification-json '{}' \
            --result-summary "recovery refused because workflow identity changed after journal start" \
            --json >/dev/null
        recovery_refuse "$as_json" "$operation_id" \
            "workflow identity changed immediately before recovery execution"
    fi

    lookup_tmp="$(mktemp)"
    if delete_output="$("$ROOT/bin/px" delete-workflow \
        "$repo" "$workflow_path" "$base" \
        --expect-sha "$recorded_blob" --json 2>"$lookup_tmp")"; then
        delete_status=0
    else
        delete_status=$?
        lookup_error="$(cat "$lookup_tmp")"
        rm -f "$lookup_tmp"
        after_json="$(jq -nc \
            --arg stdout "$delete_output" \
            --arg stderr "$lookup_error" \
            '{stdout:$stdout,stderr:$stderr}')"
        python3 "$ROOT/bin/px-operation-store" finish "$recovery_id" \
            --status FAILED \
            --exit-code "$delete_status" \
            --verification-status NOT_RUN \
            --after-json "$after_json" \
            --verification-json '{}' \
            --result-summary "workflow creation recovery execution failed" \
            --json >/dev/null
        recovery_refuse "$as_json" "$operation_id" \
            "workflow deletion failed // ${lookup_error:-unknown error}"
    fi
    rm -f "$lookup_tmp"

    delete_commit="$(jq -r '.commit // ""' <<<"$delete_output")"
    after_json="$(jq -nc --argjson delete "$delete_output" '{delete:$delete}')"

    lookup_tmp="$(mktemp)"
    if gh api "repos/$repo/contents/$workflow_path?ref=$encoded_base" >/dev/null 2>"$lookup_tmp"; then
        lookup_error="workflow still exists after recovery deletion"
        rm -f "$lookup_tmp"
        verification_json="$(jq -nc \
            --arg reason "$lookup_error" \
            --arg previousHead "$current_head" \
            '{passed:false,reason:$reason,previousHead:$previousHead}')"
        python3 "$ROOT/bin/px-operation-store" finish "$recovery_id" \
            --status COMPLETE --exit-code 0 \
            --verification-status FAILED \
            --after-json "$after_json" \
            --verification-json "$verification_json" \
            --result-summary "$lookup_error" \
            --json >/dev/null
        recovery_refuse "$as_json" "$operation_id" "$lookup_error"
    else
        lookup_error="$(cat "$lookup_tmp")"
    fi
    rm -f "$lookup_tmp"

    if ! grep -qiE '404|not found' <<<"$lookup_error"; then
        verification_json="$(jq -nc \
            --arg reason "${lookup_error:-workflow absence could not be verified}" \
            --arg previousHead "$current_head" \
            '{passed:false,reason:$reason,previousHead:$previousHead}')"
        python3 "$ROOT/bin/px-operation-store" finish "$recovery_id" \
            --status COMPLETE --exit-code 0 \
            --verification-status UNAVAILABLE \
            --after-json "$after_json" \
            --verification-json "$verification_json" \
            --result-summary "workflow deletion succeeded but absence could not be verified" \
            --json >/dev/null
        recovery_refuse "$as_json" "$operation_id" \
            "workflow deletion succeeded but absence could not be verified"
    fi

    after_head="$(github_ref_sha "$repo" "$base")"
    [[ -n "$after_head" ]] || die "recovery verification could not resolve the base head"

    head_history="$(gh api "repos/$repo/compare/$current_head...$after_head" --jq '.status')" \
        || die "recovery verification could not compare branch heads"

    if [[ "$after_head" == "$current_head" || "$head_history" != "ahead" ]]; then
        verification_json="$(jq -nc \
            --arg reason "base branch did not advance through the recovery deletion" \
            --arg previousHead "$current_head" \
            --arg currentHead "$after_head" \
            --arg history "$head_history" \
            '{passed:false,reason:$reason,previousHead:$previousHead,currentHead:$currentHead,history:$history}')"
        python3 "$ROOT/bin/px-operation-store" finish "$recovery_id" \
            --status COMPLETE --exit-code 0 \
            --verification-status FAILED \
            --after-json "$after_json" \
            --verification-json "$verification_json" \
            --result-summary "workflow recovery deletion could not be tied to an advancing branch" \
            --json >/dev/null
        recovery_refuse "$as_json" "$operation_id" \
            "workflow was deleted but branch advancement could not be verified"
    fi

    if [[ -n "$delete_commit" ]]; then
        install_history="$(gh api "repos/$repo/compare/$delete_commit...$after_head" --jq '.status')" \
            || die "recovery verification could not validate delete commit ancestry"
        case "$install_history" in
            identical|ahead) ;;
            *)
                verification_json="$(jq -nc \
                    --arg reason "delete commit is not in the current base history" \
                    --arg deleteCommit "$delete_commit" \
                    --arg currentHead "$after_head" \
                    --arg history "$install_history" \
                    '{passed:false,reason:$reason,deleteCommit:$deleteCommit,currentHead:$currentHead,history:$history}')"
                python3 "$ROOT/bin/px-operation-store" finish "$recovery_id" \
                    --status COMPLETE --exit-code 0 \
                    --verification-status FAILED \
                    --after-json "$after_json" \
                    --verification-json "$verification_json" \
                    --result-summary "workflow recovery delete commit was not retained in base history" \
                    --json >/dev/null
                recovery_refuse "$as_json" "$operation_id" \
                    "delete commit is not in the current base history"
                ;;
        esac
    fi

    verification_json="$(jq -nc \
        --argjson passed true \
        --arg repository "$repo" \
        --arg base "$base" \
        --arg path "$workflow_path" \
        --arg previousHead "$current_head" \
        --arg currentHead "$after_head" \
        --arg deleteCommit "$delete_commit" \
        --arg history "$head_history" \
        '{
            passed:$passed,
            repository:$repository,
            base:$base,
            path:$path,
            fileAbsent:true,
            previousHead:$previousHead,
            currentHead:$currentHead,
            deleteCommit:(if $deleteCommit == "" then null else $deleteCommit end),
            history:$history
        }')"

    finish_summary="workflow creation recovery executed and verified"
    python3 "$ROOT/bin/px-operation-store" finish "$recovery_id" \
        --status COMPLETE --exit-code 0 \
        --verification-status PASSED \
        --after-json "$after_json" \
        --verification-json "$verification_json" \
        --result-summary "$finish_summary" \
        --json >/dev/null

    if [[ "$as_json" == "true" ]]; then
        jq -n \
            --arg operationId "$operation_id" \
            --arg recoveryOperationId "$recovery_id" \
            --arg strategy "$strategy" \
            --arg repository "$repo" \
            --arg base "$base" \
            --arg path "$workflow_path" \
            --arg deleteCommit "$delete_commit" \
            --arg previousHead "$current_head" \
            --arg currentHead "$after_head" \
            '{
                recovered:true,
                operationId:$operationId,
                recoveryOperationId:$recoveryOperationId,
                strategy:$strategy,
                repository:$repository,
                base:$base,
                path:$path,
                deleteCommit:(if $deleteCommit == "" then null else $deleteCommit end),
                previousHead:$previousHead,
                currentHead:$currentHead,
                verification:"PASSED"
            }'
    else
        printf 'RECOVERY VERIFIED // %s // %s@%s\n' \
            "$workflow_path" "$base" "${after_head:0:8}"
    fi
}

mutation_preflight() {
    local action_id="${1:-}"
    local arguments_json="${2:-}"

    [[ -n "$action_id" ]] || die "mutation action id required"
    [[ -n "$arguments_json" ]] || die "mutation arguments JSON required"

    need jq

    case "$action_id" in
        px.operation.recover.execute)
            local operation_id facts strategy plan_available executor_available live_validation
            local source_action source_status recovery_class reason allowed="true"
            local plan_repo plan_base plan_path plan_blob plan_yaml_sha plan_install plan_verified
            local token summary frozen_command

            operation_id="$(jq -r '.operation_id // ""' <<<"$arguments_json")"
            [[ -n "$operation_id" ]] || die "px.operation.recover.execute preflight requires operation_id"

            facts="$(python3 "$ROOT/bin/px-operation-store" recovery "$operation_id" --json)"
            strategy="$(jq -r '.strategy // ""' <<<"$facts")"
            plan_available="$(jq -r '.planAvailable // false' <<<"$facts")"
            executor_available="$(jq -r '.executorAvailable // false' <<<"$facts")"
            live_validation="$(jq -r '.requiresLiveValidation // false' <<<"$facts")"
            source_action="$(jq -r '.actionId // ""' <<<"$facts")"
            source_status="$(jq -r '.status // ""' <<<"$facts")"
            recovery_class="$(jq -r '.recovery // ""' <<<"$facts")"
            reason="$(jq -r '.reason // ""' <<<"$facts")"

            if [[ "$strategy" != "DELETE_CREATED_WORKFLOW"
                    || "$plan_available" != "true"
                    || "$executor_available" != "true" ]]; then
                allowed="false"
                [[ -n "$reason" ]] || reason="NO EXECUTABLE RECOVERY PLAN"
            fi

            plan_repo="$(jq -r '.plan.repository // ""' <<<"$facts")"
            plan_base="$(jq -r '.plan.base // ""' <<<"$facts")"
            plan_path="$(jq -r '.plan.path // ""' <<<"$facts")"
            plan_blob="$(jq -r '.plan.remoteBlobSha // ""' <<<"$facts")"
            plan_yaml_sha="$(jq -r '.plan.expectedYamlSha // ""' <<<"$facts")"
            plan_install="$(jq -r '.plan.installCommit // ""' <<<"$facts")"
            plan_verified="$(jq -r '.plan.verifiedBaseSha // ""' <<<"$facts")"

            if [[ "$allowed" == "true" ]]; then
                if [[ -z "$plan_repo" || -z "$plan_base" || -z "$plan_path"
                        || -z "$plan_blob" || -z "$plan_yaml_sha"
                        || -z "$plan_install" || -z "$plan_verified" ]]; then
                    allowed="false"
                    reason="RECOVERY PLAN IDENTITY IS INCOMPLETE"
                fi
            fi

            token="$(jq -nc \
                --arg operationId "$operation_id" \
                --arg actionId "$source_action" \
                --arg status "$source_status" \
                --arg recovery "$recovery_class" \
                --arg strategy "$strategy" \
                --arg repository "$plan_repo" \
                --arg base "$plan_base" \
                --arg path "$plan_path" \
                --arg blobSha "$plan_blob" \
                --arg yamlSha "$plan_yaml_sha" \
                --arg installCommit "$plan_install" \
                --arg verifiedBaseSha "$plan_verified" \
                --argjson requiresLiveValidation "$live_validation" \
                '{
                    operationId:$operationId,
                    actionId:$actionId,
                    status:$status,
                    recovery:$recovery,
                    strategy:$strategy,
                    repository:$repository,
                    base:$base,
                    path:$path,
                    blobSha:$blobSha,
                    yamlSha:$yamlSha,
                    installCommit:$installCommit,
                    verifiedBaseSha:$verifiedBaseSha,
                    requiresLiveValidation:$requiresLiveValidation
                }')"

            frozen_command="$(jq -nc \
                --arg operationId "$operation_id" \
                '["operation","recover",$operationId,"--json"]')"

            if [[ -n "$plan_path" ]]; then
                summary="RECOVER // $strategy // $plan_repo // $plan_path // $plan_base // BLOB ${plan_blob:0:12}"
            else
                summary="RECOVER // $operation_id // ${strategy:-NO STRATEGY}"
            fi

            jq -n \
                --arg actionId "$action_id" \
                --argjson allowed "$allowed" \
                --arg summary "$summary" \
                --arg reason "$reason" \
                --arg token "$token" \
                --argjson frozenCommand "$frozen_command" \
                --argjson target "$facts" \
                '{
                    version:1,
                    actionId:$actionId,
                    allowed:$allowed,
                    summary:$summary,
                    reason:$reason,
                    token:$token,
                    frozenCommand:$frozenCommand,
                    target:$target
                }'
            ;;
        ai.turn|ai.quick.continue|ai.quick.report|ai.quick.checklist|ai.quick.next)
            local session_id session_json events_json baseline_event_id
            local status active_pid room_id doctor_id provider_id provider_session_id
            local working_directory updated_at prompt quick_command action_label
            local allowed="true" reason="" summary="" token frozen_command

            session_id="$(jq -r '.session_id // ""' <<<"$arguments_json")"
            [[ -n "$session_id" ]] || die "$action_id preflight requires session_id"

            session_json="$(hospital_session_guard_record "$session_id")"
            events_json="$(hospital_session_guard_events "$session_id")"
            baseline_event_id="$(jq -r '[.[] | ((.id // 0) | tonumber? // 0)] | max // 0' <<<"$events_json")"

            status="$(jq -r '.status // "IDLE"' <<<"$session_json")"
            active_pid="$(jq -r '.activePid // 0' <<<"$session_json")"
            room_id="$(jq -r '.roomId // ""' <<<"$session_json")"
            doctor_id="$(jq -r '.doctorId // ""' <<<"$session_json")"
            provider_id="$(jq -r '.providerId // ""' <<<"$session_json")"
            provider_session_id="$(jq -r '.providerSessionId // ""' <<<"$session_json")"
            working_directory="$(jq -r '.workingDirectory // ""' <<<"$session_json")"
            updated_at="$(jq -r '.updatedAt // ""' <<<"$session_json")"

            if [[ "${status^^}" == "OPERATING" || "$active_pid" -gt 0 ]]; then
                allowed="false"
                reason="DOCTOR ALREADY OPERATING"
            elif [[ -z "$room_id" ]]; then
                allowed="false"
                reason="SESSION HAS NO ROOM"
            elif [[ -z "$doctor_id" ]]; then
                allowed="false"
                reason="SESSION HAS NO DOCTOR"
            elif [[ -z "$provider_id" ]]; then
                allowed="false"
                reason="SESSION HAS NO PROVIDER"
            elif [[ -z "$working_directory" ]]; then
                allowed="false"
                reason="SESSION HAS NO WORKING DIRECTORY"
            fi

            case "$action_id" in
                ai.turn)
                    prompt="$(jq -r '.prompt // ""' <<<"$arguments_json")"
                    [[ -n "${prompt//[[:space:]]/}" ]] || die "ai.turn preflight requires prompt"
                    action_label="MESSAGE DOCTOR"
                    frozen_command="$(jq -nc \
                        --arg session "$session_id" \
                        --arg prompt "$prompt" \
                        '["agent","turn",$session,"--prompt",$prompt,"--json"]')"
                    ;;
                ai.quick.continue)
                    quick_command="CONTINUE"
                    action_label="QUICK CONTINUE"
                    ;;
                ai.quick.report)
                    quick_command="REPORT"
                    action_label="QUICK REPORT"
                    ;;
                ai.quick.checklist)
                    quick_command="CHECKLIST"
                    action_label="QUICK CHECKLIST"
                    ;;
                ai.quick.next)
                    quick_command="NEXT"
                    action_label="QUICK NEXT"
                    ;;
            esac

            if [[ "$action_id" != "ai.turn" ]]; then
                frozen_command="$(jq -nc \
                    --arg session "$session_id" \
                    --arg command "$quick_command" \
                    '["agent","quick",$session,$command,"--json"]')"
            fi

            token="$(jq -nc \
                --arg actionId "$action_id" \
                --arg sessionId "$session_id" \
                --arg roomId "$room_id" \
                --arg doctorId "$doctor_id" \
                --arg providerId "$provider_id" \
                --arg providerSessionId "$provider_session_id" \
                --arg workingDirectory "$working_directory" \
                --arg status "$status" \
                --arg updatedAt "$updated_at" \
                --argjson activePid "$active_pid" \
                --argjson baselineEventId "$baseline_event_id" \
                '{
                    actionId:$actionId,
                    sessionId:$sessionId,
                    roomId:$roomId,
                    doctorId:$doctorId,
                    providerId:$providerId,
                    providerSessionId:$providerSessionId,
                    workingDirectory:$workingDirectory,
                    status:$status,
                    activePid:$activePid,
                    updatedAt:$updatedAt,
                    baselineEventId:$baselineEventId
                }')"

            summary="$action_label // ROOM $room_id // DOCTOR $doctor_id // PROVIDER $provider_id // SESSION $session_id"

            jq -n \
                --arg actionId "$action_id" \
                --argjson allowed "$allowed" \
                --arg summary "$summary" \
                --arg reason "$reason" \
                --arg token "$token" \
                --argjson frozenCommand "$frozen_command" \
                --argjson target "$session_json" \
                '{
                    version:1,
                    actionId:$actionId,
                    allowed:$allowed,
                    summary:$summary,
                    reason:$reason,
                    token:$token,
                    frozenCommand:$frozenCommand,
                    target:$target
                }'
            ;;
        github.run.cancel)
            need gh

            local repository_key repo run_id run_json actual_id
            local workflow status conclusion head_branch head_sha token
            local allowed="true" reason="" summary=""

            repository_key="$(jq -r '.repository // ""' <<<"$arguments_json")"
            run_id="$(jq -r '.run_id // ""' <<<"$arguments_json")"

            [[ -n "$repository_key" ]] || die "github.run.cancel preflight requires repository"
            [[ -n "$run_id" ]] || die "github.run.cancel preflight requires run_id"

            repo="$(repo_for "$repository_key")"
            run_json="$(github_run_guard_record "$repo" "$run_id")"

            actual_id="$(jq -r '.databaseId // ""' <<<"$run_json")"
            [[ "$actual_id" == "$run_id" ]] \
                || die "GitHub returned run $actual_id while guarding run $run_id"

            workflow="$(jq -r '.workflowName // "UNKNOWN WORKFLOW"' <<<"$run_json")"
            status="$(jq -r '.status // ""' <<<"$run_json")"
            conclusion="$(jq -r '.conclusion // ""' <<<"$run_json")"
            head_branch="$(jq -r '.headBranch // ""' <<<"$run_json")"
            head_sha="$(jq -r '.headSha // ""' <<<"$run_json")"

            if [[ -z "$status" ]]; then
                allowed="false"
                reason="RUN STATUS IS UNKNOWN"
            elif [[ "${status,,}" == "completed" ]]; then
                allowed="false"
                reason="RUN ALREADY COMPLETED"
                [[ -n "$conclusion" ]] && reason+=" // ${conclusion^^}"
            fi

            token="$(jq -c \
                --arg repository "$repo" \
                --arg runId "$run_id" \
                '{
                    repository:$repository,
                    runId:$runId,
                    workflow:(.workflowName // ""),
                    headSha:(.headSha // ""),
                    attempt:(.attempt // 0)
                }' <<<"$run_json")"

            summary="CANCEL // $workflow // #$run_id // ${status^^}"
            [[ -n "$head_branch" ]] && summary+=" // $head_branch"
            [[ -n "$head_sha" ]] && summary+=" // ${head_sha:0:8}"

            jq -n \
                --arg actionId "$action_id" \
                --argjson allowed "$allowed" \
                --arg summary "$summary" \
                --arg reason "$reason" \
                --arg token "$token" \
                --argjson target "$run_json" \
                '{
                    version:1,
                    actionId:$actionId,
                    allowed:$allowed,
                    summary:$summary,
                    reason:$reason,
                    token:$token,
                    target:$target
                }'
            ;;
        github.run.rerun)
            need gh

            local repository_key repo run_id run_json actual_id
            local workflow status conclusion head_branch head_sha token run_attempt
            local allowed="true" reason="" summary=""

            repository_key="$(jq -r '.repository // ""' <<<"$arguments_json")"
            run_id="$(jq -r '.run_id // ""' <<<"$arguments_json")"

            [[ -n "$repository_key" ]] || die "github.run.rerun preflight requires repository"
            [[ -n "$run_id" ]] || die "github.run.rerun preflight requires run_id"

            repo="$(repo_for "$repository_key")"
            run_json="$(github_run_guard_record "$repo" "$run_id")"

            actual_id="$(jq -r '.databaseId // ""' <<<"$run_json")"
            [[ "$actual_id" == "$run_id" ]] \
                || die "GitHub returned run $actual_id while guarding rerun $run_id"

            workflow="$(jq -r '.workflowName // "UNKNOWN WORKFLOW"' <<<"$run_json")"
            status="$(jq -r '.status // ""' <<<"$run_json")"
            conclusion="$(jq -r '.conclusion // ""' <<<"$run_json")"
            head_branch="$(jq -r '.headBranch // ""' <<<"$run_json")"
            head_sha="$(jq -r '.headSha // ""' <<<"$run_json")"
            run_attempt="$(jq -r '.attempt // 0' <<<"$run_json")"

            if [[ -z "$status" ]]; then
                allowed="false"
                reason="RUN STATUS IS UNKNOWN"
            elif [[ "${status,,}" != "completed" ]]; then
                allowed="false"
                reason="RUN MUST BE COMPLETED BEFORE RERUN // STATUS ${status^^}"
            fi

            token="$(jq -c \
                --arg repository "$repo" \
                --arg runId "$run_id" \
                '{
                    repository:$repository,
                    runId:$runId,
                    workflow:(.workflowName // ""),
                    headSha:(.headSha // ""),
                    attempt:(.attempt // 0)
                }' <<<"$run_json")"

            summary="RERUN // $workflow // #$run_id // ATTEMPT $run_attempt"
            [[ -n "$conclusion" ]] && summary+=" // ${conclusion^^}"
            [[ -n "$head_branch" ]] && summary+=" // $head_branch"
            [[ -n "$head_sha" ]] && summary+=" // ${head_sha:0:8}"

            jq -n \
                --arg actionId "$action_id" \
                --argjson allowed "$allowed" \
                --arg summary "$summary" \
                --arg reason "$reason" \
                --arg token "$token" \
                --argjson target "$run_json" \
                '{
                    version:1,
                    actionId:$actionId,
                    allowed:$allowed,
                    summary:$summary,
                    reason:$reason,
                    token:$token,
                    target:$target
                }'
            ;;
        github.workflow.run)
            need gh

            local repository_key repo workflow_query ref_value effective_ref
            local workflow_json workflow_id workflow_name workflow_path workflow_state
            local ref_sha workflow_blob_sha baseline baseline_ids token summary frozen_command
            local allowed="true" reason=""

            repository_key="$(jq -r '.repository // ""' <<<"$arguments_json")"
            workflow_query="$(jq -r '.workflow // ""' <<<"$arguments_json")"
            ref_value="$(jq -r '.ref // ""' <<<"$arguments_json")"

            [[ -n "$repository_key" ]] || die "github.workflow.run preflight requires repository"
            [[ -n "$workflow_query" ]] || die "github.workflow.run preflight requires workflow"

            repo="$(repo_for "$repository_key")"
            workflow_json="$(github_workflow_guard_record "$repo" "$workflow_query")"
            workflow_id="$(jq -r '.id // ""' <<<"$workflow_json")"
            workflow_name="$(jq -r '.name // ""' <<<"$workflow_json")"
            workflow_path="$(jq -r '.path // ""' <<<"$workflow_json")"
            workflow_state="$(jq -r '.state // ""' <<<"$workflow_json")"

            [[ -n "$workflow_path" ]] || die "workflow has no canonical path: $workflow_query"

            if [[ -n "$ref_value" ]]; then
                effective_ref="$ref_value"
            else
                effective_ref="$(default_branch_for "$repo")"
            fi

            [[ -n "$effective_ref" ]] || die "workflow dispatch ref could not be resolved"

            ref_sha="$(github_ref_sha "$repo" "$effective_ref")"
            [[ -n "$ref_sha" ]] || die "workflow dispatch ref has no commit SHA"

            workflow_blob_sha="$(github_workflow_blob_sha "$repo" "$workflow_path" "$effective_ref")"
            [[ -n "$workflow_blob_sha" ]] || die "workflow file has no blob SHA at $effective_ref"

            baseline="$(github_dispatch_runs_for "$repo" "$workflow_path" "$ref_sha")"
            baseline_ids="$(jq -c '[.[].databaseId] | sort' <<<"$baseline")"

            if [[ "${workflow_state,,}" != "active" ]]; then
                allowed="false"
                reason="WORKFLOW IS NOT ACTIVE // ${workflow_state^^}"
            fi

            token="$(jq -nc \
                --arg repository "$repo" \
                --arg workflowId "$workflow_id" \
                --arg workflowName "$workflow_name" \
                --arg workflowPath "$workflow_path" \
                --arg workflowState "$workflow_state" \
                --arg workflowBlobSha "$workflow_blob_sha" \
                --arg ref "$effective_ref" \
                --arg refSha "$ref_sha" \
                --argjson beforeRunIds "$baseline_ids" \
                '{
                    repository:$repository,
                    workflowId:$workflowId,
                    workflowName:$workflowName,
                    workflowPath:$workflowPath,
                    workflowState:$workflowState,
                    workflowBlobSha:$workflowBlobSha,
                    ref:$ref,
                    refSha:$refSha,
                    beforeRunIds:$beforeRunIds
                }')"

            frozen_command="$(jq -nc \
                --arg repository "$repo" \
                --arg workflow "$workflow_path" \
                --arg ref "$effective_ref" \
                '["run",$repository,$workflow,$ref]')"

            summary="DISPATCH // $workflow_name // $workflow_path // $effective_ref@${ref_sha:0:8}"

            jq -n \
                --arg actionId "$action_id" \
                --argjson allowed "$allowed" \
                --arg summary "$summary" \
                --arg reason "$reason" \
                --arg token "$token" \
                --argjson frozenCommand "$frozen_command" \
                --argjson target "$workflow_json" \
                '{
                    version:1,
                    actionId:$actionId,
                    allowed:$allowed,
                    summary:$summary,
                    reason:$reason,
                    token:$token,
                    frozenCommand:$frozenCommand,
                    target:$target
                }'
            ;;
        workflow.create)
            need gh
            need mktemp
            need base64
            need sha256sum
            need awk

            local repository_key repo template slug trigger script_path
            local base base_sha workflow_path encoded_base lookup_tmp lookup_error=""
            local tmp yaml_sha yaml_base64 validation_ok="true"
            local allowed="true" reason="" token summary frozen_command target

            repository_key="$(jq -r '.repository // ""' <<<"$arguments_json")"
            template="$(jq -r '.template // ""' <<<"$arguments_json")"
            slug="$(jq -r '.slug // ""' <<<"$arguments_json")"
            trigger="$(jq -r '.trigger // ""' <<<"$arguments_json")"
            script_path="$(jq -r '.script_path // ""' <<<"$arguments_json")"

            [[ -n "$repository_key" ]] || die "workflow.create preflight requires repository"
            [[ -n "$template" ]] || die "workflow.create preflight requires template"
            [[ -n "$slug" ]] || die "workflow.create preflight requires slug"

            [[ -n "$trigger" ]] || trigger="manual"
            validate_slug "$slug"

            if [[ "$template" == "script-test" ]]; then
                validate_script_path "$script_path"
            elif [[ -n "$script_path" ]]; then
                die "--script is only valid with script-test"
            fi

            repo="$(repo_for "$repository_key")"
            base="$(default_branch_for "$repo")"
            [[ -n "$base" ]] || die "workflow create default branch unavailable"
            base_sha="$(github_ref_sha "$repo" "$base")"
            [[ -n "$base_sha" ]] || die "workflow create base has no commit SHA"

            workflow_path=".github/workflows/${slug}.yml"
            encoded_base="$(jq -rn --arg value "$base" '$value | @uri')"
            lookup_tmp="$(mktemp)"

            if gh api "repos/$repo/contents/$workflow_path?ref=$encoded_base" >/dev/null 2>"$lookup_tmp"; then
                allowed="false"
                reason="WORKFLOW TARGET ALREADY EXISTS // $workflow_path"
            else
                lookup_error="$(cat "$lookup_tmp")"
                if ! grep -qiE '404|not found' <<<"$lookup_error"; then
                    rm -f "$lookup_tmp"
                    die "workflow create target lookup failed // ${lookup_error:-unknown GitHub error}"
                fi
            fi
            rm -f "$lookup_tmp"

            tmp="$(mktemp)"
            render_workflow "$template" "$slug" "$trigger" "$base" "$script_path" > "$tmp"

            if ! validate_workflow "$tmp"; then
                validation_ok="false"
            fi

            yaml_sha="$(sha256sum "$tmp" | awk '{print $1}')"
            yaml_base64="$(base64 < "$tmp" | tr -d '\n')"

            if [[ "$validation_ok" != "true"
                    || "$VALIDATION_STATUS" != "pass" ]]; then
                allowed="false"
                if [[ -z "$reason" ]]; then
                    reason="WORKFLOW VALIDATION DID NOT PASS // ${VALIDATION_STATUS^^}"
                    [[ -n "$VALIDATION_MESSAGE" ]] && reason+=" // $VALIDATION_MESSAGE"
                fi
            fi

            token="$(jq -nc                 --arg repository "$repo"                 --arg base "$base"                 --arg baseSha "$base_sha"                 --arg template "$template"                 --arg slug "$slug"                 --arg trigger "$trigger"                 --arg scriptPath "$script_path"                 --arg workflowPath "$workflow_path"                 --arg yamlSha "$yaml_sha"                 --arg yamlBase64 "$yaml_base64"                 '{
                    repository:$repository,
                    base:$base,
                    baseSha:$baseSha,
                    template:$template,
                    slug:$slug,
                    trigger:$trigger,
                    scriptPath:$scriptPath,
                    workflowPath:$workflowPath,
                    yamlSha:$yamlSha,
                    yamlBase64:$yamlBase64
                }')"

            frozen_command="$(jq -nc                 --arg repository "$repo"                 --arg template "$template"                 --arg slug "$slug"                 --arg trigger "$trigger"                 --arg scriptPath "$script_path"                 --arg base "$base"                 --arg baseSha "$base_sha"                 --arg yamlSha "$yaml_sha"                 '[
                    "create",
                    $repository,
                    $template,
                    $slug,
                    $trigger
                ]
                + (
                    if $scriptPath == ""
                    then []
                    else ["--script=" + $scriptPath]
                    end
                )
                + [
                    "--install",
                    "--json",
                    "--expect-base=" + $base,
                    "--expect-base-sha=" + $baseSha,
                    "--expect-yaml-sha=" + $yamlSha
                ]')"

            target="$(jq -nc                 --arg repository "$repo"                 --arg base "$base"                 --arg baseSha "$base_sha"                 --arg workflowPath "$workflow_path"                 --arg template "$template"                 --arg slug "$slug"                 --arg trigger "$trigger"                 --arg scriptPath "$script_path"                 --arg yamlSha "$yaml_sha"                 --arg validationStatus "$VALIDATION_STATUS"                 --arg validationValidator "$VALIDATION_VALIDATOR"                 '{
                    repository:$repository,
                    base:$base,
                    baseSha:$baseSha,
                    workflowPath:$workflowPath,
                    template:$template,
                    slug:$slug,
                    trigger:$trigger,
                    scriptPath:(if $scriptPath == "" then null else $scriptPath end),
                    yamlSha:$yamlSha,
                    validation:{
                        status:$validationStatus,
                        validator:$validationValidator
                    }
                }')"

            summary="CREATE WORKFLOW // $workflow_path // $base@${base_sha:0:8} // YAML ${yaml_sha:0:8}"

            jq -n                 --arg actionId "$action_id"                 --argjson allowed "$allowed"                 --arg summary "$summary"                 --arg reason "$reason"                 --arg token "$token"                 --argjson frozenCommand "$frozen_command"                 --argjson target "$target"                 '{
                    version:1,
                    actionId:$actionId,
                    allowed:$allowed,
                    summary:$summary,
                    reason:$reason,
                    token:$token,
                    frozenCommand:$frozenCommand,
                    target:$target
                }'

            rm -f "$tmp"
            ;;
        workflow.delete)
            need gh

            local repository_key repo workflow_query ref_value effective_ref
            local workflow_json workflow_id workflow_name workflow_path workflow_state
            local ref_sha workflow_blob_sha token summary frozen_command

            repository_key="$(jq -r '.repository // ""' <<<"$arguments_json")"
            workflow_query="$(jq -r '.workflow_path // ""' <<<"$arguments_json")"
            ref_value="$(jq -r '.ref // ""' <<<"$arguments_json")"

            [[ -n "$repository_key" ]] || die "workflow.delete preflight requires repository"
            [[ -n "$workflow_query" ]] || die "workflow.delete preflight requires workflow_path"

            repo="$(repo_for "$repository_key")"
            workflow_json="$(github_workflow_guard_record "$repo" "$workflow_query")"
            workflow_id="$(jq -r '.id // ""' <<<"$workflow_json")"
            workflow_name="$(jq -r '.name // ""' <<<"$workflow_json")"
            workflow_path="$(jq -r '.path // ""' <<<"$workflow_json")"
            workflow_state="$(jq -r '.state // ""' <<<"$workflow_json")"

            [[ -n "$workflow_path" ]] || die "workflow delete target has no canonical path: $workflow_query"

            if [[ -n "$ref_value" ]]; then
                effective_ref="$ref_value"
            else
                effective_ref="$(default_branch_for "$repo")"
            fi

            [[ -n "$effective_ref" ]] || die "workflow delete ref could not be resolved"

            ref_sha="$(github_ref_sha "$repo" "$effective_ref")"
            [[ -n "$ref_sha" ]] || die "workflow delete ref has no commit SHA"

            workflow_blob_sha="$(github_workflow_blob_sha "$repo" "$workflow_path" "$effective_ref")"
            [[ -n "$workflow_blob_sha" ]] || die "workflow delete target has no blob SHA at $effective_ref"

            token="$(jq -nc \
                --arg repository "$repo" \
                --arg workflowId "$workflow_id" \
                --arg workflowName "$workflow_name" \
                --arg workflowPath "$workflow_path" \
                --arg workflowState "$workflow_state" \
                --arg workflowBlobSha "$workflow_blob_sha" \
                --arg ref "$effective_ref" \
                --arg refSha "$ref_sha" \
                '{
                    repository:$repository,
                    workflowId:$workflowId,
                    workflowName:$workflowName,
                    workflowPath:$workflowPath,
                    workflowState:$workflowState,
                    workflowBlobSha:$workflowBlobSha,
                    ref:$ref,
                    refSha:$refSha
                }')"

            frozen_command="$(jq -nc \
                --arg repository "$repo" \
                --arg workflowPath "$workflow_path" \
                --arg ref "$effective_ref" \
                --arg workflowBlobSha "$workflow_blob_sha" \
                '[
                    "delete-workflow",
                    $repository,
                    $workflowPath,
                    $ref,
                    "--expect-sha",
                    $workflowBlobSha
                ]')"

            summary="DELETE WORKFLOW // $workflow_name // $workflow_path // $effective_ref@${ref_sha:0:8} // BLOB ${workflow_blob_sha:0:8}"

            jq -n \
                --arg actionId "$action_id" \
                --arg summary "$summary" \
                --arg token "$token" \
                --argjson frozenCommand "$frozen_command" \
                --argjson target "$workflow_json" \
                '{
                    version:1,
                    actionId:$actionId,
                    allowed:true,
                    summary:$summary,
                    reason:"",
                    token:$token,
                    frozenCommand:$frozenCommand,
                    target:$target
                }'
        ;;
        *)
            die "no PX mutation preflight policy for action: $action_id"
            ;;
    esac
}

mutation_verify() {
    local action_id="${1:-}"
    local arguments_json="${2:-}"
    local preflight_token="${3:-}"

    [[ -n "$action_id" ]] || die "mutation action id required"
    [[ -n "$arguments_json" ]] || die "mutation arguments JSON required"

    need jq

    case "$action_id" in
        ai.turn|ai.quick.continue|ai.quick.report|ai.quick.checklist|ai.quick.next)
            local session_id token_session current_session events_json baseline_event_id after_events
            local expected_room expected_doctor expected_provider expected_workdir
            local status active_pid started_count completed_count failed_count cancelled_count
            local checkpoint_count report_count event_summary
            local passed="false" summary="" reason="" action_label

            session_id="$(jq -r '.session_id // ""' <<<"$arguments_json")"
            [[ -n "$session_id" ]] || die "$action_id verification requires session_id"
            [[ -n "$preflight_token" ]] || die "$action_id verification requires preflight token"

            token_session="$(jq -r '.sessionId // ""' <<<"$preflight_token")"
            [[ "$token_session" == "$session_id" ]] || die "Doctor verification session changed"

            baseline_event_id="$(jq -r '.baselineEventId // 0' <<<"$preflight_token")"
            expected_room="$(jq -r '.roomId // ""' <<<"$preflight_token")"
            expected_doctor="$(jq -r '.doctorId // ""' <<<"$preflight_token")"
            expected_provider="$(jq -r '.providerId // ""' <<<"$preflight_token")"
            expected_workdir="$(jq -r '.workingDirectory // ""' <<<"$preflight_token")"

            current_session="$(hospital_session_guard_record "$session_id")"
            events_json="$(hospital_session_guard_events "$session_id")"
            after_events="$(jq -c --argjson baseline "$baseline_event_id" '
                [.[] | select(((.id // 0) | tonumber? // 0) > $baseline)]
            ' <<<"$events_json")"

            status="$(jq -r '.status // ""' <<<"$current_session")"
            active_pid="$(jq -r '.activePid // 0' <<<"$current_session")"
            started_count="$(jq '[.[] | select(.type == "turn.started")] | length' <<<"$after_events")"
            completed_count="$(jq '[.[] | select(.type == "turn.completed")] | length' <<<"$after_events")"
            failed_count="$(jq '[.[] | select(.type == "turn.failed")] | length' <<<"$after_events")"
            cancelled_count="$(jq '[.[] | select(.type == "turn.cancelled")] | length' <<<"$after_events")"
            checkpoint_count="$(jq '[.[] | select(.type == "checkpoint.created")] | length' <<<"$after_events")"
            report_count="$(jq '[.[] | select(.type == "room_report.created")] | length' <<<"$after_events")"
            event_summary="$(jq -c '[.[] | {id,type,createdAt}]' <<<"$after_events")"

            case "$action_id" in
                ai.turn) action_label="MESSAGE DOCTOR" ;;
                ai.quick.continue) action_label="QUICK CONTINUE" ;;
                ai.quick.report) action_label="QUICK REPORT" ;;
                ai.quick.checklist) action_label="QUICK CHECKLIST" ;;
                ai.quick.next) action_label="QUICK NEXT" ;;
            esac

            if [[ "$(jq -r '.roomId // ""' <<<"$current_session")" != "$expected_room"
                    || "$(jq -r '.doctorId // ""' <<<"$current_session")" != "$expected_doctor"
                    || "$(jq -r '.providerId // ""' <<<"$current_session")" != "$expected_provider"
                    || "$(jq -r '.workingDirectory // ""' <<<"$current_session")" != "$expected_workdir" ]]; then
                reason="SESSION IDENTITY CHANGED DURING DOCTOR TURN"
            elif [[ "${status^^}" != "WAITING" || "$active_pid" -gt 0 ]]; then
                reason="DOCTOR DID NOT RETURN TO WAITING // STATUS ${status^^} // PID $active_pid"
            elif [[ "$failed_count" -gt 0 || "$cancelled_count" -gt 0 ]]; then
                reason="DOCTOR TURN FAILED OR WAS CANCELLED"
            elif [[ "$started_count" -ne 1 || "$completed_count" -ne 1 ]]; then
                reason="DOCTOR TURN ACTIVITY IS AMBIGUOUS // STARTED $started_count // COMPLETED $completed_count"
            elif [[ "$action_id" == "ai.quick.report"
                    && ( "$checkpoint_count" -ne 1 || "$report_count" -ne 1 ) ]]; then
                reason="QUICK REPORT DID NOT PRODUCE EXACTLY ONE CHECKPOINT AND ROOM REPORT"
            else
                passed="true"
                summary="$action_label VERIFIED // ROOM $expected_room // DOCTOR $expected_doctor // SESSION $session_id"
            fi

            if [[ "$passed" != "true" && -z "$summary" ]]; then
                summary="$action_label VERIFY FAILED // SESSION $session_id"
            fi

            jq -n \
                --arg actionId "$action_id" \
                --argjson passed "$passed" \
                --arg summary "$summary" \
                --arg reason "$reason" \
                --argjson session "$current_session" \
                --argjson events "$event_summary" \
                --argjson started "$started_count" \
                --argjson completed "$completed_count" \
                --argjson failed "$failed_count" \
                --argjson cancelled "$cancelled_count" \
                --argjson checkpoints "$checkpoint_count" \
                --argjson reports "$report_count" \
                '{
                    version:1,
                    actionId:$actionId,
                    passed:$passed,
                    summary:$summary,
                    reason:$reason,
                    target:{
                        session:$session,
                        events:$events,
                        counts:{
                            started:$started,
                            completed:$completed,
                            failed:$failed,
                            cancelled:$cancelled,
                            checkpoints:$checkpoints,
                            reports:$reports
                        }
                    }
                }'
            ;;
        github.run.cancel)
            need gh

            local repository_key repo run_id run_json
            local status="" conclusion="" workflow="" summary="" reason=""
            local passed="false"
            local attempt

            repository_key="$(jq -r '.repository // ""' <<<"$arguments_json")"
            run_id="$(jq -r '.run_id // ""' <<<"$arguments_json")"

            [[ -n "$repository_key" ]] || die "github.run.cancel verification requires repository"
            [[ -n "$run_id" ]] || die "github.run.cancel verification requires run_id"

            repo="$(repo_for "$repository_key")"

            for attempt in 1 2 3 4 5; do
                run_json="$(github_run_guard_record "$repo" "$run_id")"
                status="$(jq -r '.status // ""' <<<"$run_json")"
                conclusion="$(jq -r '.conclusion // ""' <<<"$run_json")"
                workflow="$(jq -r '.workflowName // "UNKNOWN WORKFLOW"' <<<"$run_json")"

                if [[ "${status,,}" == "completed" ]]; then
                    break
                fi

                [[ "$attempt" -eq 5 ]] || sleep 1
            done

            if [[ "${status,,}" == "completed"
                    && "${conclusion,,}" == "cancelled" ]]; then
                passed="true"
                summary="CANCEL VERIFIED // $workflow // #$run_id"
            elif [[ "${status,,}" == "completed" ]]; then
                reason="RUN COMPLETED AS ${conclusion^^} BEFORE CANCELLATION WAS VERIFIED"
                summary="CANCEL VERIFY FAILED // $workflow // #$run_id"
            else
                reason="RUN STILL ${status^^} AFTER CANCELLATION REQUEST"
                summary="CANCEL VERIFY PENDING // $workflow // #$run_id"
            fi

            jq -n \
                --arg actionId "$action_id" \
                --argjson passed "$passed" \
                --arg summary "$summary" \
                --arg reason "$reason" \
                --argjson target "$run_json" \
                '{
                    version:1,
                    actionId:$actionId,
                    passed:$passed,
                    summary:$summary,
                    reason:$reason,
                    target:$target
                }'
            ;;
        github.run.rerun)
            need gh

            local repository_key repo run_id run_json
            local workflow="" status="" head_sha="" current_attempt=0
            local original_attempt expected_workflow expected_head_sha
            local summary="" reason="" passed="false"
            local check

            repository_key="$(jq -r '.repository // ""' <<<"$arguments_json")"
            run_id="$(jq -r '.run_id // ""' <<<"$arguments_json")"

            [[ -n "$repository_key" ]] || die "github.run.rerun verification requires repository"
            [[ -n "$run_id" ]] || die "github.run.rerun verification requires run_id"
            [[ -n "$preflight_token" ]] || die "github.run.rerun verification requires preflight token"

            original_attempt="$(jq -r '.attempt // 0' <<<"$preflight_token")"
            expected_workflow="$(jq -r '.workflow // ""' <<<"$preflight_token")"
            expected_head_sha="$(jq -r '.headSha // ""' <<<"$preflight_token")"
            repo="$(repo_for "$repository_key")"

            for check in 1 2 3 4 5; do
                run_json="$(github_run_guard_record "$repo" "$run_id")"
                workflow="$(jq -r '.workflowName // ""' <<<"$run_json")"
                status="$(jq -r '.status // ""' <<<"$run_json")"
                head_sha="$(jq -r '.headSha // ""' <<<"$run_json")"
                current_attempt="$(jq -r '.attempt // 0' <<<"$run_json")"

                if [[ "$workflow" != "$expected_workflow"
                        || "$head_sha" != "$expected_head_sha" ]]; then
                    reason="RUN IDENTITY CHANGED DURING RERUN VERIFICATION"
                    break
                fi

                if (( current_attempt > original_attempt )); then
                    passed="true"
                    summary="RERUN VERIFIED // $workflow // #$run_id // ATTEMPT $current_attempt // ${status^^}"
                    break
                fi

                [[ "$check" -eq 5 ]] || sleep 1
            done

            if [[ "$passed" != "true" && -z "$reason" ]]; then
                reason="RUN ATTEMPT DID NOT ADVANCE // STILL $current_attempt"
                summary="RERUN VERIFY FAILED // $workflow // #$run_id"
            fi

            jq -n \
                --arg actionId "$action_id" \
                --argjson passed "$passed" \
                --arg summary "$summary" \
                --arg reason "$reason" \
                --argjson target "$run_json" \
                '{
                    version:1,
                    actionId:$actionId,
                    passed:$passed,
                    summary:$summary,
                    reason:$reason,
                    target:$target
                }'
            ;;
        github.workflow.run)
            need gh

            local repository_key repo workflow_path workflow_name ref_sha
            local before_ids current candidates candidate_count target
            local passed="false" summary="" reason=""
            local check

            repository_key="$(jq -r '.repository // ""' <<<"$arguments_json")"
            [[ -n "$repository_key" ]] || die "github.workflow.run verification requires repository"
            [[ -n "$preflight_token" ]] || die "github.workflow.run verification requires preflight token"

            repo="$(repo_for "$repository_key")"
            workflow_path="$(jq -r '.workflowPath // ""' <<<"$preflight_token")"
            workflow_name="$(jq -r '.workflowName // ""' <<<"$preflight_token")"
            ref_sha="$(jq -r '.refSha // ""' <<<"$preflight_token")"
            before_ids="$(jq -c '.beforeRunIds // []' <<<"$preflight_token")"

            [[ -n "$workflow_path" ]] || die "dispatch verification token has no workflow path"
            [[ -n "$ref_sha" ]] || die "dispatch verification token has no ref SHA"

            target='{}'

            for check in 1 2 3 4 5; do
                current="$(github_dispatch_runs_for "$repo" "$workflow_path" "$ref_sha")"
                candidates="$(jq -c \
                    --argjson before "$before_ids" \
                    '[.[] | select((.databaseId as $id | $before | index($id)) == null)]' \
                    <<<"$current")"
                candidate_count="$(jq 'length' <<<"$candidates")"

                if [[ "$candidate_count" -eq 1 ]]; then
                    target="$(jq -c '.[0]' <<<"$candidates")"
                    passed="true"
                    summary="DISPATCH VERIFIED // $workflow_name // #$(jq -r '.databaseId' <<<"$target")"
                    break
                fi

                if [[ "$candidate_count" -gt 1 ]]; then
                    reason="DISPATCH VERIFICATION AMBIGUOUS // $candidate_count NEW MATCHING RUNS"
                    summary="DISPATCH VERIFY FAILED // $workflow_name"
                    break
                fi

                [[ "$check" -eq 5 ]] || sleep 1
            done

            if [[ "$passed" != "true" && -z "$reason" ]]; then
                reason="NO NEW MATCHING WORKFLOW_DISPATCH RUN APPEARED"
                summary="DISPATCH VERIFY FAILED // $workflow_name"
            fi

            jq -n \
                --arg actionId "$action_id" \
                --argjson passed "$passed" \
                --arg summary "$summary" \
                --arg reason "$reason" \
                --argjson target "$target" \
                '{
                    version:1,
                    actionId:$actionId,
                    passed:$passed,
                    summary:$summary,
                    reason:$reason,
                    target:$target
                }'
            ;;
        workflow.create)
            need gh
            need mktemp

            local repository_key repo token_repo base expected_base_sha
            local workflow_path expected_yaml_sha current_base current_base_sha
            local metadata remote_yaml_sha remote_blob_sha encoded_base tmp lookup_error=""
            local passed="false" summary="" reason="" target

            repository_key="$(jq -r '.repository // ""' <<<"$arguments_json")"
            [[ -n "$repository_key" ]] || die "workflow.create verification requires repository"
            [[ -n "$preflight_token" ]] || die "workflow.create verification requires preflight token"

            repo="$(repo_for "$repository_key")"
            token_repo="$(jq -r '.repository // ""' <<<"$preflight_token")"
            base="$(jq -r '.base // ""' <<<"$preflight_token")"
            expected_base_sha="$(jq -r '.baseSha // ""' <<<"$preflight_token")"
            workflow_path="$(jq -r '.workflowPath // ""' <<<"$preflight_token")"
            expected_yaml_sha="$(jq -r '.yamlSha // ""' <<<"$preflight_token")"

            [[ "$token_repo" == "$repo" ]] || die "workflow create verification repository changed"
            [[ -n "$base" ]] || die "workflow create verification token has no base"
            [[ -n "$expected_base_sha" ]] || die "workflow create verification token has no base SHA"
            [[ -n "$workflow_path" ]] || die "workflow create verification token has no workflow path"
            [[ -n "$expected_yaml_sha" ]] || die "workflow create verification token has no YAML SHA"

            current_base="$(default_branch_for "$repo")"
            current_base_sha="$(github_ref_sha "$repo" "$base")"
            encoded_base="$(jq -rn --arg value "$base" '$value | @uri')"

            if [[ "$current_base" != "$base" ]]; then
                reason="DEFAULT BRANCH CHANGED // EXPECTED $base // CURRENT $current_base"
                summary="CREATE VERIFY FAILED // $workflow_path"
                metadata='{}'
                remote_blob_sha=""
                remote_yaml_sha=""
            else
                tmp="$(mktemp)"
                if metadata="$(gh api "repos/$repo/contents/$workflow_path?ref=$encoded_base" 2>"$tmp")"; then
                    remote_blob_sha="$(jq -r '.sha // ""' <<<"$metadata")"
                    remote_yaml_sha="$(github_remote_file_sha256 "$repo" "$workflow_path" "$base")"

                    if [[ "$current_base_sha" == "$expected_base_sha" ]]; then
                        reason="TARGET REF DID NOT ADVANCE AFTER WORKFLOW CREATE"
                        summary="CREATE VERIFY FAILED // $workflow_path"
                    elif [[ "$remote_yaml_sha" != "$expected_yaml_sha" ]]; then
                        reason="CREATED WORKFLOW CONTENT DOES NOT MATCH FROZEN YAML"
                        summary="CREATE VERIFY FAILED // $workflow_path"
                    else
                        passed="true"
                        summary="CREATE VERIFIED // $workflow_path // $base@${current_base_sha:0:8}"
                    fi
                else
                    lookup_error="$(cat "$tmp")"
                    if grep -qiE '404|not found' <<<"$lookup_error"; then
                        reason="CREATED WORKFLOW IS MISSING // $workflow_path"
                        summary="CREATE VERIFY FAILED // $workflow_path"
                        metadata='{}'
                        remote_blob_sha=""
                        remote_yaml_sha=""
                    else
                        rm -f "$tmp"
                        die "workflow create verification lookup failed // ${lookup_error:-unknown GitHub error}"
                    fi
                fi
                rm -f "$tmp"
            fi

            target="$(jq -nc                 --arg repository "$repo"                 --arg base "$base"                 --arg previousBaseSha "$expected_base_sha"                 --arg currentBaseSha "$current_base_sha"                 --arg workflowPath "$workflow_path"                 --arg expectedYamlSha "$expected_yaml_sha"                 --arg remoteYamlSha "$remote_yaml_sha"                 --arg remoteBlobSha "$remote_blob_sha"                 '{
                    repository:$repository,
                    base:$base,
                    previousBaseSha:$previousBaseSha,
                    currentBaseSha:$currentBaseSha,
                    workflowPath:$workflowPath,
                    expectedYamlSha:$expectedYamlSha,
                    remoteYamlSha:(if $remoteYamlSha == "" then null else $remoteYamlSha end),
                    remoteBlobSha:(if $remoteBlobSha == "" then null else $remoteBlobSha end)
                }')"

            jq -n                 --arg actionId "$action_id"                 --argjson passed "$passed"                 --arg summary "$summary"                 --arg reason "$reason"                 --argjson target "$target"                 '{
                    version:1,
                    actionId:$actionId,
                    passed:$passed,
                    summary:$summary,
                    reason:$reason,
                    target:$target
                }'
            ;;
        workflow.delete)
            need gh
            need mktemp

            local repository_key repo token_repo workflow_path workflow_name ref_value
            local expected_blob expected_ref_sha current_ref_sha current_blob=""
            local lookup_error="" encoded_ref tmp
            local passed="false" summary="" reason="" target

            repository_key="$(jq -r '.repository // ""' <<<"$arguments_json")"
            [[ -n "$repository_key" ]] || die "workflow.delete verification requires repository"
            [[ -n "$preflight_token" ]] || die "workflow.delete verification requires preflight token"

            repo="$(repo_for "$repository_key")"
            token_repo="$(jq -r '.repository // ""' <<<"$preflight_token")"
            workflow_path="$(jq -r '.workflowPath // ""' <<<"$preflight_token")"
            workflow_name="$(jq -r '.workflowName // ""' <<<"$preflight_token")"
            ref_value="$(jq -r '.ref // ""' <<<"$preflight_token")"
            expected_blob="$(jq -r '.workflowBlobSha // ""' <<<"$preflight_token")"
            expected_ref_sha="$(jq -r '.refSha // ""' <<<"$preflight_token")"

            [[ "$token_repo" == "$repo" ]] || die "workflow delete verification repository changed"
            [[ -n "$workflow_path" ]] || die "workflow delete verification token has no workflow path"
            [[ -n "$ref_value" ]] || die "workflow delete verification token has no ref"
            [[ -n "$expected_blob" ]] || die "workflow delete verification token has no blob SHA"
            [[ -n "$expected_ref_sha" ]] || die "workflow delete verification token has no ref SHA"

            current_ref_sha="$(github_ref_sha "$repo" "$ref_value")"
            [[ -n "$current_ref_sha" ]] || die "workflow delete verification ref has no commit SHA"

            encoded_ref="$(jq -rn --arg value "$ref_value" '$value | @uri')"
            tmp="$(mktemp)"
            if current_blob="$(gh api "repos/$repo/contents/$workflow_path?ref=$encoded_ref" --jq '.sha' 2>"$tmp")"; then
                reason="WORKFLOW STILL EXISTS // BLOB ${current_blob:0:8}"
                summary="DELETE VERIFY FAILED // $workflow_name // $workflow_path"
            else
                lookup_error="$(cat "$tmp")"

                if grep -qiE '404|not found' <<<"$lookup_error"; then
                    if [[ "$current_ref_sha" == "$expected_ref_sha" ]]; then
                        reason="TARGET REF DID NOT ADVANCE AFTER DELETE"
                        summary="DELETE VERIFY FAILED // $workflow_name // $workflow_path"
                    else
                        passed="true"
                        summary="DELETE VERIFIED // $workflow_name // $workflow_path // $ref_value@${current_ref_sha:0:8}"
                    fi
                else
                    rm -f "$tmp"
                    die "workflow delete verification lookup failed // ${lookup_error:-unknown GitHub error}"
                fi
            fi
            rm -f "$tmp"

            target="$(jq -nc \
                --arg repository "$repo" \
                --arg workflowPath "$workflow_path" \
                --arg workflowName "$workflow_name" \
                --arg ref "$ref_value" \
                --arg previousRefSha "$expected_ref_sha" \
                --arg currentRefSha "$current_ref_sha" \
                --arg previousBlobSha "$expected_blob" \
                --arg currentBlobSha "$current_blob" \
                --argjson exists "$( [[ -n "$current_blob" ]] && printf true || printf false )" \
                '{
                    repository:$repository,
                    workflowPath:$workflowPath,
                    workflowName:$workflowName,
                    ref:$ref,
                    previousRefSha:$previousRefSha,
                    currentRefSha:$currentRefSha,
                    previousBlobSha:$previousBlobSha,
                    currentBlobSha:(if $currentBlobSha == "" then null else $currentBlobSha end),
                    exists:$exists
                }')"

            jq -n \
                --arg actionId "$action_id" \
                --argjson passed "$passed" \
                --arg summary "$summary" \
                --arg reason "$reason" \
                --argjson target "$target" \
                '{
                    version:1,
                    actionId:$actionId,
                    passed:$passed,
                    summary:$summary,
                    reason:$reason,
                    target:$target
                }'
        ;;
        *)
            die "no PX mutation verification policy for action: $action_id"
            ;;
    esac
}

validate_slug() {
    local slug="$1"
    [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
        || die "workflow slug must match: [a-z0-9][a-z0-9-]*"
}

render_trigger() {
    local trigger="$1"
    local base="$2"

    case "$trigger" in
        manual)
            cat <<'EOF'
on:
  workflow_dispatch:
EOF
            ;;
        push)
            cat <<EOF
on:
  push:
    branches:
      - $base
EOF
            ;;
        manual+push)
            cat <<EOF
on:
  workflow_dispatch:
  push:
    branches:
      - $base
EOF
            ;;
        *)
            die "unknown trigger: $trigger (use manual, push, or manual+push)"
            ;;
    esac
}

validate_script_path() {
    local script_path="$1"

    [[ -n "$script_path" ]] || die "script path required for script-test"
    [[ "$script_path" != /* ]] || die "script path must be repository-relative"
    [[ "$script_path" =~ ^[A-Za-z0-9._/-]+$ ]] \
        || die "script path contains unsupported characters"
    [[ "/$script_path/" != *"/../"* ]] \
        || die "script path may not traverse outside the repository"
    [[ "$script_path" != ".." ]] \
        || die "script path may not traverse outside the repository"
}

render_workflow() {
    local template="$1"
    local slug="$2"
    local trigger="$3"
    local base="$4"
    local script_path="${5:-}"
    local title="${slug//-/ }"

    printf 'name: "PX / %s"\n\n' "$title"
    render_trigger "$trigger" "$base"

    case "$template" in
        smoke)
            cat <<'EOF'

permissions:
  contents: read

jobs:
  smoke:
    name: Repository smoke test
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Report execution identity
        run: |
          echo "repo=$GITHUB_REPOSITORY"
          echo "ref=$GITHUB_REF"
          echo "sha=$GITHUB_SHA"
          echo "PX workflow is alive."
EOF
            ;;
        shell-check)
            cat <<'EOF'

permissions:
  contents: read

jobs:
  shell-check:
    name: Shell syntax check
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Validate shell scripts
        shell: bash
        run: |
          mapfile -d '' scripts < <(find . -type f -name '*.sh' -print0)
          if ((${#scripts[@]} == 0)); then
            echo "No .sh files found; nothing to validate."
            exit 0
          fi

          printf 'Checking %d shell script(s)\n' "${#scripts[@]}"
          for script in "${scripts[@]}"; do
            echo "bash -n $script"
            bash -n "$script"
          done
EOF
            ;;
        script-test)
            validate_script_path "$script_path"
            cat <<EOF

permissions:
  contents: read

jobs:
  script-test:
    name: Script test
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Run $script_path
        shell: bash
        run: bash "$script_path"
EOF
            ;;
        *)
            die "unknown template: $template"
            ;;
    esac
}

validate_workflow() {
    local file="$1"
    local output=""

    VALIDATION_STATUS="skipped"
    VALIDATION_VALIDATOR="none"
    VALIDATION_MESSAGE="actionlint unavailable"

    if command -v actionlint >/dev/null 2>&1; then
        VALIDATION_VALIDATOR="actionlint"
        if output="$(actionlint "$file" 2>&1)"; then
            VALIDATION_STATUS="pass"
            VALIDATION_MESSAGE=""
            return 0
        fi
        VALIDATION_STATUS="fail"
        VALIDATION_MESSAGE="$output"
        return 1
    fi

    if command -v toolbox >/dev/null 2>&1 \
        && toolbox run -c "$TOOLBOX_NAME" sh -lc 'command -v actionlint >/dev/null 2>&1' >/dev/null 2>&1; then
        VALIDATION_VALIDATOR="actionlint via $TOOLBOX_NAME"
        if output="$(toolbox run -c "$TOOLBOX_NAME" actionlint - < "$file" 2>&1)"; then
            VALIDATION_STATUS="pass"
            VALIDATION_MESSAGE=""
            return 0
        fi
        VALIDATION_STATUS="fail"
        VALIDATION_MESSAGE="$output"
        return 1
    fi

    return 0
}

print_validation() {
    case "$VALIDATION_STATUS" in
        pass)
            printf 'validation: PASS (%s)\n' "$VALIDATION_VALIDATOR" >&2
            ;;
        fail)
            printf 'validation: FAIL (%s)\n' "$VALIDATION_VALIDATOR" >&2
            [[ -n "$VALIDATION_MESSAGE" ]] && printf '%s\n' "$VALIDATION_MESSAGE" >&2
            ;;
        skipped)
            warn "$VALIDATION_MESSAGE; generated YAML was not semantically validated"
            ;;
    esac
}

install_workflow() {
    local repo="$1"
    local base="$2"
    local slug="$3"
    local yaml_file="$4"
    local workflow_path=".github/workflows/${slug}.yml"
    local encoded commit_sha

    need base64

    if gh api "repos/$repo/contents/$workflow_path?ref=$base" >/dev/null 2>&1; then
        die "$workflow_path already exists on $base; edit support is a later PX seam"
    fi

    encoded="$(base64 < "$yaml_file" | tr -d '\n')"

    commit_sha="$(gh api --method PUT "repos/$repo/contents/$workflow_path" \
        -f message="Add PX workflow: $slug" \
        -f content="$encoded" \
        -f branch="$base" \
        --jq '.commit.sha')"

    [[ -n "$commit_sha" ]] || die "workflow install returned no commit SHA"

    INSTALL_BRANCH="$base"
    INSTALL_PR_URL=""
    INSTALL_COMMIT_SHA="$commit_sha"
}

create_workflow() {
    local alias="${1:-}"
    local template="${2:-}"
    local slug="${3:-}"
    local trigger="manual"
    local mode="--preview"
    local format="human"
    local script_path=""
    local expected_base=""
    local expected_base_sha=""
    local expected_yaml_sha=""
    local generated_yaml_sha=""
    local current_base_sha=""
    local repo base tmp workflow_path arg
    local validation_ok=true

    [[ -n "$alias" ]] || die "usage: px create <repo> <template> <slug> [trigger] [--preview|--install] [--json]"
    [[ -n "$template" ]] || die "template required"
    [[ -n "$slug" ]] || die "workflow slug required"
    validate_slug "$slug"

    for arg in "${@:4}"; do
        case "$arg" in
            manual|push|manual+push)
                trigger="$arg"
                ;;
            --preview|--install)
                mode="$arg"
                ;;
            --json)
                format="json"
                ;;
            --script=*)
                script_path="${arg#--script=}"
                ;;
            --expect-base=*)
                expected_base="${arg#--expect-base=}"
                ;;
            --expect-base-sha=*)
                expected_base_sha="${arg#--expect-base-sha=}"
                ;;
            --expect-yaml-sha=*)
                expected_yaml_sha="${arg#--expect-yaml-sha=}"
                ;;
            *)
                die "unknown create option: $arg"
                ;;
        esac
    done

    if [[ "$template" == "script-test" ]]; then
        validate_script_path "$script_path"
    elif [[ -n "$script_path" ]]; then
        die "--script is only valid with script-test"
    fi

    need gh
    if [[ "$format" == "json" ]]; then
        need jq
    fi

    repo="$(repo_for "$alias")"
    base="$(default_branch_for "$repo")"
    [[ -n "$base" ]] || die "could not resolve default branch for $repo"

    if [[ -n "$expected_base" && "$base" != "$expected_base" ]]; then
        die "workflow create refused: default branch changed after confirmation // expected $expected_base // current $base"
    fi

    workflow_path=".github/workflows/${slug}.yml"

    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' RETURN
    render_workflow "$template" "$slug" "$trigger" "$base" "$script_path" > "$tmp"

    if ! validate_workflow "$tmp"; then
        validation_ok=false
    fi

    if [[ -n "$expected_yaml_sha" ]]; then
        need sha256sum
        need awk
        generated_yaml_sha="$(sha256sum "$tmp" | awk '{print $1}')"
        [[ "$generated_yaml_sha" == "$expected_yaml_sha" ]]             || die "workflow create refused: generated YAML changed after confirmation // expected $expected_yaml_sha // current $generated_yaml_sha"
    fi

    if [[ -n "$expected_base_sha" ]]; then
        current_base_sha="$(github_ref_sha "$repo" "$base")"
        [[ "$current_base_sha" == "$expected_base_sha" ]]             || die "workflow create refused: base moved after confirmation // expected $expected_base_sha // current $current_base_sha"
    fi

    INSTALL_BRANCH=""
    INSTALL_PR_URL=""
    INSTALL_COMMIT_SHA=""

    if [[ "$mode" == "--install" ]]; then
        if [[ "$VALIDATION_STATUS" != "pass" ]]; then
            if [[ "$format" == "human" ]]; then
                print_validation
            fi
        else
            install_workflow "$repo" "$base" "$slug" "$tmp"
        fi
    fi

    if [[ "$format" == "json" ]]; then
        local installed=false
        [[ -n "$INSTALL_COMMIT_SHA" ]] && installed=true

        jq -n \
            --arg repo "$alias" \
            --arg repository "$repo" \
            --arg base "$base" \
            --arg template "$template" \
            --arg slug "$slug" \
            --arg trigger "$trigger" \
            --arg script "$script_path" \
            --arg path "$workflow_path" \
            --arg mode "${mode#--}" \
            --arg validation_status "$VALIDATION_STATUS" \
            --arg validation_validator "$VALIDATION_VALIDATOR" \
            --arg validation_message "$VALIDATION_MESSAGE" \
            --arg branch "$INSTALL_BRANCH" \
            --arg pull_request "$INSTALL_PR_URL" \
            --arg commit "$INSTALL_COMMIT_SHA" \
            --argjson installed "$installed" \
            --rawfile yaml "$tmp" \
            '{
                repo: $repo,
                repository: $repository,
                base: $base,
                template: $template,
                slug: $slug,
                trigger: $trigger,
                script: (if $script == "" then null else $script end),
                path: $path,
                mode: $mode,
                validation: {
                    status: $validation_status,
                    validator: (if $validation_validator == "" then null else $validation_validator end),
                    message: (if $validation_message == "" then null else $validation_message end)
                },
                yaml: $yaml,
                install: {
                    requested: ($mode == "install"),
                    installed: $installed,
                    branch: (if $branch == "" then null else $branch end),
                    pull_request: (if $pull_request == "" then null else $pull_request end),
                    commit: (if $commit == "" then null else $commit end)
                }
            }'

        if [[ "$validation_ok" != true || ( "$mode" == "--install" && "$VALIDATION_STATUS" != "pass" ) ]]; then
            return 1
        fi
        return 0
    fi

    printf 'PX WORKFLOW CANDIDATE\n'
    printf 'repo: %s (%s)\n' "$alias" "$repo"
    printf 'base: %s\n' "$base"
    printf 'template: %s\n' "$template"
    printf 'slug: %s\n' "$slug"
    printf 'trigger: %s\n' "$trigger"
    [[ -n "$script_path" ]] && printf 'script: %s\n' "$script_path"
    printf 'path: %s\n' "$workflow_path"
    printf '\n--- YAML ---\n'
    cat "$tmp"
    printf '%s\n' '--- END YAML ---'

    printf '\n--- VALIDATION ---\n' >&2
    print_validation

    if [[ "$validation_ok" != true ]]; then
        return 1
    fi

    if [[ "$mode" == "--install" ]]; then
        [[ "$VALIDATION_STATUS" == "pass" ]] || die "refusing install without successful semantic validation"
        printf '\n--- INSTALL ---\n'
        printf 'installed: %s\n' "$workflow_path"
        printf 'branch: %s\n' "$INSTALL_BRANCH"
        printf 'commit: %s\n' "$INSTALL_COMMIT_SHA"
    else
        printf '\npreview only: no repository changes made\n'
        if [[ -n "$script_path" ]]; then
            printf 'install with: px create %s %s %s %s --script=%s --install\n' \
                "$alias" "$template" "$slug" "$trigger" "$script_path"
        else
            printf 'install with: px create %s %s %s %s --install\n' \
                "$alias" "$template" "$slug" "$trigger"
        fi
    fi
}

audit_rooms_for() {
    local repo="$1"
    local base="$2"
    local rooms='[]'
    local repo_key team responsibility branch
    local base_encoded branch_encoded compare_json item
    local relation ahead behind state head updated_at
    local -A seen_branches=()

    base_encoded="$(jq -rn --arg value "$base" '$value | @uri')"

    # Registered rooms are optional metadata/aliases.
    # They are emitted first so existing friendly names remain intact.
    if [[ -f "$ROOMS_REGISTRY" ]]; then
        while IFS=$'\t' read -r repo_key team responsibility branch; do
            [[ -z "$repo_key" || "$repo_key" == \#* ]] && continue
            [[ "$repo_key" == "$repo" ]] || continue
            [[ -n "$branch" ]] || continue

            [[ -n "${seen_branches[$branch]+x}" ]] && continue
            seen_branches["$branch"]=1

            branch_encoded="$(jq -rn --arg value "$branch" '$value | @uri')"

            if compare_json="$(gh api "repos/$repo/compare/${base_encoded}...${branch_encoded}" 2>/dev/null)"; then
                relation="$(jq -r '.status // "unknown"' <<<"$compare_json")"
                ahead="$(jq -r '.ahead_by // 0' <<<"$compare_json")"
                behind="$(jq -r '.behind_by // 0' <<<"$compare_json")"

                if (( ahead == 0 && behind == 0 )); then
                    state="AT_MAIN"
                elif (( ahead == 0 && behind > 0 )); then
                    state="IN_MAIN"
                elif (( ahead > 0 && behind == 0 )); then
                    state="AHEAD"
                else
                    state="DIVERGED"
                fi

                if (( ahead > 0 )); then
                    head="$(jq -r '.commits[-1].sha // ""' <<<"$compare_json")"
                    updated_at="$(jq -r '.commits[-1].commit.committer.date // ""' <<<"$compare_json")"
                else
                    head="$(jq -r '.merge_base_commit.sha // ""' <<<"$compare_json")"
                    updated_at="$(jq -r '.merge_base_commit.commit.committer.date // ""' <<<"$compare_json")"
                fi

                item="$(jq -n \
                    --arg team "$team" \
                    --arg responsibility "$responsibility" \
                    --arg branch "$branch" \
                    --arg state "$state" \
                    --arg relation "$relation" \
                    --arg head "$head" \
                    --arg updated_at "$updated_at" \
                    --argjson ahead "$ahead" \
                    --argjson behind "$behind" \
                    '{
                        team: $team,
                        responsibility: $responsibility,
                        branch: $branch,
                        exists: true,
                        source: "registry",
                        state: $state,
                        relation: $relation,
                        ahead: $ahead,
                        behind: $behind,
                        head: (if $head == "" then null else $head end),
                        updated_at: (if $updated_at == "" then null else $updated_at end)
                    }')"
            else
                item="$(jq -n \
                    --arg team "$team" \
                    --arg responsibility "$responsibility" \
                    --arg branch "$branch" \
                    '{
                        team: $team,
                        responsibility: $responsibility,
                        branch: $branch,
                        exists: false,
                        source: "registry",
                        state: "MISSING",
                        relation: null,
                        ahead: null,
                        behind: null,
                        head: null,
                        updated_at: null
                    }')"
            fi

            rooms="$(jq --argjson item "$item" '. + [$item]' <<<"$rooms")"
        done < "$ROOMS_REGISTRY"
    fi

    # Any GitHub branch not already registered is automatically a room.
    while IFS=$'\t' read -r branch head; do
        [[ -n "$branch" ]] || continue
        [[ "$branch" == "$base" ]] && continue
        [[ -n "${seen_branches[$branch]+x}" ]] && continue

        seen_branches["$branch"]=1

        item="$(jq -n \
            --arg branch "$branch" \
            --arg head "$head" \
            '{
                team: $branch,
                responsibility: "AUTO DISCOVERED",
                branch: $branch,
                exists: true,
                source: "discovered",
                state: "DISCOVERED",
                relation: null,
                ahead: null,
                behind: null,
                head: (if $head == "" then null else $head end),
                updated_at: null
            }')"

        rooms="$(jq --argjson item "$item" '. + [$item]' <<<"$rooms")"
    done < <(
        gh api --paginate "repos/$repo/branches?per_page=100" \
            --jq '.[] | [.name, .commit.sha] | @tsv'
    )

    printf '%s\n' "$rooms"
}

audit_repo() {
    local key="${1:-}"
    local repo repo_json workflows_json runs_json rooms_json base

    [[ -n "$key" ]] || die "usage: px audit <repo>"

    need gh
    need jq

    repo="$(repo_for "$key")"
    repo_json="$(gh repo view "$repo" --json nameWithOwner,defaultBranchRef,isPrivate,isArchived,url)"
    base="$(jq -r '.defaultBranchRef.name // ""' <<<"$repo_json")"
    workflows_json="$(workflows_for "$repo")"
    runs_json="$(gh run list -R "$repo" --limit "$LIMIT" \
        --json databaseId,workflowName,status,conclusion,headBranch,headSha,createdAt)"
    rooms_json="$(audit_rooms_for "$repo" "$base")"

    jq -n \
        --arg requested "$key" \
        --argjson repo "$repo_json" \
        --argjson workflows "$workflows_json" \
        --argjson runs "$runs_json" \
        --argjson rooms "$rooms_json" \
        '{
            requested: $requested,
            repository: $repo.nameWithOwner,
            default_branch: ($repo.defaultBranchRef.name // null),
            private: $repo.isPrivate,
            archived: $repo.isArchived,
            url: $repo.url,
            status: (
                if $repo.isArchived then "ARCHIVED"
                elif ($workflows | length) == 0 then "NO_WORKFLOWS"
                elif ($runs | length) == 0 then "NO_RUNS"
                elif (($runs[0].status // "") | ascii_downcase) != "completed" then "RUNNING"
                elif (($runs[0].conclusion // "") | ascii_downcase) == "success" then "PASS"
                else "ATTENTION"
                end
            ),
            workflows: {
                count: ($workflows | length),
                active: ([$workflows[] | select((.state // "") == "active")] | length),
                items: $workflows
            },
            runs: {
                count: ($runs | length),
                latest: (
                    if ($runs | length) == 0 then null
                    else {
                        id: $runs[0].databaseId,
                        workflow: $runs[0].workflowName,
                        status: $runs[0].status,
                        conclusion: $runs[0].conclusion,
                        branch: $runs[0].headBranch,
                        created_at: $runs[0].createdAt
                    }
                    end
                )
            },
            rooms: {
                base: ($repo.defaultBranchRef.name // null),
                count: ($rooms | length),
                items: $rooms
            }
        }'
}

room_branch_for() {
    local repo="$1"
    local room="$2"
    local branch=""
    local encoded=""

    # Preserve friendly aliases from the optional registry.
    if [[ -f "$ROOMS_REGISTRY" ]]; then
        branch="$(
            awk -F '\t' -v repo="$repo" -v room="$room" '
                $1 == repo && ($2 == room || $4 == room) {
                    print $4
                    found=1
                    exit
                }
                END { if (!found) exit 1 }
            ' "$ROOMS_REGISTRY" 2>/dev/null || true
        )"
    fi

    if [[ -n "$branch" ]]; then
        printf '%s\n' "$branch"
        return 0
    fi

    # Otherwise the room ID may simply be a real Git branch.
    encoded="$(jq -rn --arg value "$room" '$value | @uri')"

    if gh api "repos/$repo/branches/$encoded" >/dev/null 2>&1; then
        printf '%s\n' "$room"
        return 0
    fi

    die "room or branch not found: $room"
}

require_hospital_assignment_authority() {
    local repo="${1:-}"
    local team="${2:-}"
    local permission="${3:-}"

    [[ -n "$repo" ]] || die "Hospital authority repository required"
    [[ -n "$team" ]] || die "Hospital authority team required"
    [[ -n "$permission" ]] || die "Hospital authority permission required"

    need python3
    python3 "$ROOT/bin/px-hospital-store" assignment-authority         --team "$team"         --repository "$repo"         --permission "$permission"         --require         --json >/dev/null
}


room_inspect() {
    local key="${1:-}"
    local team="${2:-}"
    local action="${3:-status}"
    local repo branch base repo_json base_encoded branch_encoded compare_json
    local base_head branch_head

    [[ -n "$key" ]] || die "usage: px room <repo> <team> [status|diff|log|prepare]"
    [[ -n "$team" ]] || die "room team required"
    need gh
    need jq
    need awk

    repo="$(repo_for "$key")"
    branch="$(room_branch_for "$repo" "$team")" || die "unknown room: $team for $repo"
    repo_json="$(gh repo view "$repo" --json defaultBranchRef)"
    base="$(jq -r '.defaultBranchRef.name // ""' <<<"$repo_json")"
    base_encoded="$(jq -rn --arg v "$base" '$v | @uri')"
    branch_encoded="$(jq -rn --arg v "$branch" '$v | @uri')"
    base_head="$(gh api "repos/$repo/branches/$base_encoded" --jq '.commit.sha' </dev/null)"
    branch_head="$(gh api "repos/$repo/branches/$branch_encoded" --jq '.commit.sha' </dev/null)"

    case "$action" in
        status|diff|prepare)
            compare_json="$(gh api "repos/$repo/compare/${base_encoded}...${branch_encoded}" </dev/null)"
            if [[ "$action" == "status" ]]; then
                jq -n --arg repo "$repo" --arg team "$team" --arg branch "$branch" --arg base "$base" --argjson c "$compare_json" '
                    {action:"status",repository:$repo,team:$team,branch:$branch,base:$base,relation:($c.status//"unknown"),ahead:($c.ahead_by//0),behind:($c.behind_by//0),head:(if (($c.commits//[])|length)>0 then $c.commits[-1].sha else ($c.merge_base_commit.sha//null) end)}'
            elif [[ "$action" == "diff" ]]; then
                jq -n --arg repo "$repo" --arg team "$team" --arg branch "$branch" --arg base "$base" --argjson c "$compare_json" '
                    {action:"diff",repository:$repo,team:$team,branch:$branch,base:$base,relation:($c.status//"unknown"),ahead:($c.ahead_by//0),behind:($c.behind_by//0),files:[($c.files//[])[]|{path:.filename,status:.status,additions:(.additions//0),deletions:(.deletions//0)}],totals:{files:(($c.files//[])|length),additions:([($c.files//[])[]|(.additions//0)]|add//0),deletions:([($c.files//[])[]|(.deletions//0)]|add//0)}}'
            else
                jq -n --arg repo "$repo" --arg team "$team" --arg branch "$branch" --arg base "$base" --arg head "$branch_head" --arg base_head "$base_head" --argjson c "$compare_json" '
                    def integration_mode:
                        if ($c.status // "") == "identical" then "ALREADY_AT_MAIN"
                        elif ($c.status // "") == "ahead" then "FAST_FORWARD"
                        elif ($c.status // "") == "behind" then "NO_UNIQUE_COMMITS"
                        elif ($c.status // "") == "diverged" then "DIVERGED"
                        else "REVIEW_REQUIRED"
                        end;
                    {
                        action:"prepare",
                        repository:$repo,
                        team:$team,
                        branch:$branch,
                        head:$head,
                        base:$base,
                        base_head:$base_head,
                        relation:($c.status//"unknown"),
                        mode: integration_mode,
                        ahead:($c.ahead_by//0),
                        behind:($c.behind_by//0),
                        totals:{
                            files:(($c.files//[])|length),
                            additions:([($c.files//[])[]|(.additions//0)]|add//0),
                            deletions:([($c.files//[])[]|(.deletions//0)]|add//0)
                        },
                        changed_files:[
                            ($c.files//[])[]
                            | {
                                path:.filename,
                                status:.status,
                                additions:(.additions//0),
                                deletions:(.deletions//0)
                            }
                        ],
                        files:[
                            ($c.files//[])[0:8][]
                            | {
                                path:.filename,
                                status:.status,
                                additions:(.additions//0),
                                deletions:(.deletions//0)
                            }
                        ]
                    }'
            fi
            ;;
        log)
            gh api "repos/$repo/commits?sha=${branch_encoded}&per_page=8" </dev/null | jq --arg repo "$repo" --arg team "$team" --arg branch "$branch" '
                {action:"log",repository:$repo,team:$team,branch:$branch,commits:[.[]|{sha:.sha,short:(.sha[0:8]),message:(.commit.message|split("\n")[0]),authored_at:.commit.author.date}]}'
            ;;
        *)
            die "unknown room action: $action"
            ;;
    esac
}

room_rehearse() {
    local key="${1:-}"
    local team="${2:-}"
    local expected_branch="${3:-}"
    local expected_head="${4:-}"
    local expected_base="${5:-}"
    local expected_base_head="${6:-}"
    local local_repo="${7:-}"
    local repo branch base base_encoded branch_encoded current_head current_base_head
    local local_origin local_slug

    [[ -n "$key" ]] || die "repository required"
    [[ -n "$team" ]] || die "room team required"
    [[ -n "$expected_branch" ]] || die "expected branch required"
    [[ -n "$expected_head" ]] || die "expected room head required"
    [[ -n "$expected_base" ]] || die "expected base branch required"
    [[ -n "$expected_base_head" ]] || die "expected base head required"
    [[ -n "$local_repo" ]] || die "local patient path required"

    need gh
    need jq
    need awk
    need git
    need mktemp

    repo="$(repo_for "$key")"
    require_hospital_assignment_authority "$repo" "$team" "TEST"
    branch="$(room_branch_for "$repo" "$team")" || die "unknown room: $team for $repo"
    [[ "$branch" == "$expected_branch" ]] || die "REHEARSAL INVALID // registered room branch changed"

    base="$(gh repo view "$repo" --json defaultBranchRef --jq '.defaultBranchRef.name // ""')"
    [[ "$base" == "$expected_base" ]] || die "REHEARSAL INVALID // default branch changed"

    git -C "$local_repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
        || die "LOCAL PATIENT INVALID // not a git repository"

    local_origin="$(git -C "$local_repo" remote get-url origin 2>/dev/null || true)"
    case "$local_origin" in
        git@github.com:*) local_slug="${local_origin#git@github.com:}" ;;
        https://github.com/*) local_slug="${local_origin#https://github.com/}" ;;
        http://github.com/*) local_slug="${local_origin#http://github.com/}" ;;
        ssh://git@github.com/*) local_slug="${local_origin#ssh://git@github.com/}" ;;
        *) die "LOCAL PATIENT INVALID // unsupported or missing GitHub origin" ;;
    esac
    local_slug="${local_slug%.git}"
    [[ "$local_slug" == "$repo" ]] \
        || die "LOCAL PATIENT MISMATCH // origin does not match target repository"

    base_encoded="$(jq -rn --arg v "$base" '$v | @uri')"
    branch_encoded="$(jq -rn --arg v "$branch" '$v | @uri')"
    current_base_head="$(gh api "repos/$repo/branches/$base_encoded" --jq '.commit.sha' </dev/null)"
    current_head="$(gh api "repos/$repo/branches/$branch_encoded" --jq '.commit.sha' </dev/null)"

    [[ "$current_head" == "$expected_head" ]] \
        || die "REHEARSAL INVALID // room head moved"
    [[ "$current_base_head" == "$expected_base_head" ]] \
        || die "REHEARSAL INVALID // base head moved"

    (
        set -euo pipefail
        local tmp_root rehearsal_repo merge_rc merge_base result_tree
        local conflict_json changed_json file_count additions deletions status

        tmp_root="$(mktemp -d "${TMPDIR:-/tmp}/px-rehearse.XXXXXX")"
        trap 'rm -rf -- "$tmp_root"' EXIT
        rehearsal_repo="$tmp_root/repo"

        gh repo clone "$repo" "$rehearsal_repo" -- --no-checkout --quiet >/dev/null 2>&1
        git -C "$rehearsal_repo" fetch --quiet origin "$base" "$branch"

        [[ "$(git -C "$rehearsal_repo" rev-parse "origin/$base")" == "$expected_base_head" ]] \
            || die "REHEARSAL CLONE INVALID // base head mismatch"
        [[ "$(git -C "$rehearsal_repo" rev-parse "origin/$branch")" == "$expected_head" ]] \
            || die "REHEARSAL CLONE INVALID // room head mismatch"

        git -C "$rehearsal_repo" checkout --quiet --detach "$expected_base_head"
        merge_base="$(git -C "$rehearsal_repo" merge-base "$expected_base_head" "$expected_head")"

        if git -C "$rehearsal_repo" -c user.name="Post-Apollo Rehearsal" -c user.email="rehearsal@localhost" \
            merge --no-commit --no-ff "$expected_head" >/dev/null 2>&1; then
            merge_rc=0
            status="CLEAN_MERGE"
        else
            merge_rc=$?
            status="CONFLICTS"
        fi

        conflict_json="$(git -C "$rehearsal_repo" diff --name-only --diff-filter=U | jq -Rsc 'split("\n") | map(select(length > 0))')"
        changed_json="$(git -C "$rehearsal_repo" diff --cached --name-only | jq -Rsc 'split("\n") | map(select(length > 0)) | unique')"
        file_count="$(jq 'length' <<<"$changed_json")"
        read -r additions deletions < <(
            git -C "$rehearsal_repo" diff --cached --numstat \
            | awk '{ if ($1 ~ /^[0-9]+$/) a += $1; if ($2 ~ /^[0-9]+$/) d += $2 } END { print a+0, d+0 }'
        )

        result_tree=""
        if [[ "$status" == "CLEAN_MERGE" ]]; then
            result_tree="$(git -C "$rehearsal_repo" write-tree)"
        fi

        jq -n \
            --arg action "rehearse" \
            --arg status "$status" \
            --arg repository "$repo" \
            --arg team "$team" \
            --arg branch "$branch" \
            --arg head "$expected_head" \
            --arg base "$base" \
            --arg base_head "$expected_base_head" \
            --arg merge_base "$merge_base" \
            --arg result_tree "$result_tree" \
            --argjson merge_rc "$merge_rc" \
            --argjson conflicts "$conflict_json" \
            --argjson changed "$changed_json" \
            --argjson files "$file_count" \
            --argjson additions "$additions" \
            --argjson deletions "$deletions" \
            '{
                action:$action,
                status:$status,
                repository:$repository,
                team:$team,
                branch:$branch,
                head:$head,
                base:$base,
                base_head:$base_head,
                merge_base:$merge_base,
                result_tree:(if $result_tree == "" then null else $result_tree end),
                merge_exit:$merge_rc,
                conflicts:$conflicts,
                changed_files:$changed,
                totals:{files:$files,additions:$additions,deletions:$deletions},
                topology:{parents:[$base_head,$head]}
            }'
    )
}

room_merge() {
    local key="${1:-}"
    local team="${2:-}"
    local expected_branch="${3:-}"
    local expected_head="${4:-}"
    local expected_base="${5:-}"
    local expected_base_head="${6:-}"
    local expected_tree="${7:-}"
    local local_repo="${8:-}"
    local repo branch base base_encoded branch_encoded current_head current_base_head
    local local_origin local_slug

    [[ -n "$key" ]] || die "repository required"
    [[ -n "$team" ]] || die "room team required"
    [[ -n "$expected_branch" ]] || die "expected branch required"
    [[ -n "$expected_head" ]] || die "expected room head required"
    [[ -n "$expected_base" ]] || die "expected base branch required"
    [[ -n "$expected_base_head" ]] || die "expected base head required"
    [[ -n "$expected_tree" ]] || die "expected rehearsal tree required"
    [[ -n "$local_repo" ]] || die "local patient path required"

    need gh
    need jq
    need awk
    need git
    need mktemp

    repo="$(repo_for "$key")"
    require_hospital_assignment_authority "$repo" "$team" "INTEGRATE"
    branch="$(room_branch_for "$repo" "$team")" || die "unknown room: $team for $repo"
    [[ "$branch" == "$expected_branch" ]] || die "ARM INVALID // registered room branch changed"

    base="$(gh repo view "$repo" --json defaultBranchRef --jq '.defaultBranchRef.name // ""')"
    [[ "$base" == "$expected_base" ]] || die "ARM INVALID // default branch changed"

    git -C "$local_repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
        || die "LOCAL PATIENT INVALID // not a git repository"

    local_origin="$(git -C "$local_repo" remote get-url origin 2>/dev/null || true)"
    case "$local_origin" in
        git@github.com:*) local_slug="${local_origin#git@github.com:}" ;;
        https://github.com/*) local_slug="${local_origin#https://github.com/}" ;;
        http://github.com/*) local_slug="${local_origin#http://github.com/}" ;;
        ssh://git@github.com/*) local_slug="${local_origin#ssh://git@github.com/}" ;;
        *) die "LOCAL PATIENT INVALID // unsupported or missing GitHub origin" ;;
    esac
    local_slug="${local_slug%.git}"
    [[ "$local_slug" == "$repo" ]] \
        || die "LOCAL PATIENT MISMATCH // origin does not match target repository"
    [[ -z "$(git -C "$local_repo" status --porcelain=v1)" ]] \
        || die "PATIENT DIRTY // merge refused"

    base_encoded="$(jq -rn --arg v "$base" '$v | @uri')"
    branch_encoded="$(jq -rn --arg v "$branch" '$v | @uri')"
    current_base_head="$(gh api "repos/$repo/branches/$base_encoded" --jq '.commit.sha' </dev/null)"
    current_head="$(gh api "repos/$repo/branches/$branch_encoded" --jq '.commit.sha' </dev/null)"

    [[ "$current_head" == "$expected_head" ]] \
        || die "ARM INVALID // room head moved"
    [[ "$current_base_head" == "$expected_base_head" ]] \
        || die "ARM INVALID // base head moved"

    (
        set -euo pipefail
        local tmp_root merge_repo result_tree merge_sha verify_base verify_head

        tmp_root="$(mktemp -d "${TMPDIR:-/tmp}/px-merge.XXXXXX")"
        trap 'rm -rf -- "$tmp_root"' EXIT
        merge_repo="$tmp_root/repo"

        gh repo clone "$repo" "$merge_repo" -- --no-checkout --quiet >/dev/null 2>&1
        git -C "$merge_repo" fetch --quiet origin "$base" "$branch"

        [[ "$(git -C "$merge_repo" rev-parse "origin/$base")" == "$expected_base_head" ]] \
            || die "MERGE CLONE INVALID // base head mismatch"
        [[ "$(git -C "$merge_repo" rev-parse "origin/$branch")" == "$expected_head" ]] \
            || die "MERGE CLONE INVALID // room head mismatch"

        git -C "$merge_repo" checkout --quiet --detach "$expected_base_head"
        if ! git -C "$merge_repo" -c user.name="Post-Apollo Hospital" -c user.email="hospital@localhost" \
            merge --no-commit --no-ff "$expected_head" >/dev/null 2>&1; then
            die "MERGE REFUSED // rehearsal no longer reproduces cleanly"
        fi

        result_tree="$(git -C "$merge_repo" write-tree)"
        [[ "$result_tree" == "$expected_tree" ]] \
            || die "MERGE REFUSED // rehearsal tree changed"

        git -C "$merge_repo" -c user.name="Post-Apollo Hospital" -c user.email="hospital@localhost" \
            commit --quiet -m "Merge $branch into $base via Post-Apollo Hospital"
        merge_sha="$(git -C "$merge_repo" rev-parse HEAD)"

        verify_base="$(gh api "repos/$repo/branches/$base_encoded" --jq '.commit.sha' </dev/null)"
        verify_head="$(gh api "repos/$repo/branches/$branch_encoded" --jq '.commit.sha' </dev/null)"
        [[ "$verify_base" == "$expected_base_head" ]] \
            || die "MERGE REFUSED // base moved after rehearsal verification"
        [[ "$verify_head" == "$expected_head" ]] \
            || die "MERGE REFUSED // room moved after rehearsal verification"

        git -C "$merge_repo" push --quiet origin "$merge_sha:refs/heads/$base"

        jq -n \
            --arg action "merge" \
            --arg status "MERGED" \
            --arg mode "REHEARSED_MERGE" \
            --arg repository "$repo" \
            --arg team "$team" \
            --arg branch "$branch" \
            --arg base "$base" \
            --arg old_base_head "$expected_base_head" \
            --arg room_head "$expected_head" \
            --arg result_tree "$result_tree" \
            --arg new_base_head "$merge_sha" \
            '{
                action:$action,
                status:$status,
                mode:$mode,
                repository:$repository,
                team:$team,
                branch:$branch,
                base:$base,
                old_base_head:$old_base_head,
                room_head:$room_head,
                result_tree:$result_tree,
                new_base_head:$new_base_head,
                parents:[$old_base_head,$room_head]
            }'
    )
}

room_integrate() {
    local key="${1:-}"
    local team="${2:-}"
    local expected_branch="${3:-}"
    local expected_head="${4:-}"
    local expected_base="${5:-}"
    local expected_base_head="${6:-}"
    local local_repo="${7:-}"
    local repo branch base base_encoded branch_encoded current_head current_base_head
    local compare_json relation local_origin local_slug

    [[ -n "$key" ]] || die "repository required"
    [[ -n "$team" ]] || die "room team required"
    [[ -n "$expected_branch" ]] || die "expected branch required"
    [[ -n "$expected_head" ]] || die "expected room head required"
    [[ -n "$expected_base" ]] || die "expected base branch required"
    [[ -n "$expected_base_head" ]] || die "expected base head required"
    [[ -n "$local_repo" ]] || die "local patient path required"

    need gh
    need jq
    need awk
    need git

    repo="$(repo_for "$key")"
    require_hospital_assignment_authority "$repo" "$team" "INTEGRATE"
    branch="$(room_branch_for "$repo" "$team")" || die "unknown room: $team for $repo"
    [[ "$branch" == "$expected_branch" ]] || die "ARM INVALID // registered room branch changed"

    base="$(gh repo view "$repo" --json defaultBranchRef --jq '.defaultBranchRef.name // ""')"
    [[ "$base" == "$expected_base" ]] || die "ARM INVALID // default branch changed"

    git -C "$local_repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
        || die "LOCAL PATIENT INVALID // not a git repository"

    local_origin="$(git -C "$local_repo" remote get-url origin 2>/dev/null || true)"
    case "$local_origin" in
        git@github.com:*)
            local_slug="${local_origin#git@github.com:}"
            ;;
        https://github.com/*)
            local_slug="${local_origin#https://github.com/}"
            ;;
        http://github.com/*)
            local_slug="${local_origin#http://github.com/}"
            ;;
        ssh://git@github.com/*)
            local_slug="${local_origin#ssh://git@github.com/}"
            ;;
        *)
            die "LOCAL PATIENT INVALID // unsupported or missing GitHub origin"
            ;;
    esac
    local_slug="${local_slug%.git}"
    [[ "$local_slug" == "$repo" ]] \
        || die "LOCAL PATIENT MISMATCH // origin does not match target repository"

    [[ -z "$(git -C "$local_repo" status --porcelain=v1)" ]] \
        || die "PATIENT DIRTY // integration refused"

    base_encoded="$(jq -rn --arg v "$base" '$v | @uri')"
    branch_encoded="$(jq -rn --arg v "$branch" '$v | @uri')"
    current_base_head="$(gh api "repos/$repo/branches/$base_encoded" --jq '.commit.sha' </dev/null)"
    current_head="$(gh api "repos/$repo/branches/$branch_encoded" --jq '.commit.sha' </dev/null)"

    [[ "$current_head" == "$expected_head" ]] \
        || die "ARM INVALID // room head moved"
    [[ "$current_base_head" == "$expected_base_head" ]] \
        || die "ARM INVALID // base head moved"

    compare_json="$(gh api "repos/$repo/compare/${base_encoded}...${branch_encoded}" </dev/null)"
    relation="$(jq -r '.status // "unknown"' <<<"$compare_json")"
    [[ "$relation" == "ahead" ]] \
        || die "INTEGRATION REFUSED // room is no longer fast-forwardable"

    gh api \
        -X PATCH \
        "repos/$repo/git/refs/heads/$base" \
        -f sha="$current_head" \
        -F force=false \
        >/dev/null

    jq -n \
        --arg repository "$repo" \
        --arg team "$team" \
        --arg branch "$branch" \
        --arg base "$base" \
        --arg old_base_head "$current_base_head" \
        --arg new_base_head "$current_head" \
        '{
            action:"integrate",
            status:"INTEGRATED",
            mode:"FAST_FORWARD",
            repository:$repository,
            team:$team,
            branch:$branch,
            base:$base,
            old_base_head:$old_base_head,
            new_base_head:$new_base_head
        }'
}

room_verify() {
    local key="${1:-}"
    local team="${2:-}"
    local expected_base="${3:-}"
    local expected_base_head="${4:-}"
    local expected_room_head="${5:-}"
    local repo branch base base_encoded branch_encoded
    local current_base_head current_room_head containment_json containment_status
    local current_relation_json current_relation current_ahead current_behind

    [[ -n "$key" ]] || die "repository required"
    [[ -n "$team" ]] || die "room team required"
    [[ -n "$expected_base" ]] || die "expected base branch required"
    [[ -n "$expected_base_head" ]] || die "expected post-op base head required"
    [[ -n "$expected_room_head" ]] || die "expected room head required"

    need gh
    need jq
    need awk

    repo="$(repo_for "$key")"
    branch="$(room_branch_for "$repo" "$team")" || die "unknown room: $team for $repo"
    base="$(gh repo view "$repo" --json defaultBranchRef --jq '.defaultBranchRef.name // ""')"
    [[ "$base" == "$expected_base" ]] || die "POST-OP VERIFY FAILED // default branch changed"

    base_encoded="$(jq -rn --arg v "$base" '$v | @uri')"
    branch_encoded="$(jq -rn --arg v "$branch" '$v | @uri')"
    current_base_head="$(gh api "repos/$repo/branches/$base_encoded" --jq '.commit.sha' </dev/null)"
    current_room_head="$(gh api "repos/$repo/branches/$branch_encoded" --jq '.commit.sha' </dev/null)"

    [[ "$current_base_head" == "$expected_base_head" ]] \
        || die "POST-OP VERIFY FAILED // base head does not match expected result"

    containment_json="$(gh api "repos/$repo/compare/${expected_room_head}...${expected_base_head}" </dev/null)"
    containment_status="$(jq -r '.status // "unknown"' <<<"$containment_json")"
    [[ "$containment_status" == "ahead" || "$containment_status" == "identical" ]] \
        || die "POST-OP VERIFY FAILED // operated room commit is not contained in base"

    current_relation_json="$(gh api "repos/$repo/compare/${base_encoded}...${branch_encoded}" </dev/null)"
    current_relation="$(jq -r '.status // "unknown"' <<<"$current_relation_json")"
    current_ahead="$(jq -r '.ahead_by // 0' <<<"$current_relation_json")"
    current_behind="$(jq -r '.behind_by // 0' <<<"$current_relation_json")"

    jq -n \
        --arg action "verify" \
        --arg status "POST_OP_CLEAN" \
        --arg repository "$repo" \
        --arg team "$team" \
        --arg branch "$branch" \
        --arg base "$base" \
        --arg expected_base_head "$expected_base_head" \
        --arg current_base_head "$current_base_head" \
        --arg expected_room_head "$expected_room_head" \
        --arg current_room_head "$current_room_head" \
        --arg containment "$containment_status" \
        --arg current_relation "$current_relation" \
        --argjson ahead "$current_ahead" \
        --argjson behind "$current_behind" \
        '{
            action:$action,
            status:$status,
            repository:$repository,
            team:$team,
            branch:$branch,
            base:$base,
            expected_base_head:$expected_base_head,
            current_base_head:$current_base_head,
            expected_room_head:$expected_room_head,
            current_room_head:$current_room_head,
            operated_commit_containment:$containment,
            room_branch_unchanged:($current_room_head == $expected_room_head),
            current_room_relation:{
                status:$current_relation,
                ahead:$ahead,
                behind:$behind
            }
        }'
}

actions() {
    local format="human"
    local query=""
    local arg

    for arg in "$@"; do
        case "$arg" in
            --json)
                format="json"
                ;;
            -h|--help)
                cat <<'EOF'
Usage:
  px actions [query] [--json]

Without a query, returns the full semantic action registry.
A query matches action id, title, category, summary, and keywords.
EOF
                return 0
                ;;
            -*)
                die "unknown actions option: $arg"
                ;;
            *)
                [[ -z "$query" ]] || die "actions accepts at most one query"
                query="$arg"
                ;;
        esac
    done

    [[ -f "$ACTIONS_REGISTRY" ]] \
        || die "action registry not found: $ACTIONS_REGISTRY"

    if [[ "$format" == "json" && -z "$query" ]]; then
        cat "$ACTIONS_REGISTRY"
        return 0
    fi

    need jq

    if [[ "$format" == "json" ]]; then
        jq --arg query "$query" '
            . as $registry
            | ($query | ascii_downcase) as $needle
            | {
                version: $registry.version,
                actions: [
                    $registry.actions[]
                    | (
                        [
                            .id,
                            .title,
                            .category,
                            .summary,
                            ((.keywords // []) | join(" "))
                        ]
                        | join(" ")
                        | ascii_downcase
                      ) as $haystack
                    | select($haystack | contains($needle))
                ]
              }
        ' "$ACTIONS_REGISTRY"
        return 0
    fi

    jq -r --arg query "$query" '
        ($query | ascii_downcase) as $needle
        | "ID\tCATEGORY\tTITLE",
          (
            .actions[]
            | (
                [
                    .id,
                    .title,
                    .category,
                    .summary,
                    ((.keywords // []) | join(" "))
                ]
                | join(" ")
                | ascii_downcase
              ) as $haystack
            | select($needle == "" or ($haystack | contains($needle)))
            | [.id, .category, .title]
            | @tsv
          )
    ' "$ACTIONS_REGISTRY"
}

templates() {
    cat <<'EOF'
[
  {
    "id": "smoke",
    "summary": "Checkout the repo and prove a GitHub runner can execute the workflow.",
    "mutates_repository": false
  },
  {
    "id": "shell-check",
    "summary": "Run bash -n against every .sh file in the repository.",
    "mutates_repository": false
  },
  {
    "id": "script-test",
    "summary": "Run one repository-relative test script as its own workflow.",
    "mutates_repository": false,
    "requires_script": true
  }
]
EOF
}

usage() {
    cat <<'EOF'
Post-Apollo PX control bus

Usage:
  px repos [--json]
  px doctor
  px workflows <repo>
  px branches <repo>
  px commits <repo> [ref] [limit]
  px runs <repo> [limit] [sha]
  px inspect <repo> <run-id>
  px logs <repo> <run-id>
  px mutation-preflight <action-id> <arguments-json>
  px mutation-verify <action-id> <arguments-json> [preflight-token]
  px run <repo> <workflow> [ref]
  px watch <repo> <run-id>
  px rerun <repo> <run-id>
  px cancel <repo> <run-id>
  px audit <repo>
  px room <repo> <team> [status|diff|log|prepare]
  px rehearse <repo> <team> <branch> <room-head> <base> <base-head> <local-path>
  px merge <repo> <team> <branch> <room-head> <base> <base-head> <result-tree> <local-path>
  px integrate <repo> <team> <branch> <room-head> <base> <base-head> <local-path>
  px verify <repo> <team> <base> <expected-base-head> <expected-room-head>
  px actions [query] [--json]
  px tools [query] [--json]
  px which <tool> [--backend <native|toolbox|distrobox>] [--environment <id>] [--json]
  px term
  px tui
  px operations [--limit N] [--status RUNNING|COMPLETE|FAILED] [--json]
  px operation <start|finish|get|list|stale|reconcile|recovery|recover> ...
  px templates
  px create <repo> <template> <slug> [trigger] [--preview|--install] [--json]
            [--script=PATH] [--expect-base=BRANCH] [--expect-base-sha=SHA]
            [--expect-yaml-sha=SHA256]
  px delete-workflow <repo> <workflow-path> [ref] [--expect-sha SHA] [--json]
  px hospital <init|status> [--json]
  px agent <providers|session-create|turn|status|cancel|quick> ...

Workflow factory:
  trigger: manual | push | manual+push
  mode:    --preview (default) | --install
  output:  human (default) | --json

Examples:
  px workflows dev
  px branches dev
  px commits dev main 20
  px inspect dev 123456789
  px logs dev 123456789
  px run dev px-smoke.yml
  px audit taskbars
  px room taskbars T6 prepare
  px actions --json
  px actions hospital
  px tools --json
  px tools lazy
  px which lazygit
  px which git --json
  px term
  px templates
  px create dev smoke my-first-action
  px create dev shell-check shell-syntax manual --preview
  px create dev shell-check shell-syntax manual --preview --json
  px create dev shell-check shell-syntax manual --install
  px delete-workflow dev .github/workflows/old-check.yml

Repo identities may be aliases from config/repos.tsv or explicit owner/name slugs.
PX create previews by default. --install writes the validated workflow directly
to the repository default branch. The Git commit remains the rollback point; no
browser or pull-request step is required for normal desktop use.
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    repos)
        if [[ "${1:-}" == "--json" ]]; then
            need jq
            jq -Rn --rawfile registry "$REGISTRY" '
                {
                    version: 1,
                    repositories: (
                        $registry
                        | split("\n")
                        | map(
                            select(length > 0)
                            | select(startswith("#") | not)
                            | split("\t")
                            | select(length >= 2)
                            | { alias: .[0], repository: .[1] }
                        )
                    )
                }
            '
        else
            printf '%-12s %s\n' ALIAS REPOSITORY
            while IFS="$(printf '\\t')" read -r alias repo; do
                [[ -z "$alias" || "$alias" == \#* ]] && continue
                printf '%-12s %s\n' "$alias" "$repo"
            done < "$REGISTRY"
        fi
        ;;

    doctor)
        need gh
        need awk
        printf 'registry: %s\n' "$REGISTRY"
        gh auth status
        ;;

    workflows)
        need gh
        repo="$(repo_for "${1:-}")"
        workflows_for "$repo"
        ;;

    branches)
        need gh
        repo="$(repo_for "${1:-}")"
        branches_for "$repo"
        ;;

    commits)
        need gh
        repo="$(repo_for "${1:-}")"
        commits_for "$repo" "${2:-}" "${3:-20}"
        ;;

    runs)
        need gh
        repo="$(repo_for "${1:-}")"
        limit="${2:-$LIMIT}"
        sha="${3:-}"
        if [[ -n "$sha" ]]; then
            gh run list -R "$repo" --limit "$limit" --commit "$sha" \
                --json databaseId,workflowName,status,conclusion,headBranch,headSha,createdAt
        else
            gh run list -R "$repo" --limit "$limit" \
                --json databaseId,workflowName,status,conclusion,headBranch,headSha,createdAt
        fi
        ;;

    inspect)
        need gh
        repo="$(repo_for "${1:-}")"
        run_id="${2:-}"
        [[ -n "$run_id" ]] || die "run id required"
        gh run view "$run_id" -R "$repo" \
            --json databaseId,workflowName,status,conclusion,headBranch,headSha,event,createdAt,startedAt,updatedAt,url,jobs
        ;;

    logs)
        need gh
        repo="$(repo_for "${1:-}")"
        run_id="${2:-}"
        [[ -n "$run_id" ]] || die "run id required"
        gh run view "$run_id" -R "$repo" --log
        ;;

    run)
        need gh
        repo="$(repo_for "${1:-}")"
        workflow="${2:-}"
        ref="${3:-}"
        [[ -n "$workflow" ]] || die "workflow required"

        if [[ -n "$ref" ]]; then
            gh workflow run "$workflow" -R "$repo" --ref "$ref"
        else
            gh workflow run "$workflow" -R "$repo"
        fi
        ;;

    watch)
        need gh
        repo="$(repo_for "${1:-}")"
        run_id="${2:-}"
        [[ -n "$run_id" ]] || die "run id required"
        gh run watch "$run_id" -R "$repo" --exit-status
        ;;

    rerun)
        need gh
        repo="$(repo_for "${1:-}")"
        run_id="${2:-}"
        [[ -n "$run_id" ]] || die "run id required"
        gh run rerun "$run_id" -R "$repo"
        ;;

    cancel)
        need gh
        repo="$(repo_for "${1:-}")"
        run_id="${2:-}"
        [[ -n "$run_id" ]] || die "run id required"
        gh run cancel "$run_id" -R "$repo"
        ;;

    mutation-preflight)
        mutation_preflight "$@"
        ;;

    mutation-verify)
        mutation_verify "$@"
        ;;

    audit)
        audit_repo "$@"
        ;;

    room)
        room_inspect "$@"
        ;;

    rehearse)
        room_rehearse "$@"
        ;;

    merge)
        room_merge "$@"
        ;;

    integrate)
        room_integrate "$@"
        ;;

    verify)
        room_verify "$@"
        ;;

    actions)
        actions "$@"
        ;;

    tools)
        need python3
        python3 "$ROOT/bin/px-tools" "$@"
        ;;

    which)
        need python3
        python3 "$ROOT/bin/px-resolve" "$@"
        ;;

    term|tui)
        bash "$ROOT/bin/px-term" "$@"
        ;;

    operations)
        need python3
        python3 "$ROOT/bin/px-operation-store" list "$@"
        ;;

    operation)
        need python3
        if [[ "${1:-}" == "recover" ]]; then
            shift
            execute_operation_recovery "$@"
        else
            python3 "$ROOT/bin/px-operation-store" "$@"
        fi
        ;;

    templates)
        templates
        ;;

    create)
        create_workflow "$@"
        ;;

    hospital)
        need python3
        python3 "$ROOT/bin/px-hospital-store" "$@"
        ;;

    agent)
        need python3
        python3 "$ROOT/bin/px-agent" "$@"
        ;;

    delete-workflow)
        need gh
        repo="$(repo_for "${1:-}")"
        workflow="${2:-}"
        ref="${3:-}"
        expected_sha=""
        delete_format="human"

        if [[ "${4:-}" == "--expect-sha" ]]; then
            expected_sha="${5:-}"
            [[ -n "$expected_sha" ]] || die "workflow delete expected SHA is missing"
            if [[ "${6:-}" == "--json" ]]; then
                delete_format="json"
                [[ -z "${7:-}" ]] || die "unknown delete-workflow argument: ${7}"
            elif [[ -n "${6:-}" ]]; then
                die "unknown delete-workflow argument: ${6}"
            fi
        elif [[ "${4:-}" == "--json" ]]; then
            delete_format="json"
            [[ -z "${5:-}" ]] || die "unknown delete-workflow argument: ${5}"
        elif [[ -n "${4:-}" ]]; then
            die "unknown delete-workflow argument: ${4}"
        fi

        [[ -n "$workflow" ]] || die "workflow path required"
        workflow="${workflow#./}"

        case "$workflow" in
            .github/workflows/*.yml|.github/workflows/*.yaml)
                ;;
            *)
                die "workflow delete refused: path must be .github/workflows/*.yml or *.yaml"
                ;;
        esac

        [[ "$workflow" != *".."* ]] \
            || die "workflow delete refused: parent traversal is not allowed"

        [[ -n "$ref" ]] || ref="$(default_branch_for "$repo")"
        [[ -n "$ref" ]] || die "workflow delete target ref unavailable"

        metadata="$(gh api "repos/$repo/contents/$workflow?ref=$ref")" \
            || die "workflow not found on $ref: $workflow"

        type="$(printf '%s' "$metadata" | jq -r '.type // empty')"
        sha="$(printf '%s' "$metadata" | jq -r '.sha // empty')"

        [[ "$type" == "file" ]] \
            || die "workflow delete refused: target is not a file"
        [[ -n "$sha" ]] \
            || die "workflow delete refused: content SHA missing"

        if [[ -n "$expected_sha" && "$sha" != "$expected_sha" ]]; then
            die "workflow delete refused: content SHA changed after confirmation // expected $expected_sha // current $sha"
        fi

        delete_response="$(gh api --method DELETE "repos/$repo/contents/$workflow" \
            -f "message=Delete workflow $workflow" \
            -f "sha=$sha" \
            -f "branch=$ref")"
        delete_commit="$(jq -r '.commit.sha // ""' <<<"$delete_response")"

        if [[ "$delete_format" == "json" ]]; then
            jq -n \
                --arg repository "$repo" \
                --arg path "$workflow" \
                --arg ref "$ref" \
                --arg blobSha "$sha" \
                --arg commit "$delete_commit" \
                '{
                    deleted:true,
                    repository:$repository,
                    path:$path,
                    ref:$ref,
                    blobSha:$blobSha,
                    commit:(if $commit == "" then null else $commit end)
                }'
        else
            printf 'deleted workflow: %s @ %s\n' "$workflow" "$ref"
        fi
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        usage >&2
        die "unknown command: $cmd"
        ;;
esac
