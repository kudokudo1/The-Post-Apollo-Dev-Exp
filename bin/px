#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
REGISTRY="${PX_REPO_REGISTRY:-$ROOT/config/repos.tsv}"
LIMIT="${PX_RUN_LIMIT:-10}"
TOOLBOX_NAME="${PX_TOOLBOX:-fedora-toolbox-44}"

die() {
    printf 'px: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'px: warning: %s\n' "$*" >&2
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

repo_for() {
    local alias="${1:-}"
    [[ -n "$alias" ]] || die "repo alias required"
    awk -F '\t' -v key="$alias" '$1 == key { print $2; found=1; exit } END { if (!found) exit 1 }' "$REGISTRY" \
        || die "unknown repo alias: $alias"
}

default_branch_for() {
    local repo="$1"
    gh repo view "$repo" --json defaultBranchRef --jq '.defaultBranchRef.name'
}

validate_slug() {
    local slug="$1"
    [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
        || die "workflow slug must match: [a-z0-9][a-z0-9-]*"
}

render_trigger() {
    local trigger="$1"
    local base="$2"

    case "$trigger" in
        manual)
            cat <<'EOF'
on:
  workflow_dispatch:
EOF
            ;;
        push)
            cat <<EOF
on:
  push:
    branches:
      - $base
EOF
            ;;
        manual+push)
            cat <<EOF
on:
  workflow_dispatch:
  push:
    branches:
      - $base
EOF
            ;;
        *)
            die "unknown trigger: $trigger (use manual, push, or manual+push)"
            ;;
    esac
}

render_workflow() {
    local template="$1"
    local slug="$2"
    local trigger="$3"
    local base="$4"
    local title="${slug//-/ }"

    printf 'name: "PX / %s"\n\n' "$title"
    render_trigger "$trigger" "$base"

    case "$template" in
        smoke)
            cat <<'EOF'

permissions:
  contents: read

jobs:
  smoke:
    name: Repository smoke test
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Report execution identity
        run: |
          echo "repo=$GITHUB_REPOSITORY"
          echo "ref=$GITHUB_REF"
          echo "sha=$GITHUB_SHA"
          echo "PX workflow is alive."
EOF
            ;;
        shell-check)
            cat <<'EOF'

permissions:
  contents: read

jobs:
  shell-check:
    name: Shell syntax check
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Validate shell scripts
        shell: bash
        run: |
          mapfile -d '' scripts < <(find . -type f -name '*.sh' -print0)
          if ((${#scripts[@]} == 0)); then
            echo "No .sh files found; nothing to validate."
            exit 0
          fi

          printf 'Checking %d shell script(s)\n' "${#scripts[@]}"
          for script in "${scripts[@]}"; do
            echo "bash -n $script"
            bash -n "$script"
          done
EOF
            ;;
        *)
            die "unknown template: $template"
            ;;
    esac
}

validate_workflow() {
    local file="$1"

    if command -v actionlint >/dev/null 2>&1; then
        actionlint "$file"
        printf 'validation: PASS (actionlint)\n' >&2
        return
    fi

    if command -v toolbox >/dev/null 2>&1 \
        && toolbox run -c "$TOOLBOX_NAME" sh -lc 'command -v actionlint >/dev/null 2>&1' >/dev/null 2>&1; then
        toolbox run -c "$TOOLBOX_NAME" actionlint - < "$file"
        printf 'validation: PASS (actionlint via %s)\n' "$TOOLBOX_NAME" >&2
        return
    fi

    warn "actionlint unavailable; generated YAML was not semantically validated"
}

install_workflow() {
    local repo="$1"
    local base="$2"
    local slug="$3"
    local yaml_file="$4"
    local workflow_path=".github/workflows/${slug}.yml"
    local branch="automation/px-workflow-${slug}-$(date -u +%Y%m%d-%H%M%S)"
    local base_sha encoded pr_url

    need base64

    if gh api "repos/$repo/contents/$workflow_path?ref=$base" >/dev/null 2>&1; then
        die "$workflow_path already exists on $base; edit support is a later PX seam"
    fi

    base_sha="$(gh api "repos/$repo/git/ref/heads/$base" --jq '.object.sha')"
    [[ -n "$base_sha" ]] || die "could not resolve $repo@$base"

    gh api --method POST "repos/$repo/git/refs" \
        -f ref="refs/heads/$branch" \
        -f sha="$base_sha" >/dev/null

    encoded="$(base64 < "$yaml_file" | tr -d '\n')"

    gh api --method PUT "repos/$repo/contents/$workflow_path" \
        -f message="Add PX workflow: $slug" \
        -f content="$encoded" \
        -f branch="$branch" >/dev/null

    pr_url="$(gh pr create -R "$repo" \
        --base "$base" \
        --head "$branch" \
        --title "Add PX workflow: $slug" \
        --body "Generated by PX workflow factory. Previewed and validated before installation.")"

    printf 'installed: %s\n' "$workflow_path"
    printf 'branch: %s\n' "$branch"
    printf 'pull_request: %s\n' "$pr_url"
}

create_workflow() {
    local alias="${1:-}"
    local template="${2:-}"
    local slug="${3:-}"
    local trigger="${4:-manual}"
    local mode="${5:---preview}"
    local repo base tmp

    [[ -n "$alias" ]] || die "usage: px create <repo> <template> <slug> [trigger] [--preview|--install]"
    [[ -n "$template" ]] || die "template required"
    [[ -n "$slug" ]] || die "workflow slug required"
    validate_slug "$slug"

    case "$mode" in
        --preview|--install) ;;
        *) die "unknown create mode: $mode (use --preview or --install)" ;;
    esac

    need gh
    repo="$(repo_for "$alias")"
    base="$(default_branch_for "$repo")"
    [[ -n "$base" ]] || die "could not resolve default branch for $repo"

    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' RETURN
    render_workflow "$template" "$slug" "$trigger" "$base" > "$tmp"

    printf 'PX WORKFLOW CANDIDATE\n'
    printf 'repo: %s (%s)\n' "$alias" "$repo"
    printf 'base: %s\n' "$base"
    printf 'template: %s\n' "$template"
    printf 'slug: %s\n' "$slug"
    printf 'trigger: %s\n' "$trigger"
    printf 'path: .github/workflows/%s.yml\n' "$slug"
    printf '\n--- YAML ---\n'
    cat "$tmp"
    printf '%s\n' '--- END YAML ---'

    printf '\n--- VALIDATION ---\n' >&2
    validate_workflow "$tmp"

    if [[ "$mode" == "--install" ]]; then
        printf '\n--- INSTALL ---\n'
        install_workflow "$repo" "$base" "$slug" "$tmp"
    else
        printf '\npreview only: no repository changes made\n'
        printf 'install with: px create %s %s %s %s --install\n' \
            "$alias" "$template" "$slug" "$trigger"
    fi
}

templates() {
    cat <<'EOF'
[
  {
    "id": "smoke",
    "summary": "Checkout the repo and prove a GitHub runner can execute the workflow.",
    "mutates_repository": false
  },
  {
    "id": "shell-check",
    "summary": "Run bash -n against every .sh file in the repository.",
    "mutates_repository": false
  }
]
EOF
}

usage() {
    cat <<'EOF'
Post-Apollo PX control bus

Usage:
  px repos
  px doctor
  px workflows <repo>
  px runs <repo> [limit]
  px run <repo> <workflow> [ref]
  px watch <repo> <run-id>
  px rerun <repo> <run-id>
  px cancel <repo> <run-id>
  px templates
  px create <repo> <template> <slug> [trigger] [--preview|--install]

Workflow factory:
  trigger: manual | push | manual+push
  mode:    --preview (default) | --install

Examples:
  px workflows dev
  px run dev px-smoke.yml
  px templates
  px create dev smoke my-first-action
  px create dev shell-check shell-syntax manual --preview
  px create dev shell-check shell-syntax manual --install

Repo names are aliases from config/repos.tsv.
PX create previews by default. --install writes only to a new automation branch
and opens a pull request; it never writes a generated workflow directly to the
default branch.
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    repos)
        printf '%-12s %s\n' ALIAS REPOSITORY
        while IFS=$'\t' read -r alias repo; do
            [[ -z "$alias" || "$alias" == \#* ]] && continue
            printf '%-12s %s\n' "$alias" "$repo"
        done < "$REGISTRY"
        ;;

    doctor)
        need gh
        need awk
        printf 'registry: %s\n' "$REGISTRY"
        gh auth status
        ;;

    workflows)
        need gh
        repo="$(repo_for "${1:-}")"
        gh workflow list -R "$repo" --json id,name,path,state
        ;;

    runs)
        need gh
        repo="$(repo_for "${1:-}")"
        limit="${2:-$LIMIT}"
        gh run list -R "$repo" --limit "$limit" \
            --json databaseId,workflowName,status,conclusion,headBranch,createdAt
        ;;

    run)
        need gh
        repo="$(repo_for "${1:-}")"
        workflow="${2:-}"
        ref="${3:-}"
        [[ -n "$workflow" ]] || die "workflow required"

        if [[ -n "$ref" ]]; then
            gh workflow run "$workflow" -R "$repo" --ref "$ref"
        else
            gh workflow run "$workflow" -R "$repo"
        fi
        ;;

    watch)
        need gh
        repo="$(repo_for "${1:-}")"
        run_id="${2:-}"
        [[ -n "$run_id" ]] || die "run id required"
        gh run watch "$run_id" -R "$repo" --exit-status
        ;;

    rerun)
        need gh
        repo="$(repo_for "${1:-}")"
        run_id="${2:-}"
        [[ -n "$run_id" ]] || die "run id required"
        gh run rerun "$run_id" -R "$repo"
        ;;

    cancel)
        need gh
        repo="$(repo_for "${1:-}")"
        run_id="${2:-}"
        [[ -n "$run_id" ]] || die "run id required"
        gh run cancel "$run_id" -R "$repo"
        ;;

    templates)
        templates
        ;;

    create)
        create_workflow "$@"
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        usage >&2
        die "unknown command: $cmd"
        ;;
esac
