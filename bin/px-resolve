#!/usr/bin/env python3
"""PX cross-environment tool resolver.

Consumes the discovery registry produced by px-tools and chooses one exact
execution target using a small, deterministic preference policy.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
TOOLS = ROOT / "bin" / "px-tools"

POLICY = {
    "id": "host-first-v1",
    "description": (
        "Preserve normal host PATH behavior first; fall back to Toolbox only "
        "when the command is unavailable on the host."
    ),
    "backendPriority": ["native", "toolbox", "distrobox"],
}


def load_tools() -> dict:
    proc = subprocess.run(
        [sys.executable, str(TOOLS), "--json"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip()
        raise RuntimeError(detail or f"tool discovery exited {proc.returncode}")

    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"tool discovery returned invalid JSON: {exc}") from exc

    if not isinstance(payload, dict) or not isinstance(payload.get("tools"), list):
        raise RuntimeError("tool discovery payload is missing tools[]")

    return payload


def backend_rank(backend: str) -> int:
    try:
        return POLICY["backendPriority"].index(backend)
    except ValueError:
        return len(POLICY["backendPriority"]) + 10


def resolve(
    payload: dict,
    name: str,
    backend: str,
    environment: str,
) -> dict:
    candidates = [
        tool
        for tool in payload.get("tools", [])
        if str(tool.get("name") or "") == name
    ]

    if backend:
        candidates = [
            tool
            for tool in candidates
            if str(tool.get("backend") or "") == backend
        ]

    if environment:
        candidates = [
            tool
            for tool in candidates
            if str(tool.get("environment") or "") == environment
        ]

    candidates = sorted(
        enumerate(candidates),
        key=lambda pair: (
            backend_rank(str(pair[1].get("backend") or "")),
            pair[0],
        ),
    )
    candidates = [tool for _, tool in candidates]

    selected = candidates[0] if candidates else None

    if selected is None:
        reason = "NOT_FOUND"
    elif environment:
        reason = "FORCED_ENVIRONMENT"
    elif backend:
        reason = "FORCED_BACKEND"
    elif selected.get("backend") == "native":
        reason = "HOST_PATH"
    elif selected.get("backend") == "toolbox":
        reason = "TOOLBOX_FALLBACK"
    else:
        reason = "BACKEND_PRIORITY"

    return {
        "version": 1,
        "query": name,
        "status": "FOUND" if selected else "NOT_FOUND",
        "reason": reason,
        "policy": POLICY,
        "filters": {
            "backend": backend,
            "environment": environment,
        },
        "selected": selected,
        "candidates": candidates,
    }


def shell_join(parts: list[str]) -> str:
    out = []
    for part in parts:
        text = str(part)
        if text and all(ch.isalnum() or ch in "._/-:" for ch in text):
            out.append(text)
        else:
            out.append("'" + text.replace("'", "'\"'\"'") + "'")
    return " ".join(out)


def print_human(result: dict) -> None:
    print("PX TOOL RESOLVER")
    print()
    print(f"QUERY      {result['query']}")
    print(f"STATUS     {result['status']}")
    print(f"POLICY     {result['policy']['id']}")
    print(f"REASON     {result['reason']}")

    selected = result.get("selected")
    if not selected:
        print("SELECTED   NONE")
        return

    print(f"SELECTED   {selected['environment']}  {selected['path']}")
    print(f"INVOKE     {shell_join(selected.get('invocation') or [])}")
    print(f"CANDIDATES {len(result.get('candidates') or [])}")

    for candidate in result.get("candidates") or []:
        marker = "*" if candidate is selected else "-"
        print(
            f"  {marker} {candidate['environment']:<30} "
            f"{candidate['path']}"
        )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="px which",
        description="Resolve one executable across PX host/container environments",
    )
    parser.add_argument("name")
    parser.add_argument(
        "--backend",
        choices=("native", "toolbox", "distrobox"),
        default="",
    )
    parser.add_argument("--environment", default="")
    parser.add_argument("--json", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()

    try:
        payload = load_tools()
        result = resolve(
            payload,
            args.name,
            args.backend,
            args.environment,
        )
    except (OSError, RuntimeError) as exc:
        print(f"px which: {exc}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(result, sort_keys=True))
    else:
        print_human(result)

    return 0 if result["status"] == "FOUND" else 1


if __name__ == "__main__":
    raise SystemExit(main())
