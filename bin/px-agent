#!/usr/bin/env python3
import argparse
import json
import os
import signal
import time
import re
import selectors
import shutil
import subprocess
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DEFAULT_CONFIG = ROOT / "config" / "agent-providers.json"
PX = ROOT / "bin" / "px"


def provider_config_path() -> Path:
    override = os.environ.get("PX_AGENT_PROVIDER_CONFIG", "").strip()
    return Path(override).expanduser() if override else DEFAULT_CONFIG


def load_registry() -> dict:
    path = provider_config_path()
    try:
        payload = json.loads(path.read_text())
    except OSError as exc:
        raise RuntimeError(f"cannot read provider registry {path}: {exc}")
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"invalid provider registry {path}: {exc}")

    providers = payload.get("providers")
    if not isinstance(providers, dict):
        raise RuntimeError("provider registry has no providers object")
    return payload


def provider_record(provider_id: str) -> dict:
    registry = load_registry()
    providers = registry["providers"]
    record = providers.get(provider_id)
    if not isinstance(record, dict):
        raise RuntimeError(f"unknown agent provider: {provider_id}")
    return record


def resolve_command(command: str) -> str:
    command = str(command or "").strip()
    if not command:
        raise RuntimeError("provider command is empty")

    if "/" in command:
        path = Path(command).expanduser()
        if path.is_file() and os.access(path, os.X_OK):
            return str(path)
        raise RuntimeError(f"provider command is not executable: {path}")

    resolved = shutil.which(command)
    if not resolved:
        raise RuntimeError(f"provider command is unavailable: {command}")
    return resolved


def px_hospital(*args: str, stdin_text: str | None = None):
    proc = subprocess.run(
        [str(PX), "hospital", *args, "--json"],
        input=stdin_text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip()
        raise RuntimeError(detail or f"px hospital exited {proc.returncode}")
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"px hospital returned invalid JSON: {exc}")


def render_args(values, provider_session_id: str) -> list[str]:
    result = []
    for value in values:
        result.append(
            str(value).replace(
                "{provider_session_id}",
                provider_session_id,
            )
        )
    return result


def hermes_command_prefix(record: dict) -> list[str]:
    start_args = record.get("startArgs")
    if not isinstance(start_args, list):
        return []

    try:
        chat_index = [str(value) for value in start_args].index("chat")
    except ValueError:
        return []

    return [str(value) for value in start_args[:chat_index]]


def probe_hermes_capabilities(executable: str, record: dict) -> dict:
    command = [
        executable,
        *hermes_command_prefix(record),
        "chat",
        "--help",
    ]
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError(f"cannot inspect Hermes CLI capabilities: {exc}")

    help_text = (proc.stdout + "\n" + proc.stderr).lower()
    if proc.returncode != 0 and not help_text.strip():
        raise RuntimeError(
            f"Hermes CLI capability probe exited {proc.returncode}"
        )

    return {
        "stream_json": (
            "--format" in help_text
            and "stream-json" in help_text
        ),
        "query_file": "--query-file" in help_text,
        "resume": "--resume" in help_text or "-r" in help_text,
        "quiet_long": "--quiet" in help_text,
        "quiet_short": "-q" in help_text and "--quiet" in help_text,
    }


def build_hermes_turn(
    executable: str,
    record: dict,
    provider_session_id: str,
    prompt: str,
) -> tuple[list[str], str | None, str]:
    capabilities = probe_hermes_capabilities(executable, record)

    if capabilities["stream_json"]:
        template = (
            record.get("resumeArgs")
            if provider_session_id
            else record.get("startArgs")
        )
        if not isinstance(template, list) or not template:
            raise RuntimeError("Hermes provider registry has no stream command")
        return (
            [
                executable,
                *render_args(template, provider_session_id),
            ],
            prompt,
            "hermes-stream-json",
        )

    command = [
        executable,
        *hermes_command_prefix(record),
        "chat",
    ]

    if provider_session_id:
        if not capabilities["resume"]:
            raise RuntimeError(
                "installed Hermes CLI cannot resume sessions; "
                "upgrade Hermes before continuing this Room"
            )
        command.extend(["--resume", provider_session_id])

    if capabilities["quiet_long"]:
        command.append("--quiet")

    if capabilities["query_file"]:
        command.extend(["--query-file", "-"])
        provider_input = prompt
    else:
        # Older Hermes releases use -q as the one-shot query argument.
        command.extend(["-q", prompt])
        provider_input = None

    return command, provider_input, "hermes-text"


def parse_hermes_text(
    stdout: str,
    stderr: str,
) -> tuple[str, str, list[dict]]:
    session_pattern = re.compile(
        r"(?im)\bsession[_ -]?id\s*[:=]\s*([^\s]+)"
    )
    combined = "\n".join([stderr or "", stdout or ""])
    match = session_pattern.search(combined)
    provider_session_id = match.group(1).strip() if match else ""

    answer_lines = []
    for raw in (stdout or "").splitlines():
        line = raw.rstrip()
        if session_pattern.search(line):
            continue
        answer_lines.append(line)

    assistant = "\n".join(answer_lines).strip()
    normalized = [{
        "type": "result",
        "payload": {
            "session_id": provider_session_id,
            "text": assistant,
            "legacy_text": True,
        },
    }]
    return provider_session_id, assistant, normalized


def providers_payload() -> list[dict]:
    registry = load_registry()
    rows = []
    for provider_id, record in sorted(registry["providers"].items()):
        command = str(record.get("command") or "")
        try:
            endpoint = resolve_command(command)
            available = True
            error = ""
        except RuntimeError as exc:
            endpoint = ""
            available = False
            error = str(exc)

        rows.append({
            "id": provider_id,
            "name": str(record.get("name") or provider_id).upper(),
            "command": command,
            "endpoint": endpoint,
            "dialect": str(record.get("dialect") or ""),
            "available": available,
            "error": error,
        })
    return rows


def create_session(args) -> dict:
    provider_record(args.provider_id)
    session_id = (
        args.session_id.strip()
        if args.session_id
        else f"{args.room_id}-{uuid.uuid4()}"
    )
    px_hospital(
        "session-put",
        session_id,
        "--room-id", args.room_id,
        "--doctor-id", args.doctor_id,
        "--provider-id", args.provider_id,
        "--status", "IDLE",
    )
    return px_hospital(
        "session-runtime",
        session_id,
        "--working-directory", str(Path(args.working_directory).expanduser()),
        "--status", "IDLE",
        "--clear-error",
    )


def parse_codex(events: list[dict]) -> tuple[str, str, list[dict]]:
    provider_session_id = ""
    assistant_parts = []
    normalized = []

    for event in events:
        event_type = str(event.get("type") or "")
        if event_type == "thread.started":
            provider_session_id = str(event.get("thread_id") or "")
        elif event_type == "item.completed":
            item = event.get("item")
            if isinstance(item, dict) and item.get("type") == "agent_message":
                text = str(item.get("text") or "")
                if text:
                    assistant_parts.append(text)

        normalized.append({
            "type": event_type or "provider.event",
            "payload": event,
        })

    return provider_session_id, "\n".join(assistant_parts).strip(), normalized


def parse_hermes(events: list[dict]) -> tuple[str, str, list[dict]]:
    provider_session_id = ""
    text_parts = []
    final_text = ""
    normalized = []

    for event in events:
        event_type = str(event.get("type") or "")

        if event_type == "system" and event.get("subtype") == "init":
            provider_session_id = str(event.get("session_id") or "")
        elif event_type == "text":
            text = str(event.get("text") or "")
            if text:
                text_parts.append(text)
        elif event_type == "result":
            provider_session_id = (
                str(event.get("session_id") or "")
                or provider_session_id
            )
            final_text = str(event.get("text") or "").strip()

        normalized.append({
            "type": event_type or "provider.event",
            "payload": event,
        })

    assistant = final_text or "".join(text_parts).strip()
    return provider_session_id, assistant, normalized


def parse_jsonl(stdout: str, dialect: str):
    events = []
    for line_number, raw in enumerate(stdout.splitlines(), start=1):
        line = raw.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError as exc:
            raise RuntimeError(
                f"provider emitted invalid JSONL at line {line_number}: {exc}"
            )
        if not isinstance(event, dict):
            raise RuntimeError(
                f"provider JSONL event {line_number} is not an object"
            )
        events.append(event)

    if dialect == "codex-jsonl":
        return parse_codex(events)
    if dialect == "hermes-stream-json":
        return parse_hermes(events)
    raise RuntimeError(f"unsupported provider dialect: {dialect}")


def store_event(session_id: str, event_type: str, payload: dict) -> None:
    px_hospital(
        "event-append",
        "--session-id", session_id,
        "--event-type", event_type,
        "--payload", json.dumps(payload, sort_keys=True),
    )



def stream_activity_preview(value: str, limit: int = 1200) -> str:
    text = str(value or "").strip()
    if not text:
        return ""

    lines = [line.strip() for line in text.splitlines() if line.strip()]
    candidate = lines[-1] if lines else text

    try:
        payload = json.loads(candidate)
    except json.JSONDecodeError:
        payload = None

    if isinstance(payload, dict):
        for key in ("text", "message", "content", "status", "name"):
            value = payload.get(key)
            if isinstance(value, str) and value.strip():
                candidate = value.strip()
                break
        else:
            event_type = str(payload.get("type") or "").strip()
            subtype = str(payload.get("subtype") or "").strip()
            candidate = " // ".join(
                part for part in (event_type, subtype) if part
            ) or candidate

    if len(candidate) > limit:
        candidate = candidate[-limit:]
    return candidate


def latest_provider_activity(session_id: str) -> dict:
    events = px_hospital(
        "events",
        session_id,
        "--limit",
        "80",
    )

    for row in reversed(events):
        event_type = str(row.get("type") or "")
        payload = row.get("payload") or {}

        if event_type == "provider.stream":
            text = stream_activity_preview(payload.get("text") or "")
            if text:
                return {
                    "eventId": str(row.get("id") or ""),
                    "type": event_type,
                    "stream": str(payload.get("stream") or ""),
                    "text": text,
                    "createdAt": str(row.get("createdAt") or ""),
                    "sequence": int(payload.get("sequence") or 0),
                }

        if event_type in (
            "turn.started",
            "turn.failed",
            "turn.cancelled",
            "turn.completed",
        ):
            label = event_type.replace("turn.", "").upper()
            return {
                "eventId": str(row.get("id") or ""),
                "type": event_type,
                "stream": "",
                "text": label,
                "createdAt": str(row.get("createdAt") or ""),
                "sequence": 0,
            }

    return {}


def communicate_with_activity(
    proc: subprocess.Popen,
    provider_input: str,
    timeout: int,
    session_id: str,
) -> tuple[str, str]:
    stdout_buffer = bytearray()
    stderr_buffer = bytearray()
    buffers = {
        "stdout": stdout_buffer,
        "stderr": stderr_buffer,
    }

    try:
        if proc.stdin is not None:
            proc.stdin.write(provider_input)
            proc.stdin.flush()
    except BrokenPipeError:
        pass
    finally:
        if proc.stdin is not None:
            try:
                proc.stdin.close()
            except OSError:
                pass

    selector = selectors.DefaultSelector()
    for name, pipe in (
        ("stdout", proc.stdout),
        ("stderr", proc.stderr),
    ):
        if pipe is None:
            continue
        fd = pipe.fileno()
        os.set_blocking(fd, False)
        selector.register(fd, selectors.EVENT_READ, data=name)

    deadline = time.monotonic() + max(1, int(timeout))
    sequence = 0

    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(
                    proc.args,
                    timeout,
                    output=stdout_buffer.decode(
                        "utf-8",
                        errors="replace",
                    ),
                    stderr=stderr_buffer.decode(
                        "utf-8",
                        errors="replace",
                    ),
                )

            ready = selector.select(timeout=min(0.25, remaining))
            if not ready:
                continue

            for key, _ in ready:
                try:
                    chunk = os.read(key.fd, 65536)
                except BlockingIOError:
                    continue

                if not chunk:
                    selector.unregister(key.fd)
                    continue

                stream_name = str(key.data)
                buffers[stream_name].extend(chunk)

                preview = stream_activity_preview(
                    chunk.decode("utf-8", errors="replace")
                )
                if preview:
                    sequence += 1
                    store_event(
                        session_id,
                        "provider.stream",
                        {
                            "stream": stream_name,
                            "text": preview,
                            "sequence": sequence,
                            "byteCount": len(chunk),
                        },
                    )

        remaining = max(0.05, deadline - time.monotonic())
        proc.wait(timeout=remaining)
    finally:
        selector.close()

    return (
        stdout_buffer.decode("utf-8", errors="replace"),
        stderr_buffer.decode("utf-8", errors="replace"),
    )

def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def elapsed_seconds(started_at: str) -> int:
    value = str(started_at or "").strip()
    if not value:
        return 0

    try:
        started = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return 0

    if started.tzinfo is None:
        started = started.replace(tzinfo=timezone.utc)

    return max(
        0,
        int((datetime.now(timezone.utc) - started).total_seconds()),
    )


def status_payload(session_id: str) -> dict:
    session = px_hospital("session", session_id)
    return {
        "session": session,
        "status": str(session.get("status") or "IDLE"),
        "lastActivity": latest_provider_activity(session_id),
        "activePid": int(session.get("activePid") or 0),
        "turnStartedAt": str(session.get("turnStartedAt") or ""),
        "elapsedSeconds": elapsed_seconds(
            str(session.get("turnStartedAt") or "")
        ),
        "operating": (
            str(session.get("status") or "").upper() == "OPERATING"
            and int(session.get("activePid") or 0) > 0
        ),
    }


def terminate_process_group(pid: int, grace_seconds: float = 1.5) -> bool:
    if pid <= 0:
        return False

    try:
        os.killpg(pid, signal.SIGTERM)
    except ProcessLookupError:
        return False

    deadline = time.monotonic() + grace_seconds
    while time.monotonic() < deadline:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return True
        time.sleep(0.05)

    try:
        os.killpg(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    return True


def cancel_session(args) -> dict:
    session = px_hospital("session", args.session_id)
    active_pid = int(session.get("activePid") or 0)
    status = str(session.get("status") or "").upper()

    if status != "OPERATING" or active_pid <= 0:
        return {
            "cancelled": False,
            "reason": "NOT_OPERATING",
            "session": session,
        }

    updated = px_hospital(
        "session-runtime",
        args.session_id,
        "--status", "PAUSED",
        "--clear-active-pid",
        "--clear-turn-started",
        "--clear-error",
    )

    signalled = terminate_process_group(active_pid)

    store_event(
        args.session_id,
        "turn.cancelled",
        {
            "activePid": active_pid,
            "signalled": signalled,
            "reason": args.reason,
        },
    )

    return {
        "cancelled": True,
        "signalled": signalled,
        "reason": args.reason,
        "session": updated,
    }


CONTEXT_VERSION = 2
PATIENT_CHART_LIMIT = 6
ROOM_CHART_LIMIT = 10
RECENT_MESSAGE_LIMIT = 6
CONTEXT_ITEM_TEXT_LIMIT = 900
CONTEXT_CHANGED_FILE_LIMIT = 40
HISTORY_MESSAGE_POOL_LIMIT = 80
HISTORY_CHECKPOINT_POOL_LIMIT = 40
HISTORY_REPORT_POOL_LIMIT = 30
RETRIEVED_HISTORY_LIMIT = 6
RETRIEVAL_TOKEN_MIN_LENGTH = 3


def clip_context_text(value, limit: int = CONTEXT_ITEM_TEXT_LIMIT) -> str:
    text = str(value or "").strip()
    if len(text) <= limit:
        return text
    return text[: max(0, limit - 3)].rstrip() + "..."


def context_query_tokens(value: str) -> set[str]:
    text = str(value or "").lower()
    token = ""
    tokens = set()
    for char in text:
        if char.isalnum() or char in ("_", "-", "/"):
            token += char
            continue
        if len(token) >= RETRIEVAL_TOKEN_MIN_LENGTH:
            tokens.add(token)
        token = ""
    if len(token) >= RETRIEVAL_TOKEN_MIN_LENGTH:
        tokens.add(token)
    return tokens


def historical_context_score(query_tokens: set[str], text: str) -> int:
    if not query_tokens:
        return 0
    item_tokens = context_query_tokens(text)
    if not item_tokens:
        return 0
    overlap = query_tokens.intersection(item_tokens)
    if not overlap:
        return 0
    score = len(overlap) * 10
    for value in overlap:
        if "/" in value or "_" in value or "-" in value:
            score += 2
    return score


def select_relevant_room_history(
    room_id: str,
    query_text: str,
    recent_messages: list,
) -> list[dict]:
    query_tokens = context_query_tokens(query_text)
    if not query_tokens:
        return []

    recent_ids = {
        str(row.get("id") or "")
        for row in recent_messages
        if row.get("id")
    }
    candidates = []

    messages = px_hospital(
        "messages",
        room_id,
        "--limit", str(HISTORY_MESSAGE_POOL_LIMIT),
    )
    for row in messages:
        item_id = str(row.get("id") or "")
        if not item_id or item_id in recent_ids:
            continue
        body = str(row.get("body") or "")
        score = historical_context_score(query_tokens, body)
        if score <= 0:
            continue
        candidates.append({
            "type": "MESSAGE",
            "id": item_id,
            "title": str(row.get("authorRole") or "message").upper(),
            "body": body,
            "createdAt": str(row.get("createdAt") or ""),
            "score": score,
        })

    checkpoints = px_hospital(
        "checkpoints",
        room_id,
        "--limit", str(HISTORY_CHECKPOINT_POOL_LIMIT),
    )
    for row in checkpoints:
        body = str(row.get("body") or "")
        title = str(row.get("kind") or "CHECKPOINT")
        score = historical_context_score(
            query_tokens,
            title + "\n" + body,
        )
        if score <= 0:
            continue
        candidates.append({
            "type": "CHECKPOINT",
            "id": str(row.get("id") or ""),
            "title": title,
            "body": body,
            "createdAt": str(row.get("createdAt") or ""),
            "score": score + 2,
        })

    reports = px_hospital(
        "room-reports",
        room_id,
        "--limit", str(HISTORY_REPORT_POOL_LIMIT),
    )
    for row in reports:
        title = str(row.get("title") or row.get("kind") or "ROOM REPORT")
        body = str(row.get("body") or "")
        score = historical_context_score(
            query_tokens,
            title + "\n" + body,
        )
        if score <= 0:
            continue
        candidates.append({
            "type": "ROOM_REPORT",
            "id": str(row.get("id") or ""),
            "title": title,
            "body": body,
            "createdAt": str(row.get("createdAt") or ""),
            "score": score + 4,
        })

    candidates.sort(
        key=lambda row: (
            int(row.get("score") or 0),
            str(row.get("createdAt") or ""),
            str(row.get("id") or ""),
        ),
        reverse=True,
    )
    return candidates[:RETRIEVED_HISTORY_LIMIT]


def live_context_payload(
    session_id: str,
    working_directory: str = "",
    query_text: str = "",
) -> dict:
    session = px_hospital("session", session_id)
    room_id = str(session.get("roomId") or "")
    room = px_hospital("room", room_id)
    patient_id = str(room.get("patientId") or "")
    assignment_id = str(room.get("assignmentId") or "")
    assignment = (
        px_hospital("assignment", assignment_id)
        if assignment_id
        else {}
    )
    cwd_text = (
        str(working_directory or "").strip()
        or str(session.get("workingDirectory") or "").strip()
        or str(room.get("bedPath") or "").strip()
    )

    if patient_id:
        patient_chart = px_hospital(
            "chart-entries",
            "--scope", "PATIENT",
            "--patient-id", patient_id,
            "--status", "ACTIVE",
            "--limit", str(PATIENT_CHART_LIMIT),
        )
    else:
        patient_chart = []

    room_chart = px_hospital(
        "chart-entries",
        "--scope", "ROOM",
        "--room-id", room_id,
        "--status", "ACTIVE",
        "--limit", str(ROOM_CHART_LIMIT),
    )

    recent_messages = px_hospital(
        "messages",
        room_id,
        "--limit", str(RECENT_MESSAGE_LIMIT),
    )

    retrieval_query = "\n".join(
        value
        for value in (
            str(query_text or "").strip(),
            str(assignment.get("title") or "").strip(),
            str(assignment.get("goal") or "").strip(),
            str(assignment.get("openQuestions") or "").strip(),
        )
        if value
    )
    retrieved_context = select_relevant_room_history(
        room_id,
        retrieval_query,
        recent_messages,
    )

    git_evidence = collect_git_report_evidence(cwd_text)

    return {
        "version": CONTEXT_VERSION,
        "generatedAt": now_iso(),
        "session": {
            "id": str(session.get("id") or session_id),
            "roomId": room_id,
            "doctorId": str(session.get("doctorId") or ""),
            "providerId": str(session.get("providerId") or ""),
            "providerSessionId": str(
                session.get("providerSessionId") or ""
            ),
            "status": str(session.get("status") or ""),
            "workingDirectory": cwd_text,
        },
        "room": {
            "id": room_id,
            "team": str(room.get("team") or ""),
            "branch": str(room.get("branch") or ""),
            "patientId": patient_id,
            "patientLabel": str(room.get("patientLabel") or ""),
            "repository": str(room.get("repository") or ""),
            "assignmentId": str(room.get("assignmentId") or ""),
        },
        "assignment": assignment,
        "git": git_evidence,
        "patientChart": patient_chart,
        "roomChart": room_chart,
        "recentMessages": recent_messages,
        "retrievedContext": retrieved_context,
    }


def render_chart_context(title: str, entries: list) -> list[str]:
    lines = [title]
    if not entries:
        lines.append("- NONE")
        return lines

    for entry in entries:
        entry_id = str(entry.get("id") or "?")
        priority = int(entry.get("priority") or 0)
        kind = str(entry.get("kind") or "NOTE")
        label = str(entry.get("title") or "").strip()
        body = clip_context_text(entry.get("body") or "")
        prefix = f"- [#{entry_id} P{priority} {kind}]"
        if label:
            prefix += " " + label
        lines.append(prefix)
        if body:
            lines.append("  " + body.replace("\n", "\n  "))
    return lines


def render_live_context(payload: dict) -> str:
    session = payload.get("session") or {}
    room = payload.get("room") or {}
    git = payload.get("git") or {}
    assignment = payload.get("assignment") or {}
    recent = payload.get("recentMessages") or []
    retrieved = payload.get("retrievedContext") or []

    lines = [
        "HOSPITAL LIVE CONTEXT // GENERATED",
        (
            "This block is runtime context, not an operator message. "
            "Fresh Git evidence overrides historical Chart or Report claims."
        ),
        "",
        "IDENTITY",
        "ROOM: " + str(room.get("id") or ""),
        "TEAM: " + str(room.get("team") or ""),
        "PATIENT: " + str(room.get("patientId") or ""),
        "REPOSITORY: " + str(room.get("repository") or ""),
        "DOCTOR: " + str(session.get("doctorId") or ""),
        "PROVIDER: " + str(session.get("providerId") or ""),
        "ASSIGNMENT: " + str(room.get("assignmentId") or ""),
        "BED: " + str(session.get("workingDirectory") or ""),
        "",
        "CURRENT ASSIGNMENT // SUPERVISED ORDER",
        "STATUS: " + str(assignment.get("status") or "NONE"),
        "PHASE: " + str(assignment.get("phase") or ""),
        "TITLE: " + str(assignment.get("title") or ""),
        "GOAL:",
        clip_context_text(assignment.get("goal") or "NONE"),
        "CONSTRAINTS:",
        clip_context_text(assignment.get("constraints") or "NONE"),
        "DEFINITION OF DONE:",
        clip_context_text(assignment.get("definitionOfDone") or "NONE"),
        "PERMISSIONS: "
        + (
            ", ".join(
                str(value)
                for value in (assignment.get("permissions") or [])
            )
            or "READ"
        ),
        "CHECKLIST:",
        clip_context_text(assignment.get("checklist") or "NONE"),
        "OPEN QUESTIONS:",
        clip_context_text(assignment.get("openQuestions") or "NONE"),
        "",
        "LIVE GIT",
        "EVIDENCE: " + str(git.get("status") or "UNAVAILABLE"),
        "BRANCH: " + str(git.get("branch") or ""),
        "HEAD: " + str(git.get("headSha") or ""),
        "DIRTY: " + ("YES" if git.get("dirty") else "NO"),
        (
            "CHANGED FILES: "
            + (
                ", ".join(
                    str(value)
                    for value in (
                        git.get("changedFiles") or []
                    )[:CONTEXT_CHANGED_FILE_LIMIT]
                )
                or "NONE"
            )
            + (
                " // +"
                + str(
                    max(
                        0,
                        len(git.get("changedFiles") or [])
                        - CONTEXT_CHANGED_FILE_LIMIT,
                    )
                )
                + " MORE"
                if len(git.get("changedFiles") or [])
                   > CONTEXT_CHANGED_FILE_LIMIT
                else ""
            )
        ),
        (
            "DIFF STAT: +"
            + str(int(git.get("insertions") or 0))
            + " / -"
            + str(int(git.get("deletions") or 0))
        ),
        "",
    ]

    lines.extend(
        render_chart_context(
            "PATIENT CHART // ACTIVE",
            payload.get("patientChart") or [],
        )
    )
    lines.append("")
    lines.extend(
        render_chart_context(
            "ROOM CHART // ACTIVE",
            payload.get("roomChart") or [],
        )
    )
    lines.extend(["", "RECENT CANONICAL TRANSCRIPT"])

    if recent:
        for message in recent:
            role = str(message.get("authorRole") or "unknown").upper()
            message_id = str(message.get("id") or "?")
            body = clip_context_text(message.get("body") or "")
            lines.append(f"- [#{message_id} {role}] {body}")
    else:
        lines.append("- NONE")

    lines.extend(["", "RETRIEVED ROOM HISTORY // RELEVANCE"])
    if retrieved:
        for item in retrieved:
            item_type = str(item.get("type") or "HISTORY")
            item_id = str(item.get("id") or "?")
            title = str(item.get("title") or "").strip()
            score = int(item.get("score") or 0)
            body = clip_context_text(item.get("body") or "")
            heading = f"- [{item_type} #{item_id} SCORE {score}]"
            if title:
                heading += " " + title
            lines.append(heading)
            if body:
                lines.append("  " + body.replace("\n", "\n  "))
    else:
        lines.append("- NONE")

    lines.extend([
        "",
        "AUTHORITY",
        "- Supervised operation: stay within the current Room assignment.",
        "- Never treat a saved Chart/Report Git claim as current truth.",
        "- Reacquire live state before consequential Git claims or edits.",
        "- Surface blockers, ambiguity, or authority boundaries to the operator.",
    ])

    return "\n".join(lines).strip()


def context_summary(payload: dict) -> dict:
    git = payload.get("git") or {}
    assignment = payload.get("assignment") or {}
    return {
        "version": int(payload.get("version") or CONTEXT_VERSION),
        "assignmentId": str(assignment.get("id") or ""),
        "assignmentStatus": str(assignment.get("status") or ""),
        "assignmentPhase": str(assignment.get("phase") or ""),
        "assignmentPermissions": list(
            assignment.get("permissions") or []
        ),
        "patientChartEntryIds": [
            str(row.get("id") or "")
            for row in (payload.get("patientChart") or [])
            if row.get("id")
        ],
        "roomChartEntryIds": [
            str(row.get("id") or "")
            for row in (payload.get("roomChart") or [])
            if row.get("id")
        ],
        "recentMessageIds": [
            str(row.get("id") or "")
            for row in (payload.get("recentMessages") or [])
            if row.get("id")
        ],
        "retrievedContextRefs": [
            (
                str(row.get("type") or "HISTORY")
                + ":"
                + str(row.get("id") or "")
            )
            for row in (payload.get("retrievedContext") or [])
            if row.get("id")
        ],
        "gitEvidenceStatus": str(git.get("status") or "UNAVAILABLE"),
        "gitBranch": str(git.get("branch") or ""),
        "gitHeadSha": str(git.get("headSha") or ""),
        "gitDirty": bool(git.get("dirty")),
    }


def provider_prompt_for_turn(
    prompt: str,
    context: dict,
    supplemental_context: str = "",
) -> str:
    parts = [render_live_context(context)]
    supplemental = str(supplemental_context or "").strip()
    if supplemental:
        parts.extend([
            "",
            "SUPPLEMENTAL TURN CONTEXT",
            supplemental,
        ])
    parts.extend([
        "",
        "OPERATOR TURN",
        str(prompt or "").strip(),
    ])
    return "\n".join(parts).strip()


def run_turn(args) -> dict:
    session = px_hospital("session", args.session_id)
    provider_id = str(session.get("providerId") or "").strip()
    if not provider_id:
        raise RuntimeError("Hospital session has no provider")

    record = provider_record(provider_id)
    executable = resolve_command(str(record.get("command") or ""))
    dialect = str(record.get("dialect") or "").strip()
    cwd_text = (
        args.working_directory
        or str(session.get("workingDirectory") or "")
    ).strip()
    if not cwd_text:
        raise RuntimeError("Hospital session has no working directory")

    cwd = Path(cwd_text).expanduser()
    if not cwd.is_dir():
        raise RuntimeError(f"Hospital session Bed does not exist: {cwd}")

    if args.prompt_json_stdin:
        raw = sys.stdin.readline()
        try:
            frame = json.loads(raw)
        except json.JSONDecodeError as exc:
            raise RuntimeError(f"invalid agent prompt frame: {exc}")
        if not isinstance(frame, dict):
            raise RuntimeError("agent prompt frame must be a JSON object")
        prompt = str(frame.get("prompt") or "")
    elif args.prompt_stdin:
        prompt = sys.stdin.read()
    else:
        prompt = args.prompt or ""
    if not prompt.strip():
        raise RuntimeError("agent turn prompt is empty")

    provider_session_id = str(
        session.get("providerSessionId") or ""
    ).strip()

    context = live_context_payload(
        args.session_id,
        str(cwd),
        prompt,
    )
    supplemental_context = str(
        getattr(args, "supplemental_context", "") or ""
    )
    provider_prompt = provider_prompt_for_turn(
        prompt,
        context,
        supplemental_context,
    )
    provider_input = provider_prompt
    effective_dialect = dialect

    if dialect == "hermes-auto":
        command, provider_input, effective_dialect = build_hermes_turn(
            executable,
            record,
            provider_session_id,
            provider_prompt,
        )
    else:
        if provider_session_id:
            template = record.get("resumeArgs")
        else:
            template = record.get("startArgs")

        if not isinstance(template, list) or not template:
            raise RuntimeError(
                f"provider {provider_id} has no "
                f"{'resumeArgs' if provider_session_id else 'startArgs'}"
            )

        command = [
            executable,
            *render_args(template, provider_session_id),
        ]

    operator_message = px_hospital(
        "message-append",
        "--room-id", str(session["roomId"]),
        "--session-id", args.session_id,
        "--author-role", "operator",
        "--author-id", args.author_id,
        "--direction", "outgoing",
        "--message-type", args.message_type,
        "--body-stdin",
        stdin_text=prompt,
    )
    store_event(
        args.session_id,
        "turn.context",
        context_summary(context),
    )
    store_event(
        args.session_id,
        "turn.started",
        {
            "providerId": provider_id,
            "resume": bool(provider_session_id),
            "workingDirectory": str(cwd),
            "contextVersion": CONTEXT_VERSION,
        },
    )

    try:
        proc = subprocess.Popen(
            command,
            text=True,
            cwd=str(cwd),
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
    except OSError as exc:
        px_hospital(
            "session-runtime",
            args.session_id,
            "--status", "FAILED",
            "--clear-active-pid",
            "--clear-turn-started",
            "--last-error", f"provider launch failed: {exc}",
        )
        store_event(
            args.session_id,
            "turn.failed",
            {"reason": "launch-failed", "detail": str(exc)},
        )
        raise RuntimeError(f"provider launch failed: {exc}") from exc

    turn_started_at = now_iso()
    px_hospital(
        "session-runtime",
        args.session_id,
        "--working-directory", str(cwd),
        "--status", "OPERATING",
        "--active-pid", str(proc.pid),
        "--turn-started-at", turn_started_at,
        "--clear-error",
    )

    try:
        stdout_text, stderr_text = communicate_with_activity(
            proc,
            provider_input,
            args.timeout,
            args.session_id,
        )
    except subprocess.TimeoutExpired as exc:
        terminate_process_group(proc.pid)
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            pass
        stdout_text = str(exc.output or "")
        stderr_text = str(exc.stderr or "")
        px_hospital(
            "session-runtime",
            args.session_id,
            "--status", "FAILED",
            "--last-exit-code", "124",
            "--clear-active-pid",
            "--clear-turn-started",
            "--last-error", f"provider turn timed out after {args.timeout}s",
        )
        store_event(
            args.session_id,
            "turn.failed",
            {"reason": "timeout", "timeoutSeconds": args.timeout},
        )
        raise RuntimeError(
            f"provider turn timed out after {args.timeout}s"
        ) from exc

    current_session = px_hospital("session", args.session_id)
    if str(current_session.get("status") or "").upper() == "PAUSED":
        return {
            "session": current_session,
            "providerId": provider_id,
            "providerSessionId": provider_session_id,
            "assistant": "",
            "operatorMessageId": str(operator_message.get("id") or ""),
            "assistantMessageId": "",
            "eventCount": 0,
            "context": context_summary(context),
            "stderr": stderr_text.strip(),
            "cancelled": True,
        }

    observed_id = ""
    assistant = ""
    normalized_events = []
    parse_error = ""

    try:
        if effective_dialect == "hermes-text":
            observed_id, assistant, normalized_events = parse_hermes_text(
                stdout_text,
                stderr_text,
            )
        else:
            observed_id, assistant, normalized_events = parse_jsonl(
                stdout_text,
                effective_dialect,
            )
    except RuntimeError as exc:
        parse_error = str(exc)

    for event in normalized_events:
        store_event(
            args.session_id,
            f"provider.{event['type']}",
            event["payload"],
        )

    if provider_session_id and observed_id and observed_id != provider_session_id:
        detail = (
            "provider resumed with a different session id: "
            f"expected {provider_session_id}, got {observed_id}"
        )
        px_hospital(
            "session-runtime",
            args.session_id,
            "--status", "FAILED",
            "--last-exit-code", str(proc.returncode),
            "--clear-active-pid",
            "--clear-turn-started",
            "--last-error", detail,
        )
        store_event(
            args.session_id,
            "turn.failed",
            {
                "reason": "provider-session-mismatch",
                "expected": provider_session_id,
                "observed": observed_id,
            },
        )
        raise RuntimeError(detail)

    effective_id = observed_id or provider_session_id

    if proc.returncode != 0 or parse_error or not assistant:
        detail = (
            parse_error
            or stderr_text.strip()
            or (
                "provider returned no assistant text"
                if not assistant
                else f"provider exited {proc.returncode}"
            )
        )
        update_args = [
            "session-runtime",
            args.session_id,
            "--status", "FAILED",
            "--last-exit-code", str(proc.returncode),
            "--clear-active-pid",
            "--clear-turn-started",
            "--last-error", detail,
        ]
        if effective_id:
            update_args.extend([
                "--provider-session-id",
                effective_id,
            ])
        px_hospital(*update_args)
        store_event(
            args.session_id,
            "turn.failed",
            {
                "reason": detail,
                "exitCode": proc.returncode,
                "stderr": stderr_text[-4000:],
            },
        )
        raise RuntimeError(detail)

    doctor_message = px_hospital(
        "message-append",
        "--room-id", str(session["roomId"]),
        "--session-id", args.session_id,
        "--author-role", "doctor",
        "--author-id", str(session.get("doctorId") or "doctor"),
        "--direction", "incoming",
        "--message-type", "chat",
        "--body-stdin",
        stdin_text=assistant,
    )

    update_args = [
        "session-runtime",
        args.session_id,
        "--working-directory", str(cwd),
        "--status", "WAITING",
        "--last-exit-code", str(proc.returncode),
        "--clear-active-pid",
        "--clear-turn-started",
        "--clear-error",
    ]
    if effective_id:
        update_args.extend([
            "--provider-session-id",
            effective_id,
        ])
    updated = px_hospital(*update_args)

    store_event(
        args.session_id,
        "turn.completed",
        {
            "providerId": provider_id,
            "providerSessionId": effective_id,
            "exitCode": proc.returncode,
        },
    )

    return {
        "session": updated,
        "providerId": provider_id,
        "providerSessionId": effective_id,
        "assistant": assistant,
        "operatorMessageId": str(operator_message.get("id") or ""),
        "assistantMessageId": str(doctor_message.get("id") or ""),
        "eventCount": len(normalized_events),
        "context": context_summary(context),
        "stderr": stderr_text.strip(),
    }


def git_capture(cwd: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", *args],
        cwd=str(cwd),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=15,
        check=False,
    )


def collect_git_report_evidence(cwd_text: str) -> dict:
    cwd = Path(str(cwd_text or "")).expanduser()

    unavailable = {
        "status": "UNAVAILABLE",
        "branch": "",
        "headSha": "",
        "dirty": False,
        "changedFiles": [],
        "insertions": 0,
        "deletions": 0,
    }

    if not cwd.is_dir():
        return unavailable

    try:
        inside = git_capture(cwd, "rev-parse", "--is-inside-work-tree")
    except (OSError, subprocess.TimeoutExpired):
        return unavailable

    if inside.returncode != 0 or inside.stdout.strip() != "true":
        return unavailable

    try:
        head = git_capture(cwd, "rev-parse", "HEAD")
        branch = git_capture(cwd, "rev-parse", "--abbrev-ref", "HEAD")
        tracked = subprocess.run(
            ["git", "diff", "--name-only", "-z", "HEAD"],
            cwd=str(cwd),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=15,
            check=False,
        )
        untracked = subprocess.run(
            ["git", "ls-files", "--others", "--exclude-standard", "-z"],
            cwd=str(cwd),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=15,
            check=False,
        )
        numstat = git_capture(cwd, "diff", "--numstat", "HEAD")
    except (OSError, subprocess.TimeoutExpired):
        return unavailable

    if (
        head.returncode != 0
        or branch.returncode != 0
        or tracked.returncode != 0
        or untracked.returncode != 0
        or numstat.returncode != 0
    ):
        return unavailable

    tracked_files = [
        value.decode("utf-8", errors="replace")
        for value in tracked.stdout.split(b"\0")
        if value
    ]
    untracked_files = [
        value.decode("utf-8", errors="replace")
        for value in untracked.stdout.split(b"\0")
        if value
    ]
    changed_files = sorted(set(tracked_files + untracked_files))

    insertions = 0
    deletions = 0
    for raw in numstat.stdout.splitlines():
        parts = raw.split("\t", 2)
        if len(parts) < 2:
            continue
        added, removed = parts[0], parts[1]
        if added.isdigit():
            insertions += int(added)
        if removed.isdigit():
            deletions += int(removed)

    return {
        "status": "VERIFIED",
        "branch": branch.stdout.strip(),
        "headSha": head.stdout.strip(),
        "dirty": bool(changed_files),
        "changedFiles": changed_files,
        "insertions": insertions,
        "deletions": deletions,
    }


QUICK_PROMPTS = {
    "CONTINUE": (
        "QUICK // CONTINUE\n"
        "Continue the current Room assignment from the present state. "
        "Preserve existing constraints and decisions. Surface the next "
        "meaningful checkpoint or any blocker."
    ),
    "REPORT": (
        "QUICK // REPORT\n"
        "Produce a concise Doctor Note for the current Room. Use these exact "
        "Markdown section headings, in this order:\n"
        "## IMPLEMENTATION\n"
        "## HOW TO USE\n"
        "## VERIFY\n"
        "## WATCH OUT FOR\n"
        "## CHECKLIST\n"
        "## NEXT\n"
        "## DECISIONS\n"
        "State NONE when a section has nothing material to report. "
        "Do not invent Git facts such as branch, HEAD, or changed-file counts; "
        "PX records deterministic Git evidence separately. "
        "Do not start unrelated work."
    ),
    "CHECKLIST": (
        "QUICK // CHECKLIST\n"
        "Return the current assignment checklist with done, in-progress, "
        "blocked, and remaining items. Do not start unrelated work."
    ),
    "NEXT": (
        "QUICK // NEXT\n"
        "State the next concrete action for this Room and, if it is safe "
        "within the current assignment, perform that next action. Surface "
        "any blocker instead of expanding scope."
    ),
    "SUGGEST": (
        "QUICK // SUGGEST MEMORY\n"
        "Review the current Room, active Patient/Room Chart, recent transcript, "
        "and current assignment. Propose at most one durable memory that would "
        "be genuinely useful on a future Doctor turn. Do not write the Chart. "
        "If nothing deserves durable memory, reply exactly NONE. Otherwise "
        "reply using this exact format:\n"
        "MEMORY_SUGGESTION\n"
        "SCOPE: ROOM or PATIENT\n"
        "KIND: NOTE, DECISION, CONSTRAINT, INVARIANT, or QUESTION\n"
        "TITLE: concise title\n"
        "PRIORITY: integer 0-100\n"
        "BODY:\n"
        "durable memory text\n"
        "Prefer ROOM for assignment/task-specific knowledge and PATIENT for "
        "repository-wide institutional knowledge. Never claim that a proposal "
        "has already been promoted into durable memory."
    ),
}


def parse_memory_suggestion(text: str) -> dict | None:
    raw = str(text or "").strip()
    if not raw:
        return None

    if raw.upper() == "NONE":
        return None

    lines = raw.splitlines()
    fields = {}
    body_lines = []
    reading_body = False

    for line in lines:
        stripped = line.strip()
        if stripped.upper() == "MEMORY_SUGGESTION":
            continue
        if reading_body:
            body_lines.append(line)
            continue
        if stripped.upper() == "BODY:":
            reading_body = True
            continue
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        fields[key.strip().upper()] = value.strip()

    body = "\n".join(body_lines).strip()
    if not body:
        body = raw

    scope = str(fields.get("SCOPE") or "ROOM").upper()
    if scope not in ("ROOM", "PATIENT"):
        scope = "ROOM"

    kind = str(fields.get("KIND") or "NOTE").upper()
    if kind not in (
        "NOTE", "DECISION", "CONSTRAINT", "INVARIANT", "QUESTION"
    ):
        kind = "NOTE"

    try:
        priority = int(fields.get("PRIORITY") or 50)
    except (TypeError, ValueError):
        priority = 50
    priority = max(0, min(100, priority))

    return {
        "scope": scope,
        "kind": kind,
        "title": str(fields.get("TITLE") or "Doctor memory suggestion"),
        "priority": priority,
        "body": body,
    }


def pause_session(session_id: str) -> dict:
    status = status_payload(session_id)

    if status["operating"]:
        result = cancel_session(
            argparse.Namespace(
                session_id=session_id,
                reason="PAUSE",
            )
        )
        result["paused"] = True
        return result

    session = px_hospital(
        "session-runtime",
        session_id,
        "--status", "PAUSED",
        "--clear-active-pid",
        "--clear-turn-started",
        "--clear-error",
    )
    store_event(
        session_id,
        "session.paused",
        {"reason": "OPERATOR"},
    )
    return {
        "paused": True,
        "cancelled": False,
        "session": session,
    }


def run_quick(args) -> dict:
    command = str(args.quick_command or "").strip().upper()

    if command == "GO":
        command = "CONTINUE"

    if command == "STATUS":
        return {
            "command": command,
            "status": status_payload(args.session_id),
        }

    if command == "PAUSE":
        return {
            "command": command,
            "result": pause_session(args.session_id),
        }

    prompt = QUICK_PROMPTS.get(command)
    if not prompt:
        allowed = [
            "GO", "CONTINUE", "STATUS", "REPORT",
            "CHECKLIST", "NEXT", "SUGGEST", "PAUSE",
        ]
        raise RuntimeError(
            "unknown quick command: "
            + command
            + " (expected "
            + ", ".join(allowed)
            + ")"
        )

    turn_args = argparse.Namespace(
        session_id=args.session_id,
        prompt=prompt,
        prompt_stdin=False,
        prompt_json_stdin=False,
        working_directory="",
        author_id=args.author_id,
        message_type="quick",
        timeout=args.timeout,
    )

    turn_result = run_turn(turn_args)
    payload = {
        "command": command,
        "result": turn_result,
    }

    if command == "REPORT":
        session = turn_result.get("session") or {}
        assistant = str(turn_result.get("assistant") or "")
        source_message_id = str(
            turn_result.get("assistantMessageId") or ""
        )

        checkpoint_args = [
            "checkpoint-append",
            "--room-id", str(session.get("roomId") or ""),
            "--session-id", args.session_id,
            "--checkpoint-kind", "REQUESTED_REPORT",
        ]
        if source_message_id:
            checkpoint_args.extend([
                "--source-message-id",
                source_message_id,
            ])
        checkpoint_args.append("--body-stdin")

        checkpoint = px_hospital(
            *checkpoint_args,
            stdin_text=assistant,
        )
        payload["checkpoint"] = checkpoint

        store_event(
            args.session_id,
            "checkpoint.created",
            {
                "checkpointId": checkpoint.get("id"),
                "kind": checkpoint.get("kind"),
                "sourceMessageId": checkpoint.get(
                    "sourceMessageId"
                ),
            },
        )

        git_evidence = collect_git_report_evidence(
            str(session.get("workingDirectory") or "")
        )
        report_args = [
            "room-report-append",
            "--room-id", str(session.get("roomId") or ""),
            "--session-id", args.session_id,
            "--checkpoint-id", str(checkpoint.get("id") or ""),
            "--report-kind", "DOCTOR_NOTE",
            "--title",
            "ROOM "
            + str(session.get("roomId") or "")
            + " // DOCTOR REPORT",
            "--bed-path", str(session.get("workingDirectory") or ""),
            "--branch", str(git_evidence["branch"]),
            "--head-sha", str(git_evidence["headSha"]),
            "--git-evidence-status", str(git_evidence["status"]),
            "--changed-files-json",
            json.dumps(git_evidence["changedFiles"], sort_keys=True),
            "--insertions", str(git_evidence["insertions"]),
            "--deletions", str(git_evidence["deletions"]),
        ]
        if source_message_id:
            report_args.extend([
                "--source-message-id",
                source_message_id,
            ])
        if git_evidence["dirty"]:
            report_args.append("--dirty")
        report_args.append("--body-stdin")

        room_report = px_hospital(
            *report_args,
            stdin_text=assistant,
        )
        payload["roomReport"] = room_report
        payload["gitEvidence"] = git_evidence

        store_event(
            args.session_id,
            "room_report.created",
            {
                "reportId": room_report.get("id"),
                "checkpointId": checkpoint.get("id"),
                "sourceMessageId": room_report.get(
                    "sourceMessageId"
                ),
                "gitEvidenceStatus": room_report.get(
                    "gitEvidenceStatus"
                ),
            },
        )

    if command == "SUGGEST":
        proposal = parse_memory_suggestion(
            str(turn_result.get("assistant") or "")
        )
        payload["memorySuggestion"] = None

        if proposal:
            session = turn_result.get("session") or {}
            room_id = str(session.get("roomId") or "")
            room = px_hospital("room", room_id)
            patient_id = str(room.get("patientId") or "")
            source_message_id = str(
                turn_result.get("assistantMessageId") or ""
            )

            suggestion_args = [
                "chart-suggestion-add",
                "--scope", str(proposal["scope"]),
                "--entry-kind", str(proposal["kind"]),
                "--title", str(proposal["title"]),
                "--priority", str(proposal["priority"]),
                "--doctor-id", str(session.get("doctorId") or ""),
                "--provider-id", str(session.get("providerId") or ""),
                "--source-room-id", room_id,
                "--source-session-id", args.session_id,
            ]

            if proposal["scope"] == "PATIENT":
                if not patient_id:
                    raise RuntimeError(
                        "Doctor proposed Patient memory but Room has no Patient"
                    )
                suggestion_args.extend([
                    "--patient-id",
                    patient_id,
                ])
            else:
                suggestion_args.extend([
                    "--room-id",
                    room_id,
                ])

            if source_message_id:
                suggestion_args.extend([
                    "--source-message-id",
                    source_message_id,
                ])

            suggestion_args.append("--body-stdin")
            suggestion = px_hospital(
                *suggestion_args,
                stdin_text=str(proposal["body"]),
            )
            payload["memorySuggestion"] = suggestion

            store_event(
                args.session_id,
                "chart_suggestion.created",
                {
                    "suggestionId": suggestion.get("id"),
                    "scope": suggestion.get("scope"),
                    "kind": suggestion.get("kind"),
                    "priority": suggestion.get("priority"),
                    "sourceMessageId": suggestion.get(
                        "sourceMessageId"
                    ),
                },
            )
        else:
            store_event(
                args.session_id,
                "chart_suggestion.none",
                {"command": "SUGGEST"},
            )

    return payload


def run_report_feedback(args) -> dict:
    session = px_hospital("session", args.session_id)

    if str(session.get("status") or "").upper() == "OPERATING":
        raise RuntimeError(
            "Hospital Doctor is already operating in this persistent session"
        )

    report = px_hospital("room-report", str(args.report_id))

    session_room = str(session.get("roomId") or "")
    report_room = str(report.get("roomId") or "")
    report_session = str(report.get("sessionId") or "")

    if report_room != session_room:
        raise RuntimeError(
            f"Hospital Room Report {args.report_id} belongs to "
            f"{report_room}, not {session_room}"
        )

    if report_session and report_session != args.session_id:
        raise RuntimeError(
            f"Hospital Room Report {args.report_id} belongs to "
            f"persistent session {report_session}, not {args.session_id}"
        )

    if args.feedback_stdin:
        feedback = sys.stdin.read()
    else:
        feedback = args.feedback or ""

    feedback = feedback.strip()
    if not feedback:
        raise RuntimeError("Room Report feedback is empty")

    changed_files = report.get("changedFiles")
    if not isinstance(changed_files, list):
        changed_files = []

    report_context = (
        "REPORT FEEDBACK // ROOM REPORT "
        + str(report.get("id") or args.report_id)
        + "\n"
        + "The operator is responding to a prior Doctor Note from this "
        + "persistent Room session. Treat its saved Git evidence as historical "
        + "provenance, not as current truth. Reacquire live Git state before "
        + "making new Git claims or edits.\n\n"
        + "REPORT TITLE: "
        + str(report.get("title") or "DOCTOR NOTE")
        + "\n"
        + "REPORT CREATED: "
        + str(report.get("createdAt") or "")
        + "\n"
        + "REPORT BRANCH: "
        + str(report.get("branch") or "")
        + "\n"
        + "REPORT HEAD: "
        + str(report.get("headSha") or "")
        + "\n"
        + "REPORT GIT EVIDENCE: "
        + str(report.get("gitEvidenceStatus") or "UNAVAILABLE")
        + "\n"
        + "REPORT CHANGED FILES: "
        + ", ".join(str(value) for value in changed_files)
        + "\n\n"
        + "ORIGINAL DOCTOR NOTE\n"
        + str(report.get("body") or "")
        + "\n\n"
        + "Address the operator turn below within the current Room assignment. "
        + "If a correction is safe and within scope, make it and explain "
        + "what changed. Otherwise surface the blocker or decision needed."
    )

    store_event(
        args.session_id,
        "room_report.feedback.started",
        {
            "reportId": str(report.get("id") or args.report_id),
            "sourceMessageId": str(report.get("sourceMessageId") or ""),
        },
    )

    turn_args = argparse.Namespace(
        session_id=args.session_id,
        prompt=feedback,
        prompt_stdin=False,
        prompt_json_stdin=False,
        working_directory="",
        author_id=args.author_id,
        message_type="report_feedback",
        timeout=args.timeout,
        supplemental_context=report_context,
    )
    result = run_turn(turn_args)

    store_event(
        args.session_id,
        "room_report.feedback.completed",
        {
            "reportId": str(report.get("id") or args.report_id),
            "assistantMessageId": str(
                result.get("assistantMessageId") or ""
            ),
        },
    )

    return {
        "report": report,
        "feedback": feedback,
        "result": result,
    }


def build_parser():
    parser = argparse.ArgumentParser(
        prog="px agent",
        description="Post-Apollo normalized AI provider runtime",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    providers = sub.add_parser("providers")
    providers.add_argument("--json", action="store_true")

    create = sub.add_parser("session-create")
    create.add_argument("--room-id", required=True)
    create.add_argument("--doctor-id", required=True)
    create.add_argument("--provider-id", required=True)
    create.add_argument("--working-directory", required=True)
    create.add_argument("--session-id", default="")
    create.add_argument("--json", action="store_true")

    turn = sub.add_parser("turn")
    turn.add_argument("session_id")
    prompt = turn.add_mutually_exclusive_group(required=True)
    prompt.add_argument("--prompt")
    prompt.add_argument("--prompt-stdin", action="store_true")
    prompt.add_argument("--prompt-json-stdin", action="store_true")
    turn.add_argument("--working-directory", default="")
    turn.add_argument("--author-id", default="operator")
    turn.add_argument("--message-type", default="chat")
    turn.add_argument("--timeout", type=int, default=1800)
    turn.add_argument("--json", action="store_true")

    context = sub.add_parser("context")
    context.add_argument("session_id")
    context.add_argument("--json", action="store_true")

    status = sub.add_parser("status")
    status.add_argument("session_id")
    status.add_argument("--json", action="store_true")

    cancel = sub.add_parser("cancel")
    cancel.add_argument("session_id")
    cancel.add_argument("--reason", default="OPERATOR")
    cancel.add_argument("--json", action="store_true")

    quick = sub.add_parser("quick")
    quick.add_argument("session_id")
    quick.add_argument("quick_command")
    quick.add_argument("--author-id", default="operator")
    quick.add_argument("--timeout", type=int, default=1800)
    quick.add_argument("--json", action="store_true")

    report_feedback = sub.add_parser("report-feedback")
    report_feedback.add_argument("session_id")
    report_feedback.add_argument("report_id", type=int)
    report_feedback_input = report_feedback.add_mutually_exclusive_group(
        required=True
    )
    report_feedback_input.add_argument("--feedback")
    report_feedback_input.add_argument(
        "--feedback-stdin",
        action="store_true",
    )
    report_feedback.add_argument("--author-id", default="operator")
    report_feedback.add_argument("--timeout", type=int, default=1800)
    report_feedback.add_argument("--json", action="store_true")

    return parser


def emit(payload, as_json: bool):
    if as_json:
        print(json.dumps(payload, sort_keys=True))
    else:
        print(json.dumps(payload, indent=2, sort_keys=True))


def main() -> int:
    args = build_parser().parse_args()
    try:
        if args.command == "providers":
            emit(providers_payload(), args.json)
        elif args.command == "session-create":
            emit(create_session(args), args.json)
        elif args.command == "turn":
            emit(run_turn(args), args.json)
        elif args.command == "context":
            payload = live_context_payload(args.session_id)
            payload["renderedText"] = render_live_context(payload)
            emit(payload, args.json)
        elif args.command == "status":
            emit(status_payload(args.session_id), args.json)
        elif args.command == "cancel":
            emit(cancel_session(args), args.json)
        elif args.command == "quick":
            emit(run_quick(args), args.json)
        elif args.command == "report-feedback":
            emit(run_report_feedback(args), args.json)
        else:
            raise RuntimeError(f"unsupported agent command: {args.command}")
    except (OSError, RuntimeError) as exc:
        print(f"px agent: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
