<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <!-- Source-only review candidate, NOT installed or enabled. These
       permissions are strictly distinct from Room Trash and Restore.
       Requires native issuer owner review, effective rule/agent audit,
       separately installed keys and source-protected writer. -->
  <action id="org.postapollo.hospital.session-attach">
    <description>Approve attaching a Hospital Session to its reviewed Room and Assignment</description>
    <message>Authenticate to attach the exact reviewed Hospital Session</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
  <action id="org.postapollo.hospital.doctor-succeed">
    <description>Approve a specific Hospital Doctor succession and preserve previous records</description>
    <message>Authenticate to replace the reviewed Hospital Doctor and preserve handoff</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
