# SOURCE TEMPLATE ONLY. Must be installed by a verified root-owned package.
# The C5 signer requires all socket path ancestors root-owned and unwritable.
d /run/post-apollo 0755 root root -
d /run/post-apollo/hospital 0755 root root -
